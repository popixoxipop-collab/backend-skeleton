 "schema_gaps": [
  {
   "id": "route-fields",
   "kind": "stricter",
   "text": "a route needs a method of the seven, an absolute path, a handler that is null or a non-empty string, a source that is an object or null and a string provenance, none of which `projection` checks (`makeRoute` checks all of them except `source`)"
  },
  {
   "id": "blocked-without-routes",
   "kind": "stricter",
   "text": "a `blocked` output has no routes, which `projection` does not enforce"
  },
  {
   "id": "unknown-code",
   "kind": "stricter",
   "text": "every unknown is an object with a non-empty string `code`, which `projection` does not check"
  },
  {
   "id": "support-keys",
   "kind": "stricter",
   "text": "no key named `supported`, `support`, `capability` or `capabilities` at any depth, while `projection` passes the contents of `unknowns`, `observations` and `evidence` on unchecked"
  },
  {
   "id": "plain-contents",
   "kind": "stricter",
   "text": "`sourceContracts` holds non-empty strings and each observation and `evidence` is a plain object, while `projection` copies whatever it is given"
  },
  {
   "id": "order-and-ties",
   "kind": "looser",
   "text": "does not check the sort order and does not tie `profileId` and `status` to a profile"
  },
  {
   "id": "open-contents",
   "kind": "looser",
   "text": "accepts a route unknown that has only a `code` while `routeOrUnknown` always emits the unknown keys"
  }
 ],
