          "messages": [
            "admin ping bidirectional - -",
            "orders-stream event server-to-client #/$defs/Event order_id",
            "orders-stream subscribe client-to-server #/$defs/Subscribe order_id"
          ]
        }
      },
      "manifest_schema_valid": true
