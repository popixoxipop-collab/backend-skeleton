          "status": "partial",
          "dialect": "bskel-websocket-manifest/1",
          "adapter": "websocket-manifest",
          "warnings": [],
          "connections": [
            "admin wss://example.test/admin []",
            "orders-stream wss://example.test/orders [v1.orders,v2.orders]"
