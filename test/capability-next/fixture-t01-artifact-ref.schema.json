{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbf:artifact-ref:1",
  "title": "bskel exact-byte artifact reference",
  "description": "A family-neutral exact-byte reference. This does not replace sbf.contract-ref/1 contract_hash and does not assert semantic equivalence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_ref", "family", "version", "media_type", "byte_sha256", "size_bytes"],
  "properties": {
    "artifact_ref": { "const": "sbf.artifact-ref/1" },
    "family": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "version": { "type": "string", "minLength": 1 },
    "media_type": { "type": "string", "pattern": "^[^\\s/]+/[^\\s]+$" },
    "byte_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "size_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
