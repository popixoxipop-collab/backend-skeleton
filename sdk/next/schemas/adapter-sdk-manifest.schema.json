{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbf:adapter-sdk-manifest:1",
  "title": "bskel external adapter SDK manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "adapter",
    "compatibility",
    "entrypoint",
    "permissions",
    "fixtures",
    "verificationBasis",
    "activation"
  ],
  "properties": {
    "contract": {
      "const": "sbf.adapter-sdk-manifest/1"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "version",
        "descriptorContract"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "maxLength": 128
        },
        "descriptorContract": {
          "const": "sbf.adapter/2"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bskel"
      ],
      "properties": {
        "bskel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minInclusive",
            "maxExclusive"
          ],
          "properties": {
            "minInclusive": {
              "type": "string",
              "minLength": 5,
              "maxLength": 128
            },
            "maxExclusive": {
              "type": "string",
              "minLength": 5,
              "maxLength": 128
            }
          }
        }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "path",
        "export"
      ],
      "properties": {
        "protocol": {
          "const": "sbf.adapter-worker/1"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "export": {
          "const": "adapterWorker"
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readRoots",
        "writeRoots",
        "network",
        "environment",
        "subprocess"
      ],
      "properties": {
        "readRoots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/permissionRoot"
          },
          "maxItems": 256
        },
        "writeRoots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/permissionRoot"
          },
          "maxItems": 256
        },
        "network": {
          "const": "deny-by-default"
        },
        "environment": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Z_][A-Z0-9_]*$",
            "not": {
              "enum": [
                "BASH_ENV",
                "CLASSPATH",
                "DYLD_INSERT_LIBRARIES",
                "DYLD_LIBRARY_PATH",
                "ENV",
                "GEM_HOME",
                "GEM_PATH",
                "JDK_JAVA_OPTIONS",
                "JAVA_TOOL_OPTIONS",
                "LD_LIBRARY_PATH",
                "LD_PRELOAD",
                "NODE_OPTIONS",
                "NODE_PATH",
                "PERL5LIB",
                "PERL5OPT",
                "PYTHONPATH",
                "PYTHONSTARTUP",
                "RUBYLIB",
                "RUBYOPT",
                "_JAVA_OPTIONS"
              ]
            }
          },
          "maxItems": 128,
          "uniqueItems": true
        },
        "subprocess": {
          "const": "deny-by-default"
        }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/relativePath"
      },
      "maxItems": 256,
      "uniqueItems": true
    },
    "verificationBasis": {
      "enum": [
        "official-reference",
        "production-repo",
        "community-sample",
        "synthetic-only",
        "not-applicable"
      ]
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "const": "manual-approval-required"
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "^/"
          }
        },
        {
          "not": {
            "pattern": "^[A-Za-z]:"
          }
        },
        {
          "not": {
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
          }
        },
        {
          "not": {
            "pattern": "\\\\"
          }
        },
        {
          "not": {
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        },
        {
          "not": {
            "pattern": "//"
          }
        }
      ],
      "maxLength": 4096
    },
    "permissionRoot": {
      "anyOf": [
        {
          "const": "."
        },
        {
          "$ref": "#/$defs/relativePath"
        }
      ]
    }
  }
}
