{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbf:adapter-sdk-manifest:1",
  "title": "bskel external adapter SDK manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "adapter",
    "compatibility",
    "entrypoint",
    "permissions",
    "fixtures",
    "verificationBasis",
    "activation"
  ],
  "properties": {
    "contract": {
      "const": "sbf.adapter-sdk-manifest/1"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "version",
        "descriptorContract"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "descriptorContract": {
          "const": "sbf.adapter/2"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bskel"
      ],
      "properties": {
        "bskel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minInclusive",
            "maxExclusive"
          ],
          "properties": {
            "minInclusive": {
              "type": "string",
              "minLength": 5
            },
            "maxExclusive": {
              "type": "string",
              "minLength": 5
            }
          }
        }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "path",
        "export"
      ],
      "properties": {
        "protocol": {
          "const": "sbf.adapter-worker/1"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "export": {
          "const": "adapterWorker"
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readRoots",
        "writeRoots",
        "network",
        "environment",
        "subprocess"
      ],
      "properties": {
        "readRoots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "writeRoots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "network": {
          "const": "deny-by-default"
        },
        "environment": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "subprocess": {
          "const": "deny-by-default"
        }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verificationBasis": {
      "enum": [
        "official-reference",
        "production-repo",
        "community-sample",
        "synthetic-only",
        "not-applicable"
      ]
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "const": "manual-approval-required"
        }
      }
    }
  }
}
