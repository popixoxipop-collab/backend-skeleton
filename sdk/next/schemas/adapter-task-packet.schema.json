{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbf:adapter-task-packet:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "taskId",
    "targetId",
    "baseSha",
    "writeScope",
    "fixtures",
    "mandatoryTests",
    "constraints"
  ],
  "properties": {
    "contract": {
      "const": "sbf.adapter-task-packet/1"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "targetId": {
      "type": "string",
      "minLength": 1
    },
    "baseSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "writeScope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mandatoryTests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
