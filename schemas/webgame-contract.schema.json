{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbf:webgame-contract:1",
  "title": "backend-skeleton webgame contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sbf_webgame_contract",
    "feature_id",
    "feature_uid",
    "source",
    "planes",
    "warnings",
    "completeness"
  ],
  "properties": {
    "sbf_webgame_contract": {
      "const": "1"
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[0-9]{3}-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "feature_uid": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "engines",
        "engine_packages",
        "project_roots",
        "source_hash",
        "files"
      ],
      "properties": {
        "adapter": {
          "const": "typescript-webgame"
        },
        "engines": {
          "type": "array",
          "items": {
            "enum": [
              "three",
              "@react-three/fiber"
            ]
          },
          "uniqueItems": true
        },
        "project_roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "engine_packages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "package",
              "version",
              "project_root"
            ],
            "properties": {
              "package": {
                "enum": [
                  "three",
                  "@react-three/fiber"
                ]
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "project_root": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "planes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene",
        "entity",
        "input",
        "simulation",
        "render",
        "network",
        "asset",
        "behavior"
      ],
      "properties": {
        "scene": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scenes",
            "hierarchy"
          ],
          "properties": {
            "scenes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/planeItem"
              }
            },
            "hierarchy": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/planeItem"
              }
            }
          }
        },
        "entity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entities"
          ],
          "properties": {
            "entities": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/planeItem"
              }
            }
          }
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "listeners",
            "keys"
          ],
          "properties": {
            "listeners": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/planeItem"
              }
            },
            "keys": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/planeItem"
              }
            }
          }
        },
        "simulation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "systems",
            "loops",
            "physics"
          ],
          "properties": {
            "systems": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/planeItem"
              }
            },
            "loops": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/planeItem"
              }
            },
            "physics": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "package",
                  "version",
                  "project_root"
                ],
                "properties": {
                  "package": {
                    "type": "string"
                  },
                  "project_root": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "render": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "renderers"
          ],
          "properties": {
            "renderers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/planeItem"
              }
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sockets"
          ],
          "properties": {
            "sockets": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/planeItem"
              }
            }
          }
        },
        "asset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assets"
          ],
          "properties": {
            "assets": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/planeItem"
              }
            }
          }
        },
        "behavior": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "triggers",
            "systems"
          ],
          "properties": {
            "triggers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/planeItem"
              }
            },
            "systems": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/planeItem"
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^WEBGAME_[A-Z_]+$"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "scene_count",
        "entity_count",
        "loop_count"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "scene_count": {
          "type": "integer",
          "minimum": 0
        },
        "entity_count": {
          "type": "integer",
          "minimum": 0
        },
        "loop_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "planeItem": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z-]+:[a-f0-9]{20}$"
        }
      }
    }
  }
}
