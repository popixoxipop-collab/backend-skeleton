{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbf:plane-adapter:1",
  "title": "BSKEL multi-domain static plane result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "domain_id", "project_id", "kind", "status", "capabilities", "evidence", "unresolved", "notes"],
  "properties": {
    "schema": { "const": "sbf.plane-adapter/1" },
    "domain_id": { "type": "string" },
    "project_id": { "type": "string" },
    "kind": { "enum": ["game-runtime", "api", "asset", "worker", "network"] },
    "status": { "enum": ["complete", "partial"] },
    "capabilities": { "type": "object" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "unresolved": { "type": "array" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["project_id", "kind", "value", "role", "provenance"],
        "properties": {
          "project_id": { "type": "string" },
          "kind": { "type": "string" },
          "value": {},
          "role": { "enum": ["active", "reference", "generated", "vendor", "template"] },
          "details": {},
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_path", "line", "column", "collector", "confidence"],
            "properties": {
              "source_path": { "type": ["string", "null"] },
              "line": { "type": ["integer", "null"], "minimum": 1 },
              "column": { "type": ["integer", "null"], "minimum": 1 },
              "collector": { "type": "string" },
              "confidence": { "enum": ["direct", "derived", "unresolved"] }
            }
          }
        }
      }
    }
  }
}
