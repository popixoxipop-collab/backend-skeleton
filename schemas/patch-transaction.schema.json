{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbf:patch-transaction:1",
  "title": "backend-skeleton content-addressed patch transaction (specs/<feature_id>/patch-transactions/<transaction_id>.json)",
  "description": "D-patch-transactions: generalizes A3/D-patch-strategy's per-{resource,field} patch-approvals.json shape into a kind-agnostic propose/approve/apply/rollback transaction. One file per transaction (not one growing array) -- each record carries a lifecycle with real state transitions and references a content-addressed rollback blob under this same feature's patch-transactions/blobs/ directory. D-ddl-apply added a second kind ('ddl-apply') -- kind-specific source/target/postcondition/apply shapes are enforced by the allOf/if-then branches below, keyed on `kind`. The config-apply branch is byte-identical to this schema's pre-D-ddl-apply shape (existing config-apply records validate unchanged).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "transaction_id", "feature_id", "kind", "source", "target", "preimage", "proposed_value", "postcondition", "status", "created_at"],
  "properties": {
    "schema": { "const": "sbf.patch-transaction/1" },
    "transaction_id": { "type": "string", "pattern": "^pt-[0-9a-f-]{36}$" },
    "feature_id": { "type": "string", "pattern": "^[0-9]{3}-[a-z0-9]+(-[a-z0-9]+)*$" },
    "kind": { "enum": ["config-apply", "ddl-apply", "java-source-splice"] },
    "source": {
      "type": "object",
      "description": "Kind-specific opaque context needed to re-plan this transaction fresh at approve/apply time. Shape enforced per-kind by the allOf/if-then branches below."
    },
    "target": {
      "type": "object",
      "description": "Kind-specific description of what this transaction acts on. Shape enforced per-kind by the allOf/if-then branches below."
    },
    "preimage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_hash", "file_hash"],
      "properties": {
        "region_hash": { "type": "string" },
        "file_hash": { "type": "string" }
      }
    },
    "current_value": { "type": "string" },
    "proposed_value": { "type": "string" },
    "postcondition": {
      "type": "object",
      "description": "Kind-specific re-check applied before the record is allowed to transition to 'applied'. Shape enforced per-kind by the allOf/if-then branches below."
    },
    "status": { "enum": ["proposed", "approved", "applied", "rolled_back"] },
    "created_at": { "type": "string", "format": "date-time" },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "at"],
      "properties": {
        "reason": { "type": "string" },
        "at": { "type": "string", "format": "date-time" }
      }
    },
    "apply": {
      "type": "object",
      "description": "Kind-specific record of what actually happened at apply time. Shape enforced per-kind by the allOf/if-then branches below."
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "at"],
      "properties": {
        "reason": { "type": "string" },
        "at": { "type": "string", "format": "date-time" },
        "forced": { "type": "boolean" },
        "compile_after_rollback": {
          "enum": ["ok", "failed"],
          "description": "D-java-source-splice: java-source-splice only. Deliberately added HERE, to the base `rollback` object, not inside a per-kind allOf/if-then branch -- `rollback` is additionalProperties:false, and a branch's `then` schema is a SEPARATE schema applied to the same instance, so it cannot widen a sibling schema's own closed property list (confirmed live: a branch-added property is still rejected by the base schema's additionalProperties:false). Optional, not required -- absent on every config-apply/ddl-apply record, and on any java-source-splice record persisted before this field existed."
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "config-apply" } } },
      "then": {
        "properties": {
          "source": {
            "additionalProperties": false,
            "required": ["choice"],
            "properties": {
              "choice": { "type": "string" }
            }
          },
          "target": {
            "additionalProperties": false,
            "required": ["file", "key_path"],
            "properties": {
              "file": { "type": "string" },
              "key_path": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
            }
          },
          "postcondition": {
            "additionalProperties": false,
            "required": ["kind", "pattern"],
            "properties": {
              "kind": { "const": "regex-match" },
              "pattern": { "type": "string" }
            }
          },
          "apply": {
            "additionalProperties": false,
            "required": ["at", "postimage_file_hash"],
            "properties": {
              "at": { "type": "string", "format": "date-time" },
              "postimage_file_hash": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "ddl-apply" } } },
      "then": {
        "properties": {
          "source": {
            "additionalProperties": false,
            "required": ["database_url_env", "schema"],
            "properties": {
              "database_url_env": { "type": "string" },
              "schema": { "type": "string" }
            }
          },
          "target": {
            "additionalProperties": false,
            "required": ["database_url_env", "schema", "sql_text"],
            "properties": {
              "database_url_env": { "type": "string" },
              "schema": { "type": "string" },
              "sql_text": { "type": "string" }
            }
          },
          "postcondition": {
            "additionalProperties": false,
            "required": ["kind", "schema", "expected_tables"],
            "properties": {
              "kind": { "const": "db-schema-diff" },
              "schema": { "type": "string" },
              "expected_tables": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "expect"],
                  "properties": {
                    "name": { "type": "string" },
                    "expect": { "enum": ["present", "absent"] }
                  }
                }
              },
              "expected_indexes": {
                "description": "D-ddl-apply (INDEX/SCHEMA postcondition precision): optional, not required -- absent on any ddl-apply record persisted before this field existed, and empty for a statement batch with no CREATE/DROP INDEX in it.",
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "expect"],
                  "properties": {
                    "name": { "type": "string" },
                    "expect": { "enum": ["present", "absent"] }
                  }
                }
              },
              "expected_schemas": {
                "description": "D-ddl-apply (INDEX/SCHEMA postcondition precision): optional, not required -- same reasoning as expected_indexes, for CREATE/DROP SCHEMA.",
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "expect"],
                  "properties": {
                    "name": { "type": "string" },
                    "expect": { "enum": ["present", "absent"] }
                  }
                }
              }
            }
          },
          "apply": {
            "additionalProperties": false,
            "required": ["at", "postimage_schema_hash", "executed_statements"],
            "properties": {
              "at": { "type": "string", "format": "date-time" },
              "postimage_schema_hash": { "type": "string" },
              "executed_statements": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "java-source-splice" } } },
      "then": {
        "properties": {
          "source": {
            "additionalProperties": false,
            "required": ["request_file"],
            "properties": {
              "request_file": { "type": "string", "description": "The --splice-file path this transaction was originally proposed from -- audit trail only, never re-read at approve/apply time (paramsFromTxn() reconstructs planner params entirely from `target`)." }
            }
          },
          "target": {
            "additionalProperties": false,
            "required": ["file", "source_root", "line_terminator", "edits"],
            "properties": {
              "file": { "type": "string" },
              "source_root": { "type": "string" },
              "line_terminator": { "enum": ["\n", "\r\n"] },
              "edits": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["op", "region_hash", "signature_hash", "located"],
                  "properties": {
                    "op": { "enum": ["replace-method-body", "insert-method-body-prologue", "replace-field-initializer", "add-import"] },
                    "locator": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["type_fqn", "member_kind", "member_name"],
                      "properties": {
                        "type_fqn": { "type": "string" },
                        "member_kind": { "enum": ["method", "field"] },
                        "member_name": { "type": "string" },
                        "erased_param_types": { "type": "array", "items": { "type": "string" } }
                      }
                    },
                    "replacement": { "type": "string" },
                    "statements": { "type": "string" },
                    "imports": { "type": "array", "items": { "type": "string" } },
                    "region_hash": { "type": "string" },
                    "signature_hash": { "type": ["string", "null"] },
                    "located": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["start", "end", "begin_line", "end_line"],
                      "description": "A cache of where this edit's region was found at the time of the last plan -- NEVER authoritative (re-derived fresh from `locator` on every plan; a mismatch with the current file just means something else moved, not an error).",
                      "properties": {
                        "start": { "type": "integer" },
                        "end": { "type": "integer" },
                        "begin_line": { "type": ["integer", "null"] },
                        "end_line": { "type": ["integer", "null"] }
                      }
                    }
                  }
                }
              }
            }
          },
          "postcondition": {
            "additionalProperties": false,
            "required": ["kind", "build_tool", "build_command"],
            "properties": {
              "kind": { "const": "java-compiles" },
              "build_tool": { "type": "string" },
              "build_command": { "type": "string" }
            }
          },
          "apply": {
            "additionalProperties": false,
            "required": ["at", "postimage_file_hash", "build_tool"],
            "properties": {
              "at": { "type": "string", "format": "date-time" },
              "postimage_file_hash": { "type": "string" },
              "build_tool": { "type": "string" }
            }
          }
        }
      }
    }
  ]
}
