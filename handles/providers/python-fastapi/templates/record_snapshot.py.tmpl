def _side_channel_session(caller_session: Session) -> Session:
    """D-handles-pilot-cohort (python-fastapi follow-up to the java-spring transaction-isolation
    finding, D-handle-aspect-transaction-isolation): `handle_service.register`/`record_snapshot`
    each call `session.commit()` -- fine when a human calls them directly on their OWN session
    (handle_service.py's own documented use case), genuinely dangerous when called from THIS
    decorator on the WRAPPED function's session, whose transaction semantics this decorator
    cannot know. Real, concrete risk: a wrapped function that does multiple related writes
    without committing (expecting ITS OWN caller to commit-or-rollback atomically) raises
    mid-transaction -- this decorator's own error-path snapshot recording would call
    `session.commit()` on that SAME session, silently persisting the should-have-rolled-back
    partial write instead of ever reaching a real rollback. A genuinely separate session --
    sharing only the caller's engine/connection pool via `get_bind()`, never its in-flight
    transaction -- makes handle registration/snapshot recording a real side channel, matching
    what `Propagation.REQUIRES_NEW` achieves on the Java side for the identical reason.
    """
    return Session(caller_session.get_bind())


def _redact(obj, pointer: str) -> None:
