"""Generated by backend-skeleton (bskel rules emit). Do not hand-edit -- change the source rule
and regenerate.

D-business-rules (R3/R9): pure, stdlib-only executor for one feature's compiled business rules.
A DUMB executor by design -- every semantic decision (which assertions exist, whether one applies
to a field's type, whether two fields are comparable, whether a transition's states are real) was
already made in JS by rules/compile.mjs at `bskel rules check` time. Mirrors
handles/providers/java-spring/templates/RuleCheck.java.tmpl exactly, field-for-field, so both
runtimes are guaranteed to agree -- see that file's own docstring for the full "one interpreter"
reasoning this project holds throughout.

Redaction invariant, inherited from contract_check.py and equally binding here: `Violation.message`
MUST NEVER interpolate an observed payload value -- only the JSON Pointer, the rule id, and the
rule's own declared bound (safe because it came from the contract or from rules.yaml, i.e. from the
developer, never from a request).
"""
from typing import NamedTuple


class Violation(NamedTuple):
    rule_id: str
    pointer: str
    kind: str
    message: str


def _at(body, pointer: str):
    """Compiled pointers are always a single top-level "/field" segment (rules/compile.mjs
    refuses anything deeper) -- this is a dict lookup, not a JSON Pointer implementation."""
    if not isinstance(body, dict):
        return None
    return body.get(pointer[1:])


_CROSS_SYMBOLS = {"lt": "<", "lte": "<=", "gt": ">", "gte": ">=", "eq": "equal to", "neq": "different from"}


def check(rules: dict, body) -> list:
    """Runs every FIELD and CROSS rule in `rules` (one operation's own entry from a loaded
    *.rules.json) against a request body. TRANSITION rules are deliberately NOT run here -- see
    check_transitions() for why they need an argument this function does not have."""
    violations: list = []
    if not isinstance(body, dict):
        return violations
    for rule in rules.get("field", []):
        violations.extend(_check_field(rule, body))
    for rule in rules.get("cross", []):
        violations.extend(_check_cross(rule, body))
    return violations


def _check_field(rule: dict, body: dict) -> list:
    value = _at(body, rule["pointer"])
    if value is None:
        # An absent optional field is not a violation -- requiredness is the contract's own
        # statement, enforced by contract_check.py, deliberately not duplicated in this vocabulary.
        return []
    assertion = rule["assert"]
    bound = rule.get("value")

    if assertion == "minLength":
        if isinstance(value, str) and len(value) < int(bound):
            return [Violation(rule["id"], rule["pointer"], "minLength", f"shorter than the required minimum length of {int(bound)}")]
        return []
    if assertion == "maxLength":
        if isinstance(value, str) and len(value) > int(bound):
            return [Violation(rule["id"], rule["pointer"], "maxLength", f"longer than the permitted maximum length of {int(bound)}")]
        return []
    if assertion == "minimum":
        return _compare_number(rule, value, bound, lambda a, b: a < b, "is below the permitted minimum of ")
    if assertion == "maximum":
        return _compare_number(rule, value, bound, lambda a, b: a > b, "is above the permitted maximum of ")
    if assertion == "exclusiveMinimum":
        return _compare_number(rule, value, bound, lambda a, b: a <= b, "must be strictly greater than ")
    if assertion == "exclusiveMaximum":
        return _compare_number(rule, value, bound, lambda a, b: a >= b, "must be strictly less than ")
    if assertion == "multipleOf":
        if isinstance(value, (int, float)) and not isinstance(value, bool) and bound:
            remainder = value % bound
            if min(abs(remainder), abs(remainder - bound)) > 1e-9:
                return [Violation(rule["id"], rule["pointer"], "multipleOf", f"is not an exact multiple of {bound}")]
        return []
    if assertion == "enum":
        if value not in (bound or []):
            return [Violation(rule["id"], rule["pointer"], "enum", f"is not one of the {len(bound or [])} permitted values")]
        return []
    # No fallthrough that passes silently: an assertion name this executor does not know can only
    # mean the artifact was produced by a NEWER bskel than the code generated here. Reported, never
    # ignored -- the same posture contract_check.py's own `unsupported` takes.
    return [Violation(rule["id"], rule["pointer"], "unsupported", f'rule assertion "{assertion}" is not understood by this generated checker -- re-run `bskel rules emit` to regenerate it')]


def _compare_number(rule: dict, value, bound, violates, message_prefix: str) -> list:
    if not isinstance(value, (int, float)) or isinstance(value, bool):
        return []
    if violates(value, bound):
        return [Violation(rule["id"], rule["pointer"], rule["assert"], f"{message_prefix}{bound}")]
    return []


def _check_cross(rule: dict, body: dict) -> list:
    pointers = rule["pointers"]
    assertion = rule["assert"]
    first = pointers[0]
    a = _at(body, first)

    if assertion == "requiredIf":
        if a is not None and _at(body, pointers[1]) is None:
            return [Violation(rule["id"], pointers[1], "requiredIf", f"is required because {first} is present")]
        return []
    if assertion == "mutuallyExclusive":
        present = [p for p in pointers if _at(body, p) is not None]
        if len(present) > 1:
            return [Violation(rule["id"], first, "mutuallyExclusive", f"at most one of {', '.join(pointers)} may be present, got {len(present)}")]
        return []

    b = _at(body, pointers[1])
    # Either side absent means there is nothing to compare -- see RuleCheck.java's own comment for
    # why this is deliberately not a violation.
    if a is None or b is None:
        return []

    if isinstance(a, bool) or isinstance(b, bool):
        # rules/compile.mjs proved these two pointers were mutually comparable against the
        # contract's declared types, so reaching here means the real payload disagrees with the
        # contract (a boolean where a number/string was declared).
        return [Violation(rule["id"], first, "incomparable", f"could not be compared with {pointers[1]} -- the payload types differ from the contract's declared types")]
    if isinstance(a, (int, float)) and isinstance(b, (int, float)):
        cmp = (a > b) - (a < b)
    elif isinstance(a, str) and isinstance(b, str):
        cmp = (a > b) - (a < b)
    else:
        return [Violation(rule["id"], first, "incomparable", f"could not be compared with {pointers[1]} -- the payload types differ from the contract's declared types")]

    if assertion not in _CROSS_SYMBOLS:
        return [Violation(rule["id"], first, "unsupported", f'rule assertion "{assertion}" is not understood by this generated checker -- re-run `bskel rules emit` to regenerate it')]

    violated = {
        "lt": cmp >= 0, "lte": cmp > 0, "gt": cmp <= 0, "gte": cmp < 0, "eq": cmp != 0, "neq": cmp == 0,
    }[assertion]
    if violated:
        return [Violation(rule["id"], first, assertion, f"must be {_CROSS_SYMBOLS[assertion]} {pointers[1]}")]
    return []


def check_transitions(rules: dict, body, current_states: dict | None) -> list:
    """Runs TRANSITION rules. Separate from check() because a transition guard is inherently a
    statement about a change, and a request body only carries the DESTINATION state -- the current
    state lives in the application's own datastore, which this function has no access to and must
    never acquire.

    `current_states` maps a rule's pointer (e.g. "/status") to that resource's CURRENT persisted
    value, supplied by the caller. This is the one place a human must wire something -- the same
    honest boundary resolver.py's own patch_field draws.

    Fail-closed: a pointer with no entry in `current_states` produces an "unchecked" violation,
    never a silent pass -- a transition guard that quietly does nothing because nobody supplied the
    current state is exactly the "looks enforced, never fires" failure this whole item refuses
    elsewhere (see RULE_TRANSITION_NOT_ENUM in rules/diagnostics.mjs).
    """
    violations: list = []
    if not isinstance(body, dict):
        return violations
    for rule in rules.get("transition", []):
        target = _at(body, rule["pointer"])
        if target is None or not isinstance(target, str):
            continue  # not changing this field
        if current_states is None or rule["pointer"] not in current_states:
            violations.append(Violation(rule["id"], rule["pointer"], "unchecked", "a transition guard is declared but the current state was not supplied, so it could not be evaluated -- pass it via check_transitions(..., current_states)"))
            continue
        from_state = current_states[rule["pointer"]]
        to_state = target
        if from_state is None or from_state == to_state:
            continue  # no transition is occurring
        if from_state in rule["from"] and to_state in rule["to"]:
            continue  # explicitly allowed
        violations.append(Violation(rule["id"], rule["pointer"], "transition", f"this state change is not permitted -- allowed transitions are from {{{', '.join(rule['from'])}}} to {{{', '.join(rule['to'])}}}"))
    return violations
