"""Generated by backend-skeleton (bskel observe emit). Do not hand-edit -- change the source
template and regenerate.

D-runtime-conformance-receipts (cryptographic receipt attestation): signs a receipt at emission
time so `bskel observe import --pubkey <path>` can prove it genuinely came from this running app,
not a hand-fabricated file. Uses the `cryptography` package's Ed25519 primitives -- Python's
stdlib has no Ed25519 signing at all, so this is a genuinely new, first-of-its-kind third-party
dependency for this provider's generated runtime code (same honest framing this project already
gave `pg`, its own first-ever database dependency -- see DECISIONS.md
D-runtime-conformance-receipts). The import is deliberately LAZY (inside configure(), not at
module level) so this module -- and observe_contract.py, which imports it unconditionally --
stays importable even when `cryptography` is not installed, as long as signing is never
configured. Only pip-install `cryptography` if you actually call configure() with a real key.

Canonicalization must be byte-identical to `bskel observe import`'s own verification side (Node's
`lib/attest.mjs` canonicalize(): deep-sorted keys, compact JSON, non-ASCII left unescaped) --
`json.dumps(receipt, sort_keys=True, separators=(",", ":"), ensure_ascii=False)` is exactly that,
proven cross-language-compatible by direct execution against a real receipt containing a forward
slash, a quote, and non-ASCII text (see DECISIONS.md D-runtime-conformance-receipts).
`ensure_ascii=False` is load-bearing -- Python's own json.dumps default (True) escapes non-ASCII
as `\\uXXXX`, which neither Node's JSON.stringify nor Jackson's default writer do; without this
flag, signatures would never cross-verify on any receipt whose message contains non-ASCII text.

The private key is never baked into generated source (that would commit a secret to the repo) --
see configure()'s own docstring for how a human wires this in.
"""
import base64
import json

_private_key = None


def configure(private_key_pem):
    """NOT called by any generated code -- a human calls this once, themselves, at application
    startup (e.g. `receipt_sign.configure(os.environ.get("BSKEL_OBSERVE_SIGNING_KEY_PEM"))`),
    passing a PKCS#8 PEM private key string -- the exact format `bskel attest keygen` already
    writes. Never hardcode a real key value in source; read it from wherever you already keep
    secrets (an env var, a mounted file, a secrets manager). Unconfigured (the default, including
    a None/blank string) means every receipt stays unsigned -- backward compatible with every
    already-deployed app using this feature before signing existed.
    """
    global _private_key
    if not private_key_pem or not private_key_pem.strip():
        _private_key = None
        return
    from cryptography.hazmat.primitives import serialization

    _private_key = serialization.load_pem_private_key(private_key_pem.encode("utf-8"), password=None)


def is_configured():
    return _private_key is not None


def canonicalize(receipt_without_signature):
    # The schema this signs has exactly one numeric field (a plain integer HTTP status) and
    # nothing else numeric anywhere -- no float-formatting cross-language risk exists here.
    return json.dumps(
        receipt_without_signature, sort_keys=True, separators=(",", ":"), ensure_ascii=False
    ).encode("utf-8")


def sign(receipt_without_signature):
    """Returns the base64 Ed25519 signature over the canonicalized receipt. Callers must pass a
    dict that does not yet carry a "signature" key -- this module never strips one itself.
    """
    signature_bytes = _private_key.sign(canonicalize(receipt_without_signature))
    return base64.b64encode(signature_bytes).decode("ascii")
