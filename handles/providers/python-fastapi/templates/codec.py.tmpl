import base64
import re
import uuid

NS_SBF_FIELD = uuid.UUID("a3f1c2e0-8b4d-4f1a-9c3e-1d2b3a4c5d6e")

_UUID_PATTERN = r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
