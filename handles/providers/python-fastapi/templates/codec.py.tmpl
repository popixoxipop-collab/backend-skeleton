        raise ValueError('not an sbf1 handle (missing "sbf1_" prefix)')
    if len(token) > MAX_HANDLE_TOKEN_LENGTH:
        raise ValueError(f"handle token exceeds the maximum length of {MAX_HANDLE_TOKEN_LENGTH} characters")
