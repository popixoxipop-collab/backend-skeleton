"""Generated by backend-skeleton (bskel observe emit). Do not hand-edit -- change the source
template and regenerate.

D-runtime-conformance-receipts: loads every `<feature-id>.observed-schema.json` file under this
package's own `schemas/` directory (one per feature `bskel observe emit --module ...` has been run
against) at MODULE IMPORT time and merges them into one flat dict keyed by operationId -- a
deployed app has no access to specs/ at runtime, same reasoning java's own
ResourceResolver#contractRef() javadoc states, just a plain data file here instead of a baked
string constant, because this payload is bigger than one token. Python's own module cache gives
this the same "loaded once, shared everywhere" property Java's @Component gives ObserveSchemaLoader
-- no extra machinery needed.

`schemas/` is a plain data directory (no __init__.py, not a real importable package) discovered via
a simple glob rather than importlib.resources -- this ecosystem's own target apps only ever run
from source (uvicorn app.main:app), never an installed wheel, so the Traversable/context-manager
ceremony importlib.resources exists for has nothing to solve here. A known, bounded forward gap if
that ever changes: an installed-wheel deployment would need package_data/MANIFEST.in wiring, not
done here without a proven need.

Every `pattern` keyword is compiled exactly ONCE here, not per-request -- a `re.error` at this
point marks that one field unsupported rather than failing app startup. An externally-sourced (if
length-capped, see contracts/openapi.mjs's MAX_PATTERN_LENGTH) regex is a real, not fully solved,
ReDoS risk -- this only guards against a malformed pattern, not a pathological-but-valid one. See
DECISIONS.md D-runtime-conformance-receipts for the full reasoning.
"""
import json
import logging
import re
from pathlib import Path

logger = logging.getLogger(__name__)

_SCHEMAS_DIR = Path(__file__).parent / "schemas"


def _compile_property(prop: dict) -> dict:
    pattern_text = prop.get("pattern")
    if pattern_text is None:
        return {"type": prop.get("type"), "pattern": None}
    try:
        return {"type": prop.get("type"), "pattern": re.compile(pattern_text)}
    except re.error:
        return None  # caller treats this as unsupported


def _compile_object(node) -> dict:
    if not node:
        return {"required": [], "properties": {}, "unsupported": []}
    unsupported = list(node.get("unsupported", []))
    properties = {}
    for name, prop in node.get("properties", {}).items():
        compiled = _compile_property(prop)
        if compiled is None:
            unsupported.append(f"/{name}")
            continue
        properties[name] = compiled
    return {"required": list(node.get("required", [])), "properties": properties, "unsupported": unsupported}


def _load_one(path: Path) -> dict:
    try:
        raw = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        logger.warning("observed_schema: could not read/parse %s -- skipping this feature's observed schema", path, exc_info=True)
        return {}
    feature_id = raw.get("feature_id")
    feature_uid = raw.get("feature_uid")
    contract_ref = raw.get("contract_ref")
    operations = {}
    for operation_id, op in raw.get("operations", {}).items():
        body = op.get("body", "unknown")
        operations[operation_id] = {
            "feature_id": feature_id,
            "feature_uid": feature_uid,
            "contract_ref": contract_ref,
            "verb": op.get("verb"),
            "path": op.get("path"),
            "path_params": _compile_object(op.get("pathParams")),
            "body": body,
            "request": None if body == "false" else _compile_object(op.get("request")),
            "response": _compile_object(op.get("response")),
            "error": _compile_object(op.get("error")),
            "statuses": op.get("statuses"),
        }
    return operations


def _load_all() -> dict:
    merged: dict = {}
    if not _SCHEMAS_DIR.is_dir():
        return merged
    for path in sorted(_SCHEMAS_DIR.glob("*.observed-schema.json")):
        for operation_id, op in _load_one(path).items():
            if operation_id in merged:
                logger.warning('observed_schema: operationId "%s" is declared by more than one *.observed-schema.json on disk -- the last one loaded wins', operation_id)
            merged[operation_id] = op
    return merged


_OPERATIONS = _load_all()


def get(operation_id: str):
    """None when no loaded *.observed-schema.json declares this operationId."""
    return _OPERATIONS.get(operation_id)
