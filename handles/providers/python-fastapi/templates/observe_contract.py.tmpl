"""Generated by backend-skeleton (bskel observe emit). Do not hand-edit -- change the source
template and regenerate.

D-runtime-conformance-receipts: the opt-in AUTOMATIC half of runtime contract-conformance checking
-- exists only for a function a human has chosen to decorate with `@observe_contract`. Never
activates on anything else, and a failure here is ALWAYS logged and swallowed, never allowed to
fail the real call it wraps (best-effort observability, same posture `record_snapshot.py`'s own
decorator already establishes -- see its own docstring).

Combines Java's separate `@ObserveContract` annotation + `ContractObservationAspect` interceptor
into ONE decorator, deliberately -- same reasoning `record_snapshot.py`'s own docstring already
gives: Python decorators natively ARE this ecosystem's method-interception mechanism, so there is
no separate "declare a marker" vs. "implement the interceptor" split worth preserving.

Only `operation_id` is required. `body_param` is the one deliberately EXPLICIT (never guessed, see
D-resolver-scope in DECISIONS.md), OPTIONAL parameter naming which of the wrapped function's own
arguments is the request body -- Python has no `@RequestBody`-equivalent unambiguous marker the way
Java does, so a human must name it; default `None` means "skip request-body checking". Path
parameter NAMES need no config at all -- they come data-driven from the baked schema's own
`path_params`, looked up by NAME in the wrapped function's own bound arguments (FastAPI's own
routing structurally guarantees a handler's parameter name matches its route's `{name}` template
segment).

CRITICAL, python-specific correctness requirement (see DECISIONS.md
D-runtime-conformance-receipts's own async-wrapper note): detects whether the wrapped function is
a coroutine function (`inspect.iscoroutinefunction`) at DECORATION time and dispatches to a
genuinely separate async wrapper (awaiting the wrapped call) vs. sync wrapper (calling it
directly) -- a single wrapper naively calling an async function without awaiting it would return an
unawaited coroutine object as the "result", corrupting the real HTTP response. This is NOT
optional/deferred the way it was for java-spring's AOP-based interceptor (which proxies an async
return value transparently, unmodified, even without inspecting it) -- FastAPI route handlers are
commonly `async def`, so getting this wrong breaks production traffic, not just the conformance
check.

Example:
    @observe_contract(operation_id="items-read_item")
    async def read_item(session: SessionDep, id: str):
        ...
"""
import functools
import inspect
import json
import logging
from datetime import datetime, timezone

from fastapi import HTTPException
from starlette.exceptions import HTTPException as StarletteHTTPException

from . import contract_check
from . import observed_schema

logger = logging.getLogger(__name__)
_RECEIPTS = logging.getLogger("bskel.observe.receipts")


def _status_of_exception(exc: BaseException):
    if isinstance(exc, (HTTPException, StarletteHTTPException)):
        return exc.status_code
    return None  # unresolved -- the status check is skipped for this receipt, not guessed


def _to_jsonable(value):
    """Best-effort plain-dict/list/scalar projection -- a Pydantic/SQLModel object's own
    `.model_dump(mode="json")`, or the value as-is if it's already JSON-shaped.
    """
    if hasattr(value, "model_dump"):
        return value.model_dump(mode="json")
    return value


def _check_request(op: dict, bound: inspect.BoundArguments, body_param) -> list:
    violations = list(contract_check.check_path_params(op["path_params"], bound.arguments))
    if op["body"] != "false" and body_param is not None:
        body_value = bound.arguments.get(body_param)
        if body_value is not None:
            violations.extend(contract_check.check_object(op["request"], _to_jsonable(body_value), "/body"))
    return violations


def _check_response(op: dict, result) -> list:
    if result is None:
        return []
    return contract_check.check_object(op["response"], _to_jsonable(result), "/body")


def _emit_receipt(op: dict, operation_id: str, request_violations: list, response_violations: list, status, error_class) -> None:
    try:
        all_violations = list(request_violations) + list(response_violations)
        if status is not None and op.get("statuses"):
            if not any(contract_check.status_matches(key, status) for key in op["statuses"]):
                all_violations.append(contract_check.Violation("/status", "status", f"observed status {status} is not among the documented status keys"))
        receipt = {
            "feature_id": op["feature_id"],
            "feature_uid": op["feature_uid"],
            "operation_id": operation_id,
            "contract_ref": op["contract_ref"],
            "verb": op["verb"],
            "recorded_at": datetime.now(timezone.utc).isoformat(),
            "violations": [v._asdict() for v in all_violations],
        }
        if status is not None:
            receipt["status"] = status
        if error_class is not None:
            receipt["error_class"] = error_class
        _RECEIPTS.info(json.dumps(receipt))
    except Exception:
        logger.warning("observe_contract: could not emit a receipt -- the wrapped call already returned unaffected", exc_info=True)


def observe_contract(*, operation_id: str, body_param: str | None = None):
    def decorator(fn):
        signature = inspect.signature(fn)

        def _request_check(bound):
            try:
                op = observed_schema.get(operation_id)
                if op is None:
                    logger.warning('observe_contract: no observed schema loaded for operationId "%s" on %s -- skipping, the wrapped call proceeds unaffected', operation_id, fn.__qualname__)
                    return None, []
                return op, _check_request(op, bound, body_param)
            except Exception:
                logger.warning("observe_contract: could not complete the request check for %s -- the wrapped call proceeds unaffected", fn.__qualname__, exc_info=True)
                return None, []

        def _response_check(op, result):
            try:
                return _check_response(op, result)
            except Exception:
                logger.warning("observe_contract: could not complete the response check for %s -- the wrapped call already returned unaffected", fn.__qualname__, exc_info=True)
                return []

        if inspect.iscoroutinefunction(fn):
            @functools.wraps(fn)
            async def wrapper(*args, **kwargs):
                bound = signature.bind(*args, **kwargs)
                bound.apply_defaults()
                op, request_violations = _request_check(bound)
                if op is None:
                    return await fn(*args, **kwargs)
                try:
                    result = await fn(*args, **kwargs)
                except Exception as exc:
                    _emit_receipt(op, operation_id, request_violations, [], _status_of_exception(exc), type(exc).__name__)
                    raise
                _emit_receipt(op, operation_id, request_violations, _response_check(op, result), 200, None)
                return result
        else:
            @functools.wraps(fn)
            def wrapper(*args, **kwargs):
                bound = signature.bind(*args, **kwargs)
                bound.apply_defaults()
                op, request_violations = _request_check(bound)
                if op is None:
                    return fn(*args, **kwargs)
                try:
                    result = fn(*args, **kwargs)
                except Exception as exc:
                    _emit_receipt(op, operation_id, request_violations, [], _status_of_exception(exc), type(exc).__name__)
                    raise
                _emit_receipt(op, operation_id, request_violations, _response_check(op, result), 200, None)
                return result

        return wrapper

    return decorator
