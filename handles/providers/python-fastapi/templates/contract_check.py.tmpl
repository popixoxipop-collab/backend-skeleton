"""Generated by backend-skeleton (bskel observe emit). Do not hand-edit -- change the source
template and regenerate.

D-runtime-conformance-receipts: pure, stdlib-only -- the only place a real observed value is ever
looked at. `Violation.message` MUST NEVER interpolate the observed value itself, only the JSON
Pointer and constraint kind ("required"/"type"/"pattern"/"unsupported") -- a real payload value
must never leave this process, structurally, not by convention (see DECISIONS.md
D-runtime-conformance-receipts, Decision A). This invariant has its own dedicated coverage in
scripts/python-import-smoke.mjs asserting no violation message, across a battery of bad inputs,
ever contains the input string -- not just this module's own docstring.

Every check here matches exactly what handles/observe-schema-projection.mjs's own projection
produces (shared with java-spring, nothing python-specific about the shape) -- required-field
presence, scalar (string/number/integer/boolean) type, and a pre-compiled regex pattern (compiled
once by observed_schema.py, not here). Nothing deeper: a property this checker cannot evaluate is
marked `unsupported` at its own pointer by the projection already, never guessed at here.
"""
from typing import NamedTuple


class Violation(NamedTuple):
    pointer: str
    keyword: str
    message: str


def _matches_type(type_: str, value) -> bool:
    if type_ == "string":
        return isinstance(value, str)
    if type_ == "boolean":
        return isinstance(value, bool)
    if type_ == "integer":
        return isinstance(value, int) and not isinstance(value, bool)
    if type_ == "number":
        return isinstance(value, (int, float)) and not isinstance(value, bool)
    return True  # an unrecognized type name is not this checker's job to enforce


def _check_scalar(prop: dict, value, pointer: str) -> list:
    violations = []
    type_ = prop.get("type")
    if type_ is not None and not _matches_type(type_, value):
        violations.append(Violation(pointer, "type", f'expected type "{type_}"'))
        return violations
    pattern = prop.get("pattern")
    if pattern is not None and isinstance(value, str) and not pattern.match(value):
        violations.append(Violation(pointer, "pattern", "does not match the required pattern"))
    return violations


def check_object(schema, actual, base_pointer: str = "") -> list:
    """Checks `actual` (a request/response/error JSON body) against `schema`, an already-compiled
    entry from observed_schema.get(...)'s own request/response/error field.
    """
    violations: list = []
    if schema is None:
        return violations
    for pointer in schema.get("unsupported", []):
        violations.append(Violation(f"{base_pointer}{pointer}", "unsupported", "schema at this pointer is deeper than this checker supports for now -- not validated"))
    if actual is None:
        if schema.get("required") or schema.get("properties"):
            violations.append(Violation(base_pointer, "type", "expected an object, got none"))
        return violations
    if not isinstance(actual, dict):
        violations.append(Violation(base_pointer, "type", "expected an object"))
        return violations
    for field in schema.get("required", []):
        if field not in actual:
            violations.append(Violation(f"{base_pointer}/{field}", "required", "missing required field"))
    for field, prop in schema.get("properties", {}).items():
        if field not in actual:
            continue  # required-ness already checked above; an absent optional field is not a violation
        violations.extend(_check_scalar(prop, actual[field], f"{base_pointer}/{field}"))
    return violations


def check_path_params(schema, actual: dict) -> list:
    """`actual` is a name->value dict -- the wrapped function's own bound arguments (FastAPI's own
    routing guarantees a handler's parameter name matches its route's {name} template segment, so
    the relevant path-param names are simply looked up by key here; extra, unrelated keys in
    `actual` -- session, body, etc. -- are harmless and ignored).
    """
    violations: list = []
    if schema is None:
        return violations
    for pointer in schema.get("unsupported", []):
        violations.append(Violation(f"/pathParams{pointer}", "unsupported", "schema at this pointer is deeper than this checker supports for now -- not validated"))
    for field in schema.get("required", []):
        value = actual.get(field)
        if value is None:
            violations.append(Violation(f"/pathParams/{field}", "required", "missing required path parameter"))
            continue
        prop = schema.get("properties", {}).get(field)
        pattern = prop.get("pattern") if prop else None
        if pattern is not None and not pattern.match(str(value)):
            violations.append(Violation(f"/pathParams/{field}", "pattern", "does not match the required pattern"))
    return violations


def status_matches(status_key: str, actual_status: int) -> bool:
    """A8: `status_key` is a literal source-document status key ("200", a range like "4XX", or
    "default") -- contracts/emit.mjs's own `sourceResponses` vocabulary
    (schemas/feature-contract.schema.json's `^(?:[1-5](?:[0-9]{2}|XX)|default)$` pattern). Matching
    a REAL observed status against this key is a bounded, mechanical string comparison, not
    JSON-Schema interpretation -- doing it here does not reintroduce a second schema interpreter.
    """
    if status_key == "default":
        return True
    actual = str(actual_status)
    if len(status_key) != 3 or len(actual) != 3:
        return False
    return all(k == "X" or k == a for k, a in zip(status_key, actual))
