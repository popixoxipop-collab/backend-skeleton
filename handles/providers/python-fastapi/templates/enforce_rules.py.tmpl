"""Generated by backend-skeleton (bskel rules emit). Do not hand-edit -- change the source rule
and regenerate.

D-business-rules (R8/R9): the opt-in AUTOMATIC half of business-rule checking -- exists only for a
function a human has chosen to decorate with `@enforce_rules`. Checks FIELD and CROSS rules only;
see this decorator's own parameter docs for why TRANSITION rules are excluded from this automatic
path. Combines Java's separate `@EnforceRules` annotation + `RuleEnforcementAspect` interceptor
into ONE decorator, deliberately -- same reasoning observe_contract.py's own docstring already
gives: Python decorators natively ARE this ecosystem's method-interception mechanism.

Only `operation_id` is required. `body_param` is the one deliberately EXPLICIT (never guessed, see
D-resolver-scope in DECISIONS.md) parameter naming which of the wrapped function's own arguments is
the request body -- default `None` means "skip checking, nothing to check without a body".

The observe/enforce split is read from the `BSKEL_RULES_MODE` environment variable (default
`"observe"`) on every call, not baked in at decoration time -- switching a deployed app from
observation to enforcement is a config change, never a re-run of `bskel rules emit`. Same posture
java-spring's own `bskel.rules.mode` Spring property takes.

- `observe` (default): every violation is logged (the `bskel.rules.violations` logger), the
  wrapped call always proceeds. The same "measure before you enforce" posture
  `observe_contract`/`ContractObservationAspect` already establish for contract shape checking.
- `enforce`: a violation raises `fastapi.HTTPException(400, ...)` BEFORE the wrapped function is
  called. The message may name a rule id, a JSON Pointer, and a rule's own declared bound; it NEVER
  contains an observed request value -- the same redaction invariant `rule_check.Violation` carries.

Fail-open on an INTERNAL error, fail-closed on a REAL violation: if this decorator itself cannot
compute violations (a malformed body, a loader problem), that is logged and the wrapped call
proceeds unaffected, in BOTH modes.

CRITICAL, python-specific correctness requirement (same as observe_contract.py's own note):
detects whether the wrapped function is a coroutine function at DECORATION time and dispatches to
a genuinely separate async/sync wrapper -- a single wrapper naively calling an async function
without awaiting it would return an unawaited coroutine object as the "result".

Example:
    @enforce_rules(operation_id="updateWidget", body_param="request")
    async def update_widget(widget_id: str, request: UpdateWidgetRequest):
        ...
"""
import functools
import inspect
import logging
import os

from fastapi import HTTPException

from . import rule_check
from . import rule_set

logger = logging.getLogger(__name__)
_VIOLATIONS = logging.getLogger("bskel.rules.violations")


def _mode() -> str:
    return os.environ.get("BSKEL_RULES_MODE", "observe")


def _to_jsonable(value):
    if hasattr(value, "model_dump"):
        return value.model_dump(mode="json")
    return value


def _safely_check(rules: dict, body_value, operation_id: str) -> list:
    try:
        if body_value is None:
            return []
        return rule_check.check(rules, _to_jsonable(body_value))
    except Exception:
        logger.warning('enforce_rules: could not evaluate rules for operation "%s" -- the wrapped call proceeds unaffected', operation_id, exc_info=True)
        return []


def _log_violations(operation_id: str, violations: list, mode: str) -> None:
    try:
        for v in violations:
            _VIOLATIONS.warning("operation=%s rule=%s pointer=%s kind=%s mode=%s -- %s", operation_id, v.rule_id, v.pointer, v.kind, mode, v.message)
    except Exception:
        logger.warning('enforce_rules: could not log violations for operation "%s"', operation_id, exc_info=True)


def _summarize(operation_id: str, violations: list) -> str:
    """Built from rule id / pointer / bound-derived text only -- never an observed value, the same
    redaction invariant every Violation.message already holds."""
    parts = [f"{v.pointer} ({v.rule_id}): {v.message}" for v in violations]
    return f"business rule violation(s) for {operation_id}: " + "; ".join(parts)


def enforce_rules(*, operation_id: str, body_param: str | None = None):
    def decorator(fn):
        signature = inspect.signature(fn)

        def _evaluate(bound: inspect.BoundArguments):
            rules = rule_set.for_operation(operation_id)
            if not rules["field"] and not rules["cross"]:
                return []  # nothing compiled for this operation -- not worth logging on every call
            body_value = bound.arguments.get(body_param) if body_param is not None else None
            return _safely_check(rules, body_value, operation_id)

        if inspect.iscoroutinefunction(fn):
            @functools.wraps(fn)
            async def wrapper(*args, **kwargs):
                bound = signature.bind(*args, **kwargs)
                bound.apply_defaults()
                violations = _evaluate(bound)
                if violations:
                    mode = _mode()
                    _log_violations(operation_id, violations, mode)
                    if mode == "enforce":
                        raise HTTPException(status_code=400, detail=_summarize(operation_id, violations))
                return await fn(*args, **kwargs)
        else:
            @functools.wraps(fn)
            def wrapper(*args, **kwargs):
                bound = signature.bind(*args, **kwargs)
                bound.apply_defaults()
                violations = _evaluate(bound)
                if violations:
                    mode = _mode()
                    _log_violations(operation_id, violations, mode)
                    if mode == "enforce":
                        raise HTTPException(status_code=400, detail=_summarize(operation_id, violations))
                return fn(*args, **kwargs)

        return wrapper

    return decorator
