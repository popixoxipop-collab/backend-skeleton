"""Generated by backend-skeleton (bskel rules emit). Do not hand-edit -- change the source rule
and regenerate.

D-business-rules (R9): loads every `<feature-id>.rules.json` file under this package's own
`rules_schemas/` directory (one per feature `bskel rules emit` has been run against) at MODULE
IMPORT time and merges them into one flat dict keyed by operationId. Mirrors observed_schema.py's
own shape exactly -- same "loaded once via Python's module cache" property, same plain-glob
discovery (this ecosystem only ever runs from source, never an installed wheel -- see that
module's own docstring for the full reasoning).

This module does NO interpretation. It deserializes an artifact whose every semantic decision was
already made and verified in JS by rules/compile.mjs -- see rule_check.py's own docstring for that
boundary.
"""
import json
import logging
from pathlib import Path

logger = logging.getLogger(__name__)

_SCHEMAS_DIR = Path(__file__).parent / "rules_schemas"

_EMPTY_OPERATION = {"field": [], "cross": [], "transition": []}


def _load_one(path: Path) -> dict:
    try:
        raw = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        logger.warning("rule_set: could not read/parse %s -- its rules will not be enforced", path, exc_info=True)
        return {}
    operations = {}
    for operation_id, entry in raw.get("operations", {}).items():
        operations[operation_id] = {
            "field": list(entry.get("field", [])),
            "cross": list(entry.get("cross", [])),
            "transition": list(entry.get("transition", [])),
        }
    return operations


def _load_all() -> dict:
    merged: dict = {}
    if not _SCHEMAS_DIR.is_dir():
        return merged
    for path in sorted(_SCHEMAS_DIR.glob("*.rules.json")):
        for operation_id, ops in _load_one(path).items():
            if operation_id in merged:
                logger.warning('rule_set: operationId "%s" is declared by more than one *.rules.json on disk -- the last one loaded wins', operation_id)
            merged[operation_id] = ops
    return merged


_OPERATIONS = _load_all()


def for_operation(operation_id: str) -> dict:
    """Never None -- an operation with no rules returns the shared empty operation dict."""
    return _OPERATIONS.get(operation_id, _EMPTY_OPERATION)
