	const violations: Violation[] = [];
	if (schema === null) return violations;
	for (const pointer of schema.unsupported) {
		violations.push({ pointer: `/pathParams${pointer}`, keyword: 'unsupported', message: 'schema at this pointer is deeper than this checker supports for now -- not validated' });
	}
