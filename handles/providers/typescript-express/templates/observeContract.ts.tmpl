// D-runtime-conformance-receipts: the opt-in AUTOMATIC half of runtime contract-conformance
// checking -- exists only for a route a human has chosen to insert observeContract('...') into.
// Never activates on anything else, and a failure here is ALWAYS logged and swallowed, never
// allowed to affect the real request/response (best-effort observability, same posture java's
// ContractObservationAspect / python's observe_contract already establish).
//
// Combines java's separate @ObserveContract annotation + ContractObservationAspect interceptor,
// and mirrors python's single-decorator choice: Express middleware IS this ecosystem's own
// interception mechanism, so there is no separate "declare a marker" vs. "implement the
// interceptor" split worth preserving here either.
//
// STRUCTURAL DIFFERENCE FROM JAVA/PYTHON, not a deferred gap: Express middleware runs BEFORE the
// route handler and never receives its return value -- there is no `joinPoint.proceed()`/
// `await fn(...)` to intercept. Response-body capture instead patches `res.json` on the per-request
// `res` instance (confirmed against the real express@4.18.2 source: `res.send(<plainObject>)`
// itself delegates to `this.json(...)`, so this single patch point covers both call styles) and
// reads the FINAL, real `res.statusCode` inside `res.on('finish', ...)` -- which fires exactly
// once regardless of whether the handler succeeded, threw, or Express's own default/custom error
// handling ultimately produced the response. A handler that calls `res.send(<string>)`/
// `res.end(...)` directly, or whose response is produced by Express's own generic error handler,
// never touches the patched `res.json` -- the response check is silently SKIPPED for that request,
// never guessed (same "unsupported, not guessed" discipline as everywhere else in this feature).
//
// error_class is NEVER populated (always omitted) -- by the time a handler throws or calls
// next(err), this middleware's own call frame has already returned; there is no catch-block
// equivalent available the way java's @Around/python's except block have. See DECISIONS.md
// D-runtime-conformance-receipts.
//
// Path-parameter checking needs no config (Express's own req.params is already keyed by the real
// route's own :name segments). Request-body checking is AUTOMATIC whenever op.body !== 'false'
// (req.body is Express's own unambiguous body once body-parsing middleware has run -- no
// python-style explicit body_param argument needed here).
//
// Example:
//   router.get('/users/:id', [checkJwt, observeContract('users-show')], showUser);

import type { RequestHandler, Request, Response } from 'express';
import * as contractCheck from './contractCheck';
import * as observedSchema from './observedSchema';
import type { ObservedOperation } from './observedSchema';
import type { Violation } from './contractCheck';

/**
 * Where a receipt JSON line is delivered -- defaults to stdout (one line per receipt), matching
 * java's/python's own "a dedicated, independently-routable channel a human points `bskel observe
 * import` at" property without inventing a logging framework dependency. Override at app startup
 * (`import { setReceiptSink } from './observe/observeContract'; setReceiptSink((line) => ...);`)
 * to route it wherever you want -- bskel never chooses your delivery path (D-config-patch's own
 * boundary).
 */
let receiptSink: (line: string) => void = (line) => {
	process.stdout.write(`${line}\n`);
};

export function setReceiptSink(sink: (line: string) => void): void {
	receiptSink = sink;
}

function checkRequest(op: ObservedOperation, req: Request): Violation[] {
	const violations = contractCheck.checkPathParams(op.pathParams, req.params as Record<string, unknown>);
	if (op.body !== 'false' && req.body !== undefined) {
		violations.push(...contractCheck.checkObject(op.request, req.body, '/body'));
	}
	return violations;
}

function checkResponse(op: ObservedOperation, body: unknown): Violation[] {
	return contractCheck.checkObject(op.response, body, '/body');
}

function emitReceipt(op: ObservedOperation, operationId: string, requestViolations: Violation[], responseViolations: Violation[], status: number): void {
	try {
		const allViolations = [...requestViolations, ...responseViolations];
		if (op.statuses) {
			const matched = op.statuses.some((key) => contractCheck.statusMatches(key, status));
			if (!matched) {
				allViolations.push({ pointer: '/status', keyword: 'status', message: `observed status ${status} is not among the documented status keys` });
			}
		}
		const receipt: Record<string, unknown> = {
			feature_id: op.featureId,
			feature_uid: op.featureUid,
			operation_id: operationId,
			contract_ref: op.contractRef,
			verb: op.verb,
			status,
			recorded_at: new Date().toISOString(),
			violations: allViolations,
		};
		receiptSink(JSON.stringify(receipt));
	} catch (err) {
		console.warn(`observeContract: could not emit a receipt for "${operationId}"`, err);
	}
}

export function observeContract(operationId: string): RequestHandler {
	return (req: Request, res: Response, next) => {
		let op: ObservedOperation | undefined;
		try {
			op = observedSchema.get(operationId);
		} catch {
			op = undefined;
		}
		if (!op) {
			console.warn(`observeContract: no observed schema loaded for operationId "${operationId}" -- skipping, the request proceeds unaffected`);
			next();
			return;
		}
		const activeOp = op;

		let requestViolations: Violation[] = [];
		try {
			requestViolations = checkRequest(activeOp, req);
		} catch (err) {
			console.warn(`observeContract: could not complete the request check for "${operationId}" -- the request proceeds unaffected`, err);
			requestViolations = [];
		}

		try {
			let capturedBody: unknown;
			let bodyCaptured = false;
			const originalJson = res.json.bind(res);
			res.json = ((body?: any): Response => {
				capturedBody = body;
				bodyCaptured = true;
				return originalJson(body);
			}) as typeof res.json;

			res.on('finish', () => {
				try {
					const responseViolations = bodyCaptured ? checkResponse(activeOp, capturedBody) : [];
					emitReceipt(activeOp, operationId, requestViolations, responseViolations, res.statusCode);
				} catch (err) {
					console.warn(`observeContract: could not emit a receipt for "${operationId}" -- the response was already sent unaffected`, err);
				}
			});
		} catch (err) {
			console.warn(`observeContract: could not attach response observation for "${operationId}" -- the request proceeds unaffected`, err);
		}

		next();
	};
}
