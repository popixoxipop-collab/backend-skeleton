// D-runtime-conformance-receipts: loads every `<feature-id>.observed-schema.json` file under this
// package's own `schemas/` directory (one per feature `bskel observe emit --module ...` has been
// run against) at MODULE LOAD time and merges them into one flat map keyed by operationId -- a
// deployed app has no access to specs/ at runtime, same reasoning java's ResourceResolver /
// python's observed_schema.py already state, just a plain data file here instead of a baked string
// constant. Node's own CommonJS module cache gives this the same "loaded once, shared everywhere"
// property java's @Component / python's module-level `_OPERATIONS` get.
//
// `schemas/` is a plain directory discovered via `fs.readdirSync`, not a bundler-aware asset
// pipeline -- this ecosystem's own target apps only ever run compiled output sitting next to this
// same compiled file (a plain `tsc` deployment), so `__dirname` (CommonJS -- this generated tree's
// own tsconfig.json pins `module: "commonjs"`) is a real, valid runtime anchor; `import.meta.url`
// is deliberately NOT used here -- it is not legal syntax under CommonJS module output and would
// fail `tsc` outright.
//
// Every `pattern` keyword is compiled exactly ONCE here, not per-request -- an invalid regex
// string at this point marks that one field unsupported rather than throwing at module load.

import fs from 'node:fs';
import path from 'node:path';
import type { ObservedObject, ObservedProperty } from './contractCheck';

export interface ObservedOperation {
	featureId: string | null;
	featureUid: string | null;
	contractRef: string | null;
	verb: string | null;
	path: string | null;
	pathParams: ObservedObject;
	body: string;
	request: ObservedObject | null;
	response: ObservedObject;
	error: ObservedObject;
	statuses: string[] | null;
}

const SCHEMAS_DIR = path.join(__dirname, 'schemas');

function compileProperty(prop: any): ObservedProperty | null {
	const patternText = prop?.pattern;
	if (patternText === undefined) return { type: prop?.type ?? null, pattern: null };
	try {
		return { type: prop?.type ?? null, pattern: new RegExp(patternText) };
	} catch {
		return null; // caller treats this as unsupported
	}
}

function compileObject(node: any): ObservedObject {
	if (!node) return { required: [], properties: {}, unsupported: [] };
	const unsupported: string[] = [...(node.unsupported ?? [])];
	const properties: Record<string, ObservedProperty> = {};
	for (const [name, prop] of Object.entries<any>(node.properties ?? {})) {
		const compiled = compileProperty(prop);
		if (compiled === null) {
			unsupported.push(`/${name}`);
			continue;
		}
		properties[name] = compiled;
	}
	return { required: [...(node.required ?? [])], properties, unsupported };
}

function loadOne(filePath: string): Record<string, ObservedOperation> {
	let raw: any;
	try {
		raw = JSON.parse(fs.readFileSync(filePath, 'utf8'));
	} catch (err) {
		console.warn(`observedSchema: could not read/parse ${filePath} -- skipping this feature's observed schema`, err);
		return {};
	}
	const featureId = raw.feature_id ?? null;
	const featureUid = raw.feature_uid ?? null;
	const contractRef = raw.contract_ref ?? null;
	const operations: Record<string, ObservedOperation> = {};
	for (const [operationId, op] of Object.entries<any>(raw.operations ?? {})) {
		const body = op.body ?? 'unknown';
		operations[operationId] = {
			featureId, featureUid, contractRef,
			verb: op.verb ?? null,
			path: op.path ?? null,
			pathParams: compileObject(op.pathParams),
			body,
			request: body === 'false' ? null : compileObject(op.request),
			response: compileObject(op.response),
			error: compileObject(op.error),
			statuses: op.statuses ?? null,
		};
	}
	return operations;
}

function loadAll(): Map<string, ObservedOperation> {
	const merged = new Map<string, ObservedOperation>();
	if (!fs.existsSync(SCHEMAS_DIR)) return merged;
	const files = fs.readdirSync(SCHEMAS_DIR).filter((f) => f.endsWith('.observed-schema.json')).sort();
	for (const file of files) {
		for (const [operationId, op] of Object.entries(loadOne(path.join(SCHEMAS_DIR, file)))) {
			if (merged.has(operationId)) {
				console.warn(`observedSchema: operationId "${operationId}" is declared by more than one *.observed-schema.json on disk -- the last one loaded wins`);
			}
			merged.set(operationId, op);
		}
	}
	return merged;
}

const OPERATIONS = loadAll();

/** undefined when no loaded *.observed-schema.json declares this operationId. */
export function get(operationId: string): ObservedOperation | undefined {
	return OPERATIONS.get(operationId);
}
