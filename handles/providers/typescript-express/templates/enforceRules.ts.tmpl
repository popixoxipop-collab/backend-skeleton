// Generated by backend-skeleton (bskel rules emit). Do not hand-edit -- change the source rule
// and regenerate.
//
// D-business-rules (R8/R9): the opt-in AUTOMATIC half of business-rule checking -- exists only for
// a route a human has chosen to insert enforceRules('...') into. Mirrors observeContract.ts's own
// choice: Express middleware IS this ecosystem's own interception mechanism, so there is no
// separate "declare a marker" vs. "implement the interceptor" split worth preserving here either.
//
// SIMPLER than observeContract.ts's response-capture dance: this middleware only ever checks the
// REQUEST (field/cross rules have no response-shape concept), so there is no res.json patching,
// no res.on('finish', ...) -- a violation in enforce mode is rejected synchronously, before
// `next()` is ever called, the same way any ordinary Express validation middleware works.
//
// Checks FIELD and CROSS rules only. Does NOT check TRANSITION rules -- a transition guard needs
// the resource's CURRENT persisted state, which this middleware's own request-scoped context has
// no generic way to obtain. Call checkTransitions() directly, with the current state your own
// route handler already has, wherever a transition needs checking.
//
// The observe/enforce split is read from the BSKEL_RULES_MODE environment variable (default
// "observe") on every request, not baked in at emit time -- switching a deployed app from
// observation to enforcement is a config change, never a re-run of `bskel rules emit`. Same
// posture java-spring's `bskel.rules.mode` / python-fastapi's own BSKEL_RULES_MODE take.
//
// - observe (default): every violation is logged to stderr, the request always proceeds.
// - enforce: a violation responds 400 BEFORE the route handler runs. The response body may name a
//   rule id, a JSON Pointer, and a rule's own declared bound; it NEVER contains an observed
//   request value -- the same redaction invariant Violation carries.
//
// Fail-open on an INTERNAL error, fail-closed on a REAL violation: if this middleware itself
// cannot compute violations (a malformed body, a loader problem), that is logged and the request
// proceeds unaffected, in BOTH modes.
//
// Example:
//   router.patch('/widgets/:id', [enforceRules('updateWidget')], updateWidget);

import type { RequestHandler, Request, Response, NextFunction } from 'express';
import * as ruleCheck from './ruleCheck';
import * as ruleSet from './ruleSet';
import type { RuleOperation, Violation } from './ruleCheck';

function mode(): string {
	return process.env.BSKEL_RULES_MODE ?? 'observe';
}

function safelyCheck(rules: RuleOperation, body: unknown, operationId: string): Violation[] {
	try {
		if (body === undefined) return [];
		return ruleCheck.check(rules, body);
	} catch (err) {
		console.warn(`enforceRules: could not evaluate rules for operation "${operationId}" -- the request proceeds unaffected`, err);
		return [];
	}
}

function logViolations(operationId: string, violations: Violation[], activeMode: string): void {
	try {
		for (const v of violations) {
			console.warn(`bskel.rules.violations operation=${operationId} rule=${v.ruleId} pointer=${v.pointer} kind=${v.kind} mode=${activeMode} -- ${v.message}`);
		}
	} catch (err) {
		console.warn(`enforceRules: could not log violations for operation "${operationId}"`, err);
	}
}

/** Built from rule id / pointer / bound-derived text only -- never an observed value, the same
 * redaction invariant every Violation.message already holds. */
function summarize(operationId: string, violations: Violation[]): string {
	const parts = violations.map((v) => `${v.pointer} (${v.ruleId}): ${v.message}`);
	return `business rule violation(s) for ${operationId}: ${parts.join('; ')}`;
}

export function enforceRules(operationId: string): RequestHandler {
	return (req: Request, res: Response, next: NextFunction) => {
		const rules = ruleSet.forOperation(operationId);
		if (rules.field.length === 0 && rules.cross.length === 0) {
			// Nothing compiled for this operation -- most commonly a feature with no rules.yaml and
			// a contract that projected nothing enforceable. Proceeds silently.
			next();
			return;
		}

		const violations = safelyCheck(rules, req.body, operationId);
		if (violations.length > 0) {
			const activeMode = mode();
			logViolations(operationId, violations, activeMode);
			if (activeMode === 'enforce') {
				res.status(400).json({ error: summarize(operationId, violations) });
				return; // next() is never called -- the route handler must not run
			}
		}
		next();
	};
}
