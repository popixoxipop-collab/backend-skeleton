// Generated by backend-skeleton (bskel rules emit). Do not hand-edit -- change the source rule
// and regenerate.
//
// D-business-rules (R3/R9): pure, dependency-free executor for one feature's compiled business
// rules. A DUMB executor by design -- every semantic decision (which assertions exist, whether one
// applies to a field's type, whether two fields are comparable, whether a transition's states are
// real) was already made in JS by rules/compile.mjs at `bskel rules check` time. Mirrors
// handles/providers/java-spring/templates/RuleCheck.java.tmpl (and its python-fastapi sibling
// rule_check.py.tmpl) field-for-field, so all three runtimes are guaranteed to agree.
//
// Redaction invariant, inherited from contractCheck.ts and equally binding here: `Violation.message`
// MUST NEVER interpolate an observed payload value -- only the JSON Pointer, the rule id, and the
// rule's own declared bound.

export interface Violation {
	ruleId: string;
	pointer: string;
	kind: string;
	message: string;
}

export interface FieldRule {
	id: string;
	pointer: string;
	assert: string;
	value: unknown;
	origin: string;
}

export interface CrossRule {
	id: string;
	pointers: string[];
	assert: string;
	types: string[];
	origin: string;
}

export interface TransitionRule {
	id: string;
	pointer: string;
	from: string[];
	to: string[];
	origin: string;
}

export interface RuleOperation {
	field: FieldRule[];
	cross: CrossRule[];
	transition: TransitionRule[];
}

/** Compiled pointers are always a single top-level "/field" segment (rules/compile.mjs refuses
 * anything deeper) -- this is a lookup, not a JSON Pointer implementation. */
function at(body: Record<string, unknown>, pointer: string): unknown {
	const value = body[pointer.slice(1)];
	return value === null || value === undefined ? undefined : value;
}

const CROSS_SYMBOLS: Record<string, string> = { lt: '<', lte: '<=', gt: '>', gte: '>=', eq: 'equal to', neq: 'different from' };

/** Runs every FIELD and CROSS rule in `rules` against a request body. TRANSITION rules are
 * deliberately NOT run here -- see checkTransitions() for why they need an argument this function
 * does not have. */
export function check(rules: RuleOperation, body: unknown): Violation[] {
	const violations: Violation[] = [];
	if (typeof body !== 'object' || body === null || Array.isArray(body)) return violations;
	const record = body as Record<string, unknown>;
	for (const rule of rules.field) violations.push(...checkField(rule, record));
	for (const rule of rules.cross) violations.push(...checkCross(rule, record));
	return violations;
}

function checkField(rule: FieldRule, body: Record<string, unknown>): Violation[] {
	const value = at(body, rule.pointer);
	// An absent optional field is not a violation -- requiredness is the contract's own statement,
	// enforced by contractCheck.ts, deliberately not duplicated in this vocabulary.
	if (value === undefined) return [];

	switch (rule.assert) {
		case 'minLength': {
			const bound = rule.value as number;
			if (typeof value === 'string' && value.length < bound) {
				return [{ ruleId: rule.id, pointer: rule.pointer, kind: 'minLength', message: `shorter than the required minimum length of ${bound}` }];
			}
			return [];
		}
		case 'maxLength': {
			const bound = rule.value as number;
			if (typeof value === 'string' && value.length > bound) {
				return [{ ruleId: rule.id, pointer: rule.pointer, kind: 'maxLength', message: `longer than the permitted maximum length of ${bound}` }];
			}
			return [];
		}
		case 'minimum':
			return compareNumber(rule, value, (a, b) => a < b, 'is below the permitted minimum of ');
		case 'maximum':
			return compareNumber(rule, value, (a, b) => a > b, 'is above the permitted maximum of ');
		case 'exclusiveMinimum':
			return compareNumber(rule, value, (a, b) => a <= b, 'must be strictly greater than ');
		case 'exclusiveMaximum':
			return compareNumber(rule, value, (a, b) => a >= b, 'must be strictly less than ');
		case 'multipleOf': {
			const bound = rule.value as number;
			if (typeof value === 'number' && Number.isFinite(value) && bound) {
				const remainder = value % bound;
				if (Math.min(Math.abs(remainder), Math.abs(remainder - bound)) > 1e-9) {
					return [{ ruleId: rule.id, pointer: rule.pointer, kind: 'multipleOf', message: `is not an exact multiple of ${bound}` }];
				}
			}
			return [];
		}
		case 'enum': {
			const allowed = (rule.value as unknown[]) ?? [];
			if (!allowed.includes(value)) {
				return [{ ruleId: rule.id, pointer: rule.pointer, kind: 'enum', message: `is not one of the ${allowed.length} permitted values` }];
			}
			return [];
		}
		default:
			// No default branch that passes silently: an assertion name this executor does not know
			// can only mean the artifact was produced by a NEWER bskel than the code generated here.
			return [{ ruleId: rule.id, pointer: rule.pointer, kind: 'unsupported', message: `rule assertion "${rule.assert}" is not understood by this generated checker -- re-run \`bskel rules emit\` to regenerate it` }];
	}
}

function compareNumber(rule: FieldRule, value: unknown, violates: (a: number, b: number) => boolean, messagePrefix: string): Violation[] {
	if (typeof value !== 'number' || !Number.isFinite(value)) return [];
	const bound = rule.value as number;
	if (violates(value, bound)) {
		return [{ ruleId: rule.id, pointer: rule.pointer, kind: rule.assert, message: `${messagePrefix}${bound}` }];
	}
	return [];
}

function checkCross(rule: CrossRule, body: Record<string, unknown>): Violation[] {
	const [first, second] = rule.pointers;
	const a = at(body, first);

	if (rule.assert === 'requiredIf') {
		if (a !== undefined && at(body, second) === undefined) {
			return [{ ruleId: rule.id, pointer: second, kind: 'requiredIf', message: `is required because ${first} is present` }];
		}
		return [];
	}
	if (rule.assert === 'mutuallyExclusive') {
		const present = rule.pointers.filter((p) => at(body, p) !== undefined);
		if (present.length > 1) {
			return [{ ruleId: rule.id, pointer: first, kind: 'mutuallyExclusive', message: `at most one of ${rule.pointers.join(', ')} may be present, got ${present.length}` }];
		}
		return [];
	}

	const b = at(body, second);
	// Either side absent means there is nothing to compare -- same reasoning as RuleCheck.java.
	if (a === undefined || b === undefined) return [];

	let cmp: number;
	if (typeof a === 'number' && typeof b === 'number') {
		cmp = a === b ? 0 : a > b ? 1 : -1;
	} else if (typeof a === 'string' && typeof b === 'string') {
		cmp = a === b ? 0 : a > b ? 1 : -1;
	} else {
		// rules/compile.mjs proved these two pointers were mutually comparable against the contract's
		// declared types, so reaching here means the real payload disagrees with the contract.
		return [{ ruleId: rule.id, pointer: first, kind: 'incomparable', message: `could not be compared with ${second} -- the payload types differ from the contract's declared types` }];
	}

	if (!(rule.assert in CROSS_SYMBOLS)) {
		return [{ ruleId: rule.id, pointer: first, kind: 'unsupported', message: `rule assertion "${rule.assert}" is not understood by this generated checker -- re-run \`bskel rules emit\` to regenerate it` }];
	}
	const violated = ({ lt: cmp >= 0, lte: cmp > 0, gt: cmp <= 0, gte: cmp < 0, eq: cmp !== 0, neq: cmp === 0 } as Record<string, boolean>)[rule.assert];
	if (violated) {
		return [{ ruleId: rule.id, pointer: first, kind: rule.assert, message: `must be ${CROSS_SYMBOLS[rule.assert]} ${second}` }];
	}
	return [];
}

/**
 * Runs TRANSITION rules. Separate from check() because a transition guard is inherently a
 * statement about a change, and a request body only carries the DESTINATION state -- the current
 * state lives in the application's own datastore, which this function has no access to and must
 * never acquire.
 *
 * `currentStates` maps a rule's pointer (e.g. "/status") to that resource's CURRENT persisted
 * value, supplied by the caller. This is the one place a human must wire something -- the same
 * honest boundary resolver.ts's own patchField draws.
 *
 * Fail-closed: a pointer with no entry in `currentStates` produces an "unchecked" violation, never
 * a silent pass.
 */
export function checkTransitions(rules: RuleOperation, body: unknown, currentStates: Record<string, string> | null): Violation[] {
	const violations: Violation[] = [];
	if (typeof body !== 'object' || body === null || Array.isArray(body)) return violations;
	const record = body as Record<string, unknown>;
	for (const rule of rules.transition) {
		const target = at(record, rule.pointer);
		if (typeof target !== 'string') continue; // not changing this field
		if (currentStates === null || !(rule.pointer in currentStates)) {
			violations.push({ ruleId: rule.id, pointer: rule.pointer, kind: 'unchecked', message: 'a transition guard is declared but the current state was not supplied, so it could not be evaluated -- pass it via checkTransitions(..., currentStates)' });
			continue;
		}
		const fromState = currentStates[rule.pointer];
		const toState = target;
		if (fromState === toState) continue; // no transition is occurring
		if (rule.from.includes(fromState) && rule.to.includes(toState)) continue; // explicitly allowed
		violations.push({ ruleId: rule.id, pointer: rule.pointer, kind: 'transition', message: `this state change is not permitted -- allowed transitions are from {${rule.from.join(', ')}} to {${rule.to.join(', ')}}` });
	}
	return violations;
}
