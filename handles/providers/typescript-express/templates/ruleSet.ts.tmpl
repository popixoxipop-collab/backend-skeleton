//
// D-business-rules (R9): loads every `<feature-id>.rules.json` file under this package's own
// `rulesSchemas/` directory (one per feature `bskel rules emit` has been run against) at MODULE
// LOAD time and merges them into one flat map keyed by operationId. Mirrors observedSchema.ts's
// own shape exactly -- same `fs.readdirSync` discovery, same CommonJS `__dirname` anchor (see that
// module's own doc comment for the full reasoning).
//
// This module does NO interpretation. It deserializes an artifact whose every semantic decision
// was already made and verified in JS by rules/compile.mjs -- see ruleCheck.ts's own doc comment
// for that boundary.

import fs from 'node:fs';
import path from 'node:path';
import type { RuleOperation } from './ruleCheck';

const SCHEMAS_DIR = path.join(__dirname, 'rulesSchemas');

const EMPTY_OPERATION: RuleOperation = { field: [], cross: [], transition: [] };

function loadOne(filePath: string): Record<string, RuleOperation> {
	let raw: any;
	try {
		raw = JSON.parse(fs.readFileSync(filePath, 'utf8'));
	} catch (err) {
		console.warn(`ruleSet: could not read/parse ${filePath} -- its rules will not be enforced`, err);
		return {};
	}
	const operations: Record<string, RuleOperation> = {};
	for (const [operationId, entry] of Object.entries<any>(raw.operations ?? {})) {
		operations[operationId] = {
			field: entry.field ?? [],
			cross: entry.cross ?? [],
			transition: entry.transition ?? [],
		};
	}
	return operations;
}

function loadAll(): Map<string, RuleOperation> {
	const merged = new Map<string, RuleOperation>();
	if (!fs.existsSync(SCHEMAS_DIR)) return merged;
	const files = fs.readdirSync(SCHEMAS_DIR).filter((f) => f.endsWith('.rules.json')).sort();
	for (const file of files) {
		for (const [operationId, ops] of Object.entries(loadOne(path.join(SCHEMAS_DIR, file)))) {
			if (merged.has(operationId)) {
				console.warn(`ruleSet: operationId "${operationId}" is declared by more than one *.rules.json on disk -- the last one loaded wins`);
			}
			merged.set(operationId, ops);
		}
	}
	return merged;
}

const OPERATIONS = loadAll();

/** Never undefined -- an operation with no rules returns the shared empty operation object. */
export function forOperation(operationId: string): RuleOperation {
	return OPERATIONS.get(operationId) ?? EMPTY_OPERATION;
}
