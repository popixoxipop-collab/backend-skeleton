package {{BASE_PACKAGE}}.global.observe;

import {{JACKSON_PACKAGE}}.JsonNode;
import {{JACKSON_PACKAGE}}.ObjectMapper;
import lombok.extern.slf4j.Slf4j;
import org.springframework.core.io.Resource;
import org.springframework.core.io.support.PathMatchingResourcePatternResolver;
import org.springframework.stereotype.Component;

import java.io.IOException;
import java.io.InputStream;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.Iterator;
import java.util.List;
import java.util.Map;
import java.util.regex.Pattern;
import java.util.regex.PatternSyntaxException;

/**
 * D-runtime-conformance-receipts: loads every {@code bskel/*.observed-schema.json} classpath
 * resource (one per feature {@code bskel observe emit} has been run against) at startup and merges
 * them into one flat map keyed by operationId -- a deployed app has no access to {@code specs/} at
 * runtime, same reasoning {@code ResourceResolver#contractRef()}'s own javadoc already states for
 * {@code CONTRACT_REF}, just a structured classpath resource here instead of one baked string
 * constant, because this payload is bigger than one token.
 *
 * <p>Every {@code pattern} keyword is compiled exactly ONCE here, not per-request -- a {@link
 * PatternSyntaxException} at this point marks that one field {@code unsupported} rather than
 * failing app startup. An externally-sourced (if length-capped, see
 * {@code contracts/openapi.mjs}'s {@code MAX_PATTERN_LENGTH}) regex is a real, not fully solved,
 * ReDoS risk -- this only guards against a malformed pattern, not a pathological-but-valid one.
 * See DECISIONS.md D-runtime-conformance-receipts for the full reasoning.
 *
 * <p>Generated by backend-skeleton ({@code bskel observe emit}).
 */
@Component
@Slf4j
public class ObserveSchemaLoader {

	public record ObservedProperty(String type, Pattern pattern) {}

	public record ObservedObject(List<String> required, Map<String, ObservedProperty> properties, List<String> unsupported) {
		public static final ObservedObject EMPTY = new ObservedObject(List.of(), Map.of(), List.of());
	}

	public record ObservedOperation(
		String featureId, String featureUid, String contractRef, String verb, String path,
		ObservedObject pathParams, String body, ObservedObject request, ObservedObject response, ObservedObject error,
		List<String> statuses
	) {}

	private final Map<String, ObservedOperation> operationsById = new HashMap<>();

	public ObserveSchemaLoader(ObjectMapper objectMapper) {
		try {
			Resource[] resources = new PathMatchingResourcePatternResolver().getResources("classpath*:bskel/*.observed-schema.json");
			for (Resource resource : resources) {
				loadOne(resource, objectMapper);
			}
		} catch (IOException e) {
			log.warn("ObserveSchemaLoader: could not scan classpath:bskel/*.observed-schema.json -- contract-conformance checking is disabled for this run", e);
		}
	}

	private void loadOne(Resource resource, ObjectMapper objectMapper) {
		try (InputStream in = resource.getInputStream()) {
			JsonNode root = objectMapper.readTree(in);
			String featureId = root.path("feature_id").asText(null);
			String featureUid = root.path("feature_uid").asText(null);
			String contractRef = root.path("contract_ref").asText(null);
			Iterator<Map.Entry<String, JsonNode>> ops = root.path("operations").fields();
			while (ops.hasNext()) {
				Map.Entry<String, JsonNode> entry = ops.next();
				String operationId = entry.getKey();
				JsonNode op = entry.getValue();
				String body = op.path("body").asText("unknown");
				ObservedOperation observed = new ObservedOperation(
					featureId, featureUid, contractRef,
					op.path("verb").asText(null), op.path("path").asText(null),
					parseObject(op.path("pathParams")),
					body,
					"false".equals(body) ? null : parseObject(op.path("request")),
					parseObject(op.path("response")),
					parseObject(op.path("error")),
					parseStringList(op.path("statuses"))
				);
				if (operationsById.put(operationId, observed) != null) {
					log.warn("ObserveSchemaLoader: operationId \"{}\" is declared by more than one *.observed-schema.json on the classpath -- the last one loaded wins", operationId);
				}
			}
		} catch (IOException e) {
			log.warn("ObserveSchemaLoader: could not read/parse {} -- skipping this feature's observed schema", resource, e);
		}
	}

	private static ObservedObject parseObject(JsonNode node) {
		if (node == null || node.isMissingNode() || node.isNull()) return ObservedObject.EMPTY;
		List<String> required = parseStringList(node.path("required"));
		List<String> unsupported = new ArrayList<>(parseStringList(node.path("unsupported")));
		Map<String, ObservedProperty> properties = new HashMap<>();
		Iterator<Map.Entry<String, JsonNode>> props = node.path("properties").fields();
		while (props.hasNext()) {
			Map.Entry<String, JsonNode> entry = props.next();
			JsonNode propSchema = entry.getValue();
			String type = propSchema.path("type").asText(null);
			String patternText = propSchema.has("pattern") ? propSchema.get("pattern").asText() : null;
			Pattern pattern = null;
			if (patternText != null) {
				try {
					pattern = Pattern.compile(patternText);
				} catch (PatternSyntaxException e) {
					unsupported.add("/" + entry.getKey());
					continue;
				}
			}
			properties.put(entry.getKey(), new ObservedProperty(type, pattern));
		}
		return new ObservedObject(required, properties, unsupported);
	}

	private static List<String> parseStringList(JsonNode node) {
		List<String> values = new ArrayList<>();
		if (node != null && node.isArray()) {
			for (JsonNode item : node) values.add(item.asText());
		}
		return values;
	}

	/** Null when no loaded *.observed-schema.json declares this operationId. */
	public ObservedOperation get(String operationId) {
		return operationsById.get(operationId);
	}
}
