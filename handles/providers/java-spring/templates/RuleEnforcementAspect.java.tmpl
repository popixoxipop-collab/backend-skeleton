package {{BASE_PACKAGE}}.global.rules;

import {{JACKSON_PACKAGE}}.JsonNode;
import {{JACKSON_PACKAGE}}.ObjectMapper;
import {{BASE_PACKAGE}}.global.rules.RuleSetLoader.RuleOperation;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.aspectj.lang.ProceedingJoinPoint;
import org.aspectj.lang.annotation.Around;
import org.aspectj.lang.annotation.Aspect;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.http.HttpStatus;
import org.springframework.stereotype.Component;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.server.ResponseStatusException;

import java.lang.annotation.Annotation;
import java.lang.reflect.Method;
import java.util.List;

/**
 * D-business-rules (R8/R9): the opt-in AUTOMATIC half of business-rule checking -- exists only for
 * methods a human has chosen to mark with {@link EnforceRules}. Checks FIELD and CROSS rules only;
 * see {@link EnforceRules}'s own javadoc for why TRANSITION rules are excluded from this automatic
 * path.
 *
 * <p><b>The observe/enforce split is a RUNTIME property, read once per call from {@code
 * bskel.rules.mode} (default {@code "observe"}):</b>
 * <ul>
 *   <li>{@code observe} (default): every violation is logged (see {@code bskel.rules.violations}
 *       logger), the wrapped call always proceeds. The same "measure before you enforce" posture
 *       {@code ContractObservationAspect} already established for contract shape checking -- see
 *       DECISIONS.md's D-openapi-request-schema for why turning validation on in a brownfield app
 *       is a real behavior change (a request that used to succeed can start failing), not a free
 *       safety improvement.</li>
 *   <li>{@code enforce}: a violation rejects the call with HTTP 400 BEFORE it reaches the wrapped
 *       method -- {@code joinPoint.proceed()} is never called. The rejection message may name a
 *       rule id, a JSON Pointer, and a rule's own declared bound; it NEVER contains an observed
 *       request value -- the same redaction invariant {@link RuleCheck#Violation} carries.</li>
 * </ul>
 *
 * <p><b>Fail-open on an INTERNAL error, fail-closed on a REAL violation.</b> If this aspect itself
 * cannot compute violations (a malformed request body, a loader problem), that is logged and the
 * wrapped call proceeds unaffected, in BOTH modes -- an unrelated bug in this aspect must never
 * become an outage for every request through an enforced endpoint. Only an actual, successfully
 * computed rule violation can reject a call, and only in enforce mode.
 *
 * <p>Generated by backend-skeleton ({@code bskel rules emit}). Requires {@code
 * spring-boot-starter-aop} on the classpath -- see {@link EnforceRules}'s own javadoc.
 */
@Aspect
@Component
@RequiredArgsConstructor
@Slf4j
public class RuleEnforcementAspect {

	private static final org.slf4j.Logger VIOLATIONS = org.slf4j.LoggerFactory.getLogger("bskel.rules.violations");

	private final RuleSetLoader ruleSetLoader;
	private final ObjectMapper objectMapper;

	@Value("${bskel.rules.mode:observe}")
	private String mode;

	@Around("@annotation(enforceRules)")
	public Object enforce(ProceedingJoinPoint joinPoint, EnforceRules enforceRules) throws Throwable {
		String operationId = enforceRules.operationId();
		RuleOperation rules = ruleSetLoader.forOperation(operationId);
		if (rules.isEmpty()) {
			// Nothing compiled for this operation -- most commonly a feature with no rules.yaml and
			// a contract that projected nothing enforceable. Proceeds silently: an empty rule set is
			// not a misconfiguration worth logging on every call.
			return joinPoint.proceed();
		}

		List<RuleCheck.Violation> violations = safelyCheck(joinPoint, rules, operationId);
		if (!violations.isEmpty()) {
			logViolations(operationId, violations);
			if ("enforce".equals(mode)) {
				throw new ResponseStatusException(HttpStatus.BAD_REQUEST, summarize(operationId, violations));
			}
		}
		return joinPoint.proceed();
	}

	private List<RuleCheck.Violation> safelyCheck(ProceedingJoinPoint joinPoint, RuleOperation rules, String operationId) {
		try {
			Object requestBody = findRequestBodyArg(joinPoint);
			if (requestBody == null) return List.of();
			JsonNode body = objectMapper.valueToTree(requestBody);
			return RuleCheck.check(rules, body);
		} catch (Exception e) {
			log.warn("RuleEnforcementAspect: could not evaluate rules for operation \"{}\" -- the wrapped call proceeds unaffected", operationId, e);
			return List.of();
		}
	}

	/** Same technique ContractObservationAspect's own findRequestBodyArg uses: a real, unambiguous `@RequestBody` signal on the method, never guessed by position. */
	private static Object findRequestBodyArg(ProceedingJoinPoint joinPoint) {
		if (!(joinPoint.getSignature() instanceof org.aspectj.lang.reflect.MethodSignature sig)) return null;
		Method method = sig.getMethod();
		Annotation[][] paramAnnotations = method.getParameterAnnotations();
		Object[] args = joinPoint.getArgs();
		for (int i = 0; i < paramAnnotations.length && i < args.length; i++) {
			for (Annotation a : paramAnnotations[i]) {
				if (a instanceof RequestBody) return args[i];
			}
		}
		return null;
	}

	private void logViolations(String operationId, List<RuleCheck.Violation> violations) {
		try {
			for (RuleCheck.Violation v : violations) {
				VIOLATIONS.warn("operation={} rule={} pointer={} kind={} mode={} -- {}", operationId, v.ruleId(), v.pointer(), v.kind(), mode, v.message());
			}
		} catch (Exception e) {
			log.warn("RuleEnforcementAspect: could not log violations for operation \"{}\"", operationId, e);
		}
	}

	/** Builds the HTTP 400 message from rule id / pointer / bound-derived text only -- never an observed value, the same redaction invariant every Violation#message() already holds. */
	private static String summarize(String operationId, List<RuleCheck.Violation> violations) {
		StringBuilder sb = new StringBuilder("business rule violation(s) for ").append(operationId).append(": ");
		for (int i = 0; i < violations.size(); i++) {
			if (i > 0) sb.append("; ");
			RuleCheck.Violation v = violations.get(i);
			sb.append(v.pointer()).append(" (").append(v.ruleId()).append("): ").append(v.message());
		}
		return sb.toString();
	}
}
