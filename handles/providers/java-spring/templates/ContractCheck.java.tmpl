package {{BASE_PACKAGE}}.global.observe;

import {{JACKSON_PACKAGE}}.JsonNode;
import {{BASE_PACKAGE}}.global.observe.ObserveSchemaLoader.ObservedObject;
import {{BASE_PACKAGE}}.global.observe.ObserveSchemaLoader.ObservedProperty;

import java.util.ArrayList;
import java.util.List;
import java.util.Map;
import java.util.regex.Pattern;

/**
 * D-runtime-conformance-receipts: pure, static, non-Spring utility -- the only place a real
 * observed value is ever looked at. {@link Violation#message()} MUST NEVER interpolate the
 * observed value itself, only the JSON Pointer and constraint kind ("required"/"type"/"pattern"/
 * "unsupported") -- a real payload value must never leave this process, structurally, not by
 * convention (see DECISIONS.md D-runtime-conformance-receipts, Decision A). This invariant has its
 * own dedicated test asserting no violation message, across a battery of bad inputs, ever contains
 * the input string -- see the companion java-observe-smoke script, not just this class's own
 * javadoc.
 *
 * <p>Every check here matches exactly what {@code handles/providers/java-spring/observe.mjs}'s own
 * projection produces -- required-field presence, scalar (string/number/integer/boolean) type, and
 * a pre-compiled regex pattern. Nothing deeper: a property this checker cannot evaluate is marked
 * {@code unsupported} at its own pointer by the JS-side projection already, never guessed at here.
 *
 * <p>Generated by backend-skeleton ({@code bskel observe emit}).
 */
public final class ContractCheck {

	private ContractCheck() {}

	public record Violation(String pointer, String keyword, String message) {}

	/**
	 * Checks {@code actual} (a request pathParams map, or a request/response/error JSON body)
	 * against {@code schema}. {@code basePointer} is prefixed onto every violation's own pointer
	 * ("" for the root, e.g. "/body" when checking a wrapped body).
	 */
	public static List<Violation> checkObject(ObservedObject schema, JsonNode actual, String basePointer) {
		List<Violation> violations = new ArrayList<>();
		if (schema == null) return violations;
		for (String pointer : schema.unsupported()) {
			violations.add(new Violation(basePointer + pointer, "unsupported", "schema at this pointer is deeper than this checker supports for now -- not validated"));
		}
		if (actual == null || actual.isMissingNode() || actual.isNull()) {
			if (!schema.required().isEmpty() || !schema.properties().isEmpty()) {
				violations.add(new Violation(basePointer.isEmpty() ? "" : basePointer, "type", "expected an object, got none"));
			}
			return violations;
		}
		if (!actual.isObject()) {
			violations.add(new Violation(basePointer, "type", "expected an object"));
			return violations;
		}
		for (String field : schema.required()) {
			if (!actual.has(field)) {
				violations.add(new Violation(basePointer + "/" + field, "required", "missing required field"));
			}
		}
		for (Map.Entry<String, ObservedProperty> entry : schema.properties().entrySet()) {
			String field = entry.getKey();
			if (!actual.has(field)) continue; // required-ness already checked above; an absent optional field is not a violation
			checkScalar(entry.getValue(), actual.get(field), basePointer + "/" + field, violations);
		}
		return violations;
	}

	/** Path params arrive as a name->raw-string map (Spring's own `@PathVariable` shape), not JSON -- checked structurally the same way, without a JsonNode wrapper. */
	public static List<Violation> checkPathParams(ObservedObject schema, Map<String, String> actual) {
		List<Violation> violations = new ArrayList<>();
		if (schema == null) return violations;
		for (String pointer : schema.unsupported()) {
			violations.add(new Violation("/pathParams" + pointer, "unsupported", "schema at this pointer is deeper than this checker supports for now -- not validated"));
		}
		for (String field : schema.required()) {
			String value = actual.get(field);
			if (value == null) {
				violations.add(new Violation("/pathParams/" + field, "required", "missing required path parameter"));
				continue;
			}
			ObservedProperty prop = schema.properties().get(field);
			if (prop != null && prop.pattern() != null && !prop.pattern().matcher(value).matches()) {
				violations.add(new Violation("/pathParams/" + field, "pattern", "does not match the required pattern"));
			}
		}
		return violations;
	}

	private static void checkScalar(ObservedProperty prop, JsonNode value, String pointer, List<Violation> violations) {
		if (prop.type() != null && !matchesType(prop.type(), value)) {
			violations.add(new Violation(pointer, "type", "expected type \"" + prop.type() + "\""));
			return;
		}
		if (prop.pattern() != null && value.isTextual() && !prop.pattern().matcher(value.asText()).matches()) {
			violations.add(new Violation(pointer, "pattern", "does not match the required pattern"));
		}
	}

	private static boolean matchesType(String type, JsonNode value) {
		return switch (type) {
			case "string" -> value.isTextual();
			case "boolean" -> value.isBoolean();
			case "integer" -> value.isIntegralNumber();
			case "number" -> value.isNumber();
			default -> true; // an unrecognized type name is not this checker's job to enforce -- unsupported() already named anything it can't classify
		};
	}

	/**
	 * A8: {@code statusKey} is a literal source-document status key ("200", a range like "4XX", or
	 * "default") -- {@code contracts/emit.mjs}'s own {@code sourceResponses} vocabulary
	 * ({@code schemas/feature-contract.schema.json}'s {@code ^(?:[1-5](?:[0-9]{2}|XX)|default)$}
	 * pattern). Matching a REAL observed status against this key is a bounded, mechanical string
	 * comparison, not JSON-Schema interpretation -- doing it here does not reintroduce a second
	 * schema interpreter (see Decision B in DECISIONS.md).
	 */
	public static boolean statusMatches(String statusKey, int actualStatus) {
		if ("default".equals(statusKey)) return true;
		if (statusKey.length() != 3) return false;
		String actual = String.valueOf(actualStatus);
		if (actual.length() != 3) return false;
		for (int i = 0; i < 3; i++) {
			char k = statusKey.charAt(i);
			if (k != 'X' && k != actual.charAt(i)) return false;
		}
		return true;
	}
}
