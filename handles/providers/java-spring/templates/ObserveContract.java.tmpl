package {{BASE_PACKAGE}}.global.observe;

import java.lang.annotation.ElementType;
import java.lang.annotation.Retention;
import java.lang.annotation.RetentionPolicy;
import java.lang.annotation.Target;

/**
 * D-runtime-conformance-receipts: apply this to an EXISTING controller/service method (never
 * generated onto one -- a human decides which methods are worth observing) to have {@link
 * ContractObservationAspect} check the real request/response against this operation's contract
 * shape and log a verdict-only receipt. Never captures or logs an observed value -- see {@link
 * ContractCheck}'s own javadoc.
 *
 * <p>Must be applied to the CONCRETE implementation method, not an interface method it overrides
 * -- Spring AOP's {@code @annotation} pointcut resolves via {@code AopUtils#getMostSpecificMethod},
 * reliable for both JDK dynamic proxies (interface-based) and CGLIB, whereas an interface-only
 * annotation is only guaranteed visible through a JDK proxy (same constraint O4's
 * {@code @RecordHandleSnapshot} already documents -- see DECISIONS.md D-handle-lifecycle).
 *
 * <p>Only {@code operationId()} is required -- unlike {@code @RecordHandleSnapshot}, there is no
 * {@code resourceType}/{@code resourceUidParam}/{@code redact}: a value-blind verdict has no
 * resource identity concept and nothing to redact.
 *
 * <p>Example:
 * <pre>{@code
 * @ObserveContract(operationId = "findWidget")
 * public String findWidget(@PathVariable String widgetId) { ... }
 * }</pre>
 *
 * <p>Generated by backend-skeleton ({@code bskel observe emit}). Requires {@code
 * spring-boot-starter-aop} on the target repo's own classpath -- NOT added automatically (see
 * {@code observe emit}'s own post-emit notes), matching this project's established boundary of
 * never auto-editing a target's build file.
 */
@Retention(RetentionPolicy.RUNTIME)
@Target(ElementType.METHOD)
public @interface ObserveContract {

	/** Must match a key in the emitted {@code <feature-id>.observed-schema.json}'s own operations map. */
	String operationId();
}
