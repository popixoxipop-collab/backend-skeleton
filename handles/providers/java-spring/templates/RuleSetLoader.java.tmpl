package {{BASE_PACKAGE}}.global.rules;

import {{JACKSON_PACKAGE}}.JsonNode;
import {{JACKSON_PACKAGE}}.ObjectMapper;
import lombok.extern.slf4j.Slf4j;
import org.springframework.core.io.Resource;
import org.springframework.core.io.support.PathMatchingResourcePatternResolver;
import org.springframework.stereotype.Component;

import java.io.IOException;
import java.io.InputStream;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

/**
 * D-business-rules (R9): loads every {@code bskel/*.rules.json} classpath resource (one per feature
 * {@code bskel rules emit} has been run against) at startup and merges them into one flat map keyed
 * by operationId. Same reasoning as {@code ObserveSchemaLoader}: a deployed app has no access to
 * {@code specs/} at runtime, so the compiled artifact travels as a classpath resource.
 *
 * <p>This class does NO interpretation. It deserializes an artifact whose every semantic decision
 * was already made and verified in JS by {@code rules/compile.mjs} -- see {@code RuleCheck}'s own
 * javadoc for that boundary.
 *
 * <p>Generated by backend-skeleton ({@code bskel rules emit}). Do not hand-edit -- change the
 * source rule and regenerate.
 */
@Component
@Slf4j
public class RuleSetLoader {

	/** {@code value} carries the declared bound for numeric/length assertions; {@code enumValues} is used only by the `enum` assertion. */
	public record FieldRule(String id, String pointer, String assertion, JsonNode value, List<JsonNode> enumValues, String origin) {}

	public record CrossRule(String id, List<String> pointers, String assertion, List<String> types, String origin) {}

	public record TransitionRule(String id, String pointer, List<String> from, List<String> to, String origin) {}

	public record RuleOperation(List<FieldRule> field, List<CrossRule> cross, List<TransitionRule> transition) {
		public static final RuleOperation EMPTY = new RuleOperation(List.of(), List.of(), List.of());
		public boolean isEmpty() { return field.isEmpty() && cross.isEmpty() && transition.isEmpty(); }
	}

	private final Map<String, RuleOperation> operationsById = new HashMap<>();
	private final Map<String, String> contractRefByOperation = new HashMap<>();

	public RuleSetLoader(ObjectMapper objectMapper) {
		try {
			Resource[] resources = new PathMatchingResourcePatternResolver().getResources("classpath*:bskel/*.rules.json");
			for (Resource resource : resources) {
				try (InputStream in = resource.getInputStream()) {
					load(objectMapper.readTree(in));
				} catch (IOException e) {
					// One unreadable resource must not take down application startup -- the same
					// posture ObserveSchemaLoader takes for its own resources.
					log.warn("bskel: could not read rules resource {} -- its rules will not be enforced", resource.getFilename(), e);
				}
			}
		} catch (IOException e) {
			log.warn("bskel: could not scan for bskel/*.rules.json rule resources -- no business rules will be enforced", e);
		}
	}

	private void load(JsonNode doc) {
		String contractRef = doc.path("contract_ref").asText("");
		JsonNode operations = doc.path("operations");
		operations.fieldNames().forEachRemaining((operationId) -> {
			JsonNode entry = operations.path(operationId);
			operationsById.put(operationId, new RuleOperation(
				fieldRules(entry.path("field")),
				crossRules(entry.path("cross")),
				transitionRules(entry.path("transition"))
			));
			contractRefByOperation.put(operationId, contractRef);
		});
	}

	private static List<FieldRule> fieldRules(JsonNode array) {
		List<FieldRule> rules = new ArrayList<>();
		if (!array.isArray()) return rules;
		for (JsonNode node : array) {
			JsonNode value = node.path("value");
			List<JsonNode> enumValues = new ArrayList<>();
			if (value.isArray()) for (JsonNode item : value) enumValues.add(item);
			rules.add(new FieldRule(
				node.path("id").asText(), node.path("pointer").asText(), node.path("assert").asText(),
				value, List.copyOf(enumValues), node.path("origin").asText()
			));
		}
		return List.copyOf(rules);
	}

	private static List<CrossRule> crossRules(JsonNode array) {
		List<CrossRule> rules = new ArrayList<>();
		if (!array.isArray()) return rules;
		for (JsonNode node : array) {
			rules.add(new CrossRule(
				node.path("id").asText(), texts(node.path("pointers")), node.path("assert").asText(),
				texts(node.path("types")), node.path("origin").asText()
			));
		}
		return List.copyOf(rules);
	}

	private static List<TransitionRule> transitionRules(JsonNode array) {
		List<TransitionRule> rules = new ArrayList<>();
		if (!array.isArray()) return rules;
		for (JsonNode node : array) {
			rules.add(new TransitionRule(
				node.path("id").asText(), node.path("pointer").asText(),
				texts(node.path("from")), texts(node.path("to")), node.path("origin").asText()
			));
		}
		return List.copyOf(rules);
	}

	private static List<String> texts(JsonNode array) {
		List<String> out = new ArrayList<>();
		if (array.isArray()) for (JsonNode node : array) out.add(node.asText());
		return List.copyOf(out);
	}

	/** Never null -- an operation with no rules returns {@link RuleOperation#EMPTY}. */
	public RuleOperation forOperation(String operationId) {
		return operationsById.getOrDefault(operationId, RuleOperation.EMPTY);
	}

	/** The sha256 of the contract these rules were compiled and verified against. */
	public String contractRefFor(String operationId) {
		return contractRefByOperation.getOrDefault(operationId, "");
	}

	public int operationCount() {
		return operationsById.size();
	}
}
