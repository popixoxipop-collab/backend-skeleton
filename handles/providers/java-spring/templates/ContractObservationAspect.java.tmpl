package {{BASE_PACKAGE}}.global.observe;

import {{JACKSON_PACKAGE}}.JsonNode;
import {{JACKSON_PACKAGE}}.ObjectMapper;
import {{JACKSON_PACKAGE}}.node.ArrayNode;
import {{JACKSON_PACKAGE}}.node.ObjectNode;
import {{BASE_PACKAGE}}.global.observe.ObserveSchemaLoader.ObservedOperation;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.aspectj.lang.ProceedingJoinPoint;
import org.aspectj.lang.annotation.Around;
import org.aspectj.lang.annotation.Aspect;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Component;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.context.request.RequestContextHolder;
import org.springframework.web.context.request.ServletRequestAttributes;
import org.springframework.web.server.ResponseStatusException;
import org.springframework.web.servlet.HandlerMapping;

import java.lang.annotation.Annotation;
import java.lang.reflect.Method;
import java.time.Instant;
import java.util.List;
import java.util.Map;

/**
 * D-runtime-conformance-receipts: the opt-in AUTOMATIC half of runtime contract-conformance
 * checking -- exists only for methods a human has chosen to mark with {@link ObserveContract}.
 * Never activates on anything else, and a failure here is ALWAYS logged and swallowed, never
 * allowed to fail the real call it wraps (best-effort observability, same posture O4's own {@code
 * HandleAspect} already establishes for handle snapshots -- see its javadoc).
 *
 * <p>Intended for a Spring MVC {@code @RequestMapping}-family controller method specifically (see
 * {@link ObserveContract}'s own example) -- path-parameter values are read from the current
 * request's own {@code HandlerMapping.URI_TEMPLATE_VARIABLES_ATTRIBUTE}, which Spring's
 * {@code DispatcherServlet} only populates for a request actually routed through a
 * {@code @RequestMapping} handler. Applying this to a plain service method still runs (it never
 * throws for that reason), but path-parameter and status-code checks are silently skipped without
 * a real {@code HttpServletRequest} in scope -- named here explicitly as v1's real, deliberate
 * scope boundary.
 *
 * <p>Only two response shapes are understood: {@link ResponseEntity} (status + body read
 * directly) and a plain return value (assumed HTTP 200, body = the return value itself -- Spring's
 * default {@code @ResponseBody} behavior on a REST controller). A thrown
 * {@link ResponseStatusException} contributes its own status; any other exception is recorded with
 * an unresolved status (the status check is skipped, not guessed). Async return types
 * ({@code CompletableFuture}/{@code Mono}/{@code Flux}/{@code DeferredResult}) are NOT unwrapped --
 * deliberately deferred, same unexamined assumption {@code HandleAspect} already carries for
 * {@code @Around} advice generally. See DECISIONS.md D-runtime-conformance-receipts.
 *
 * <p>Generated by backend-skeleton ({@code bskel observe emit}). Requires {@code
 * spring-boot-starter-aop} on the classpath -- see {@link ObserveContract}'s own javadoc.
 */
@Aspect
@Component
@RequiredArgsConstructor
@Slf4j
public class ContractObservationAspect {

	private static final org.slf4j.Logger RECEIPTS = org.slf4j.LoggerFactory.getLogger("bskel.observe.receipts");

	private final ObserveSchemaLoader schemaLoader;
	private final ObjectMapper objectMapper;

	@Around("@annotation(observeContract)")
	public Object observe(ProceedingJoinPoint joinPoint, ObserveContract observeContract) throws Throwable {
		String operationId = observeContract.operationId();
		ObservedOperation op = schemaLoader.get(operationId);
		if (op == null) {
			log.warn("ContractObservationAspect: no observed schema loaded for operationId \"{}\" on {} -- skipping, the wrapped call proceeds unaffected", operationId, joinPoint.getSignature());
			return joinPoint.proceed();
		}

		List<ContractCheck.Violation> requestViolations = safelyList(() -> checkRequest(joinPoint, op), "request");

		try {
			Object result = joinPoint.proceed();
			safely(() -> emitReceipt(op, operationId, requestViolations, checkResponse(op, result), statusOf(result), null), "response");
			return result;
		} catch (Throwable t) {
			safely(() -> emitReceipt(op, operationId, requestViolations, List.of(), statusOfThrowable(t), t.getClass().getSimpleName()), "error");
			throw t;
		}
	}

	private List<ContractCheck.Violation> checkRequest(ProceedingJoinPoint joinPoint, ObservedOperation op) {
		List<ContractCheck.Violation> violations = new java.util.ArrayList<>();
		Map<String, String> uriVars = currentUriTemplateVariables();
		if (uriVars != null) {
			violations.addAll(ContractCheck.checkPathParams(op.pathParams(), uriVars));
		}
		if (!"false".equals(op.body())) {
			Object requestBody = findRequestBodyArg(joinPoint);
			if (requestBody != null) {
				violations.addAll(ContractCheck.checkObject(op.request(), objectMapper.valueToTree(requestBody), "/body"));
			}
		}
		return violations;
	}

	private List<ContractCheck.Violation> checkResponse(ObservedOperation op, Object result) {
		Object body = result instanceof ResponseEntity<?> entity ? entity.getBody() : result;
		if (body == null) return List.of();
		return ContractCheck.checkObject(op.response(), objectMapper.valueToTree(body), "/body");
	}

	/** Reads Spring's own per-request URI-template-variable map; null outside a real HTTP request (e.g. a plain service-method call). */
	private static Map<String, String> currentUriTemplateVariables() {
		if (!(RequestContextHolder.getRequestAttributes() instanceof ServletRequestAttributes attrs)) return null;
		Object raw = attrs.getRequest().getAttribute(HandlerMapping.URI_TEMPLATE_VARIABLES_ATTRIBUTE);
		return raw instanceof Map<?, ?> map ? (Map<String, String>) map : null;
	}

	/** The single argument carrying Spring's own `@RequestBody` -- a real, unambiguous signal already on the method, never guessed by position/index. */
	private static Object findRequestBodyArg(ProceedingJoinPoint joinPoint) {
		if (!(joinPoint.getSignature() instanceof org.aspectj.lang.reflect.MethodSignature sig)) return null;
		Method method = sig.getMethod();
		Annotation[][] paramAnnotations = method.getParameterAnnotations();
		Object[] args = joinPoint.getArgs();
		for (int i = 0; i < paramAnnotations.length && i < args.length; i++) {
			for (Annotation a : paramAnnotations[i]) {
				if (a instanceof RequestBody) return args[i];
			}
		}
		return null;
	}

	private static Integer statusOf(Object result) {
		if (result instanceof ResponseEntity<?> entity) return entity.getStatusCode().value();
		return 200;
	}

	private static Integer statusOfThrowable(Throwable t) {
		if (t instanceof ResponseStatusException rse) return rse.getStatusCode().value();
		return null; // unresolved -- the status check is skipped for this receipt, not guessed
	}

	private void emitReceipt(ObservedOperation op, String operationId, List<ContractCheck.Violation> requestViolations, List<ContractCheck.Violation> responseViolations, Integer status, String errorClass) {
		List<ContractCheck.Violation> all = new java.util.ArrayList<>(requestViolations);
		all.addAll(responseViolations);
		if (status != null && op.statuses() != null && !op.statuses().isEmpty()) {
			boolean matched = op.statuses().stream().anyMatch(key -> ContractCheck.statusMatches(key, status));
			if (!matched) all.add(new ContractCheck.Violation("/status", "status", "observed status " + status + " is not among the documented status keys"));
		}
		ObjectNode receipt = objectMapper.createObjectNode();
		receipt.put("feature_id", op.featureId());
		receipt.put("feature_uid", op.featureUid());
		receipt.put("operation_id", operationId);
		receipt.put("contract_ref", op.contractRef());
		receipt.put("verb", op.verb());
		if (status != null) receipt.put("status", status);
		if (errorClass != null) receipt.put("error_class", errorClass);
		receipt.put("recorded_at", Instant.now().toString());
		ArrayNode violationsNode = receipt.putArray("violations");
		for (ContractCheck.Violation v : all) {
			ObjectNode vn = violationsNode.addObject();
			vn.put("pointer", v.pointer());
			vn.put("keyword", v.keyword());
			vn.put("message", v.message());
		}
		safelyLog(receipt);
	}

	private void safelyLog(Object receipt) {
		try {
			RECEIPTS.info(objectMapper.writeValueAsString(receipt));
		} catch (Exception e) {
			log.warn("ContractObservationAspect: could not serialize/log a receipt -- the wrapped call already returned unaffected", e);
		}
	}

	/** Best-effort: any failure here is logged, never propagated -- see this class's own javadoc for why. */
	private void safely(Runnable action, String phase) {
		try {
			action.run();
		} catch (Exception e) {
			log.warn("ContractObservationAspect: could not complete the {} check -- the wrapped call proceeds/already returned unaffected", phase, e);
		}
	}

	private List<ContractCheck.Violation> safelyList(java.util.function.Supplier<List<ContractCheck.Violation>> action, String phase) {
		try {
			return action.get();
		} catch (Exception e) {
			log.warn("ContractObservationAspect: could not complete the {} check -- the wrapped call proceeds unaffected", phase, e);
			return List.of();
		}
	}
}
