package {{BASE_PACKAGE}}.global.rules;

import {{JACKSON_PACKAGE}}.JsonNode;
import {{BASE_PACKAGE}}.global.rules.RuleSetLoader.CrossRule;
import {{BASE_PACKAGE}}.global.rules.RuleSetLoader.FieldRule;
import {{BASE_PACKAGE}}.global.rules.RuleSetLoader.RuleOperation;
import {{BASE_PACKAGE}}.global.rules.RuleSetLoader.TransitionRule;

import java.math.BigDecimal;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;

/**
 * D-business-rules (R3/R9): pure, static, non-Spring executor for one feature's compiled business
 * rules. A DUMB executor by design -- every semantic decision (which assertions exist, whether an
 * assertion may apply to a field's type, whether two fields are comparable, whether a transition's
 * states are real) was already made in JS by {@code rules/compile.mjs} at {@code bskel rules check}
 * time. This class never interprets a JSON Schema and never decides what is checkable; it only
 * executes an already-simplified instruction set. That is the same boundary
 * {@code ContractCheck}/{@code handles/observe-schema-projection.mjs} hold, and it is what lets the
 * Java, Python, and TypeScript executors be guaranteed to agree.
 *
 * <p><b>Redaction invariant, inherited from {@code ContractCheck} and equally binding here:</b>
 * {@link Violation#message()} MUST NEVER interpolate an observed payload value -- only the JSON
 * Pointer, the rule id, and the rule's own declared bound. A bound is safe because it came from the
 * contract or from {@code rules.yaml}, i.e. from the developer, never from a request. A real
 * payload value must never leave this process, structurally rather than by convention.
 *
 * <p>Generated by backend-skeleton ({@code bskel rules emit}). Do not hand-edit -- change the
 * source rule and regenerate.
 */
public final class RuleCheck {

	private RuleCheck() {}

	public record Violation(String ruleId, String pointer, String kind, String message) {}

	/**
	 * Runs every FIELD and CROSS rule for one operation against a request body. Transition rules are
	 * deliberately NOT run here -- see {@link #checkTransitions} for why they need an argument this
	 * method does not have.
	 */
	public static List<Violation> check(RuleOperation rules, JsonNode body) {
		List<Violation> violations = new ArrayList<>();
		if (rules == null || body == null || !body.isObject()) return violations;
		for (FieldRule rule : rules.field()) checkField(rule, body, violations);
		for (CrossRule rule : rules.cross()) checkCross(rule, body, violations);
		return violations;
	}

	private static JsonNode at(JsonNode body, String pointer) {
		// Compiled pointers are always a single top-level "/field" segment (rules/compile.mjs
		// refuses anything deeper), so this is a lookup, not a JSON Pointer implementation.
		JsonNode node = body.get(pointer.substring(1));
		return (node == null || node.isNull() || node.isMissingNode()) ? null : node;
	}

	private static void checkField(FieldRule rule, JsonNode body, List<Violation> out) {
		JsonNode value = at(body, rule.pointer());
		// An absent optional field is not a violation -- requiredness is the contract's own
		// statement, enforced by ContractCheck, deliberately not duplicated in this vocabulary.
		if (value == null) return;
		switch (rule.assertion()) {
			case "minLength" -> {
				if (value.isTextual() && value.asText().length() < rule.value().intValue()) {
					out.add(violation(rule.id(), rule.pointer(), "minLength", "shorter than the required minimum length of " + rule.value().intValue()));
				}
			}
			case "maxLength" -> {
				if (value.isTextual() && value.asText().length() > rule.value().intValue()) {
					out.add(violation(rule.id(), rule.pointer(), "maxLength", "longer than the permitted maximum length of " + rule.value().intValue()));
				}
			}
			case "minimum" -> compareNumber(rule, value, out, (actual, bound) -> actual.compareTo(bound) < 0, "is below the permitted minimum of ");
			case "maximum" -> compareNumber(rule, value, out, (actual, bound) -> actual.compareTo(bound) > 0, "is above the permitted maximum of ");
			case "exclusiveMinimum" -> compareNumber(rule, value, out, (actual, bound) -> actual.compareTo(bound) <= 0, "must be strictly greater than ");
			case "exclusiveMaximum" -> compareNumber(rule, value, out, (actual, bound) -> actual.compareTo(bound) >= 0, "must be strictly less than ");
			case "multipleOf" -> {
				if (value.isNumber() && rule.value().decimalValue().signum() != 0) {
					BigDecimal remainder = value.decimalValue().remainder(rule.value().decimalValue());
					if (remainder.signum() != 0) {
						out.add(violation(rule.id(), rule.pointer(), "multipleOf", "is not an exact multiple of " + rule.value().decimalValue().toPlainString()));
					}
				}
			}
			case "enum" -> {
				boolean matched = false;
				for (JsonNode allowed : rule.enumValues()) {
					if (allowed.equals(value)) { matched = true; break; }
				}
				if (!matched) out.add(violation(rule.id(), rule.pointer(), "enum", "is not one of the " + rule.enumValues().size() + " permitted values"));
			}
			// No default branch that passes silently: an assertion name this executor does not know
			// can only mean the artifact was produced by a NEWER bskel than the code generated here.
			// Reported, never ignored -- the same posture ContractCheck's `unsupported` takes.
			default -> out.add(violation(rule.id(), rule.pointer(), "unsupported",
				"rule assertion \"" + rule.assertion() + "\" is not understood by this generated checker -- re-run `bskel rules emit` to regenerate it"));
		}
	}

	private interface NumberPredicate { boolean violates(BigDecimal actual, BigDecimal bound); }

	private static void compareNumber(FieldRule rule, JsonNode value, List<Violation> out, NumberPredicate predicate, String messagePrefix) {
		if (!value.isNumber()) return;
		BigDecimal bound = rule.value().decimalValue();
		if (predicate.violates(value.decimalValue(), bound)) {
			out.add(violation(rule.id(), rule.pointer(), rule.assertion(), messagePrefix + bound.toPlainString()));
		}
	}

	private static void checkCross(CrossRule rule, JsonNode body, List<Violation> out) {
		List<String> pointers = rule.pointers();
		String first = pointers.get(0);
		JsonNode a = at(body, first);

		if ("requiredIf".equals(rule.assertion())) {
			if (a != null && at(body, pointers.get(1)) == null) {
				out.add(violation(rule.id(), pointers.get(1), "requiredIf", "is required because " + first + " is present"));
			}
			return;
		}
		if ("mutuallyExclusive".equals(rule.assertion())) {
			List<String> present = new ArrayList<>();
			for (String pointer : pointers) if (at(body, pointer) != null) present.add(pointer);
			if (present.size() > 1) {
				out.add(violation(rule.id(), first, "mutuallyExclusive", "at most one of " + String.join(", ", pointers) + " may be present, got " + present.size()));
			}
			return;
		}

		JsonNode b = at(body, pointers.get(1));
		// Either side absent means there is nothing to compare. Deliberately not a violation:
		// requiredness is the contract's statement, and a cross-field rule that also implied
		// requiredness would enforce something the developer never declared.
		if (a == null || b == null) return;

		int cmp;
		if (a.isNumber() && b.isNumber()) {
			cmp = a.decimalValue().compareTo(b.decimalValue());
		} else if (a.isTextual() && b.isTextual()) {
			cmp = a.asText().compareTo(b.asText());
		} else {
			// rules/compile.mjs proved these two pointers were mutually comparable against the
			// contract's declared types, so reaching here means the real payload disagrees with the
			// contract. Reported as its own kind rather than silently passing.
			out.add(violation(rule.id(), first, "incomparable", "could not be compared with " + pointers.get(1) + " -- the payload types differ from the contract's declared types"));
			return;
		}

		boolean violated = switch (rule.assertion()) {
			case "lt" -> cmp >= 0;
			case "lte" -> cmp > 0;
			case "gt" -> cmp <= 0;
			case "gte" -> cmp < 0;
			case "eq" -> cmp != 0;
			case "neq" -> cmp == 0;
			default -> false;
		};
		if (violated) {
			out.add(violation(rule.id(), first, rule.assertion(), "must be " + symbolFor(rule.assertion()) + " " + pointers.get(1)));
		} else if (!List.of("lt", "lte", "gt", "gte", "eq", "neq").contains(rule.assertion())) {
			out.add(violation(rule.id(), first, "unsupported",
				"rule assertion \"" + rule.assertion() + "\" is not understood by this generated checker -- re-run `bskel rules emit` to regenerate it"));
		}
	}

	private static String symbolFor(String assertion) {
		return switch (assertion) {
			case "lt" -> "<"; case "lte" -> "<="; case "gt" -> ">"; case "gte" -> ">=";
			case "eq" -> "equal to"; case "neq" -> "different from"; default -> assertion;
		};
	}

	/**
	 * Runs TRANSITION rules. Separate from {@link #check} because a transition guard is inherently a
	 * statement about a change, and a request body only carries the DESTINATION state -- the current
	 * state lives in the application's own datastore, which this class has no access to and must
	 * never acquire.
	 *
	 * <p>{@code currentStates} maps a rule's pointer (e.g. {@code "/status"}) to that resource's
	 * CURRENT persisted value, supplied by the caller. This is the one place a human must wire
	 * something -- the same honest boundary {@code ResourceResolver#patchField} draws.
	 *
	 * <p><b>Fail-closed:</b> a pointer with no entry in {@code currentStates} produces an
	 * {@code unchecked} violation, never a silent pass. A transition guard that quietly does nothing
	 * because nobody supplied the current state is exactly the "looks enforced, never fires" failure
	 * this whole item refuses elsewhere (see {@code RULE_TRANSITION_NOT_ENUM} in
	 * {@code rules/diagnostics.mjs}).
	 */
	public static List<Violation> checkTransitions(RuleOperation rules, JsonNode body, Map<String, String> currentStates) {
		List<Violation> violations = new ArrayList<>();
		if (rules == null || body == null || !body.isObject()) return violations;
		for (TransitionRule rule : rules.transition()) {
			JsonNode target = at(body, rule.pointer());
			if (target == null || !target.isTextual()) continue; // not changing this field
			if (currentStates == null || !currentStates.containsKey(rule.pointer())) {
				violations.add(violation(rule.id(), rule.pointer(), "unchecked",
					"a transition guard is declared but the current state was not supplied, so it could not be evaluated -- pass it via checkTransitions(..., currentStates)"));
				continue;
			}
			String from = currentStates.get(rule.pointer());
			String to = target.asText();
			if (from == null || from.equals(to)) continue; // no transition is occurring
			if (rule.from().contains(from) && rule.to().contains(to)) continue; // explicitly allowed
			violations.add(violation(rule.id(), rule.pointer(), "transition",
				"this state change is not permitted -- allowed transitions are from {" + String.join(", ", rule.from()) + "} to {" + String.join(", ", rule.to()) + "}"));
		}
		return violations;
	}

	private static Violation violation(String ruleId, String pointer, String kind, String message) {
		return new Violation(ruleId, pointer, kind, message);
	}
}
