  "mustCatch": [
    {
      "id": "M1",
      "category": "dynamic-route-factory",
      "construct": "Plugin produced by a factory function and registered with a prefix: app.register(crud('widgets'), { prefix: '/widgets' })",
      "counterexample": {
        "file": "src/app.js",
        "contains": "app.register(crud('widgets'), { prefix: '/widgets' })"
      },
      "truth": [
        {
          "scenario": "fastify-counterexample",
          "route": "GET /widgets",
          "exists": true
        },
        {
          "scenario": "fastify-counterexample",
          "route": "POST /widgets",
          "exists": true
        },
        {
          "scenario": "fastify-counterexample",
          "route": "GET /",
          "exists": false
        }
      ],
      "scannerShould": [
        "GET /widgets",
        "POST /widgets"
      ],
      "scannerEmitsInstead": [],
      "expected": "not-evaluated",
      "note": "Both factory routes are served under the registered prefix; a projector must emit them or leave the registration unknown."
    },
    {
      "id": "M2",
      "category": "middleware-auth",
      "construct": "Plugin-level auth hook: fastify.addHook('onRequest', ...) guarding every route of the plugin",
      "counterexample": {
        "file": "src/admin.js",
        "contains": "fastify.addHook('onRequest'"
      },
      "truth": [
        {
          "scenario": "fastify-counterexample",
          "route": "GET /admin/data",
          "auth": "token",
          "status": 200
        },
        {
          "scenario": "fastify-counterexample",
          "route": "GET /admin/data",
          "auth": "anon",
          "status": 401
        }
      ],
      "scannerShould": [
        "GET /admin/data"
      ],
      "scannerEmitsInstead": [],
      "expected": "not-evaluated",
      "note": "The hook makes the same route answer 401 without a token; an emitted route must not be read as an open route."
    },
    {
      "id": "M3",
      "category": "generated-routes",
      "construct": "Paths generated in a loop with a template literal: app.get(`/gen/${name}`, ...)",
      "counterexample": {
        "file": "src/app.js",
        "contains": "app.get(`/gen/${name}`"
      },
      "truth": [
        {
          "scenario": "fastify-counterexample",
          "route": "GET /gen/alpha",
          "exists": true
        },
        {
          "scenario": "fastify-counterexample",
          "route": "GET /gen/beta",
          "exists": true
        }
      ],
      "scannerShould": [
        "GET /gen/alpha",
        "GET /gen/beta"
      ],
      "scannerEmitsInstead": [],
      "expected": "not-evaluated",
      "note": "Both generated routes are served; a projector must leave them unknown rather than drop them."
    },
    {
      "id": "M4",
      "category": "deployment-prefix",
      "construct": "Plugin prefix decided at start-up by the environment: app.register(members, { prefix: base }) with base = process.env.API_BASE ?? '/svc'",
      "counterexample": {
        "file": "src/app.js",
        "contains": "app.register(members, { prefix: base })"
      },
      "truth": [
        {
          "scenario": "fastify-counterexample",
          "route": "GET /svc/ping",
          "exists": true
        },
        {
          "scenario": "fastify-counterexample",
          "route": "GET /ping",
          "exists": false
        },
        {
          "scenario": "fastify-counterexample-env-v2",
          "route": "GET /v2/ping",
          "exists": true
        },
        {
          "scenario": "fastify-counterexample-env-v2",
          "route": "GET /svc/ping",
          "exists": false
        }
      ],
      "scannerShould": [
        "GET /svc/ping"
      ],
      "scannerEmitsInstead": [],
      "expected": "not-evaluated",
      "note": "The prefix depends on API_BASE (/svc by default, /v2 when set), so unknown is the only honest answer; the plugin file alone would suggest GET /ping, which no deployment serves."
    },
    {
      "id": "M5",
      "category": "multi-method",
      "construct": "One route() call declaring several methods: app.route({ method: ['GET', 'POST'], url: '/multi', ... })",
      "counterexample": {
        "file": "src/app.js",
        "contains": "method: ['GET', 'POST']"
      },
      "truth": [
        {
          "scenario": "fastify-counterexample",
          "route": "GET /multi",
          "exists": true
        },
        {
          "scenario": "fastify-counterexample",
          "route": "POST /multi",
          "exists": true
        }
      ],
      "scannerShould": [
        "GET /multi",
        "POST /multi"
      ],
      "scannerEmitsInstead": [],
      "expected": "not-evaluated",
      "note": "Both methods are served by a single registration."
    },
    {
      "id": "M6",
      "category": "multi-method",
      "construct": "Method-agnostic registration: app.all('/any', ...)",
      "counterexample": {
        "file": "src/app.js",
        "contains": "app.all('/any'"
      },
      "truth": [
        {
          "scenario": "fastify-counterexample",
          "route": "GET /any",
          "exists": true
        },
        {
          "scenario": "fastify-counterexample",
          "route": "POST /any",
          "exists": true
        }
      ],
      "scannerShould": [
        "GET /any",
        "POST /any"
      ],
      "scannerEmitsInstead": [],
      "expected": "not-evaluated",
      "note": "Fastify's route tree lists GET, HEAD, TRACE, DELETE, OPTIONS, PATCH, PUT, POST and QUERY for it; a projector must not expand ANY into a guessed method list."
    },
    {
      "id": "M7",
      "category": "router-prefix-mount",
      "construct": "Nested plugin with its own prefix inside a prefixed plugin: fastify.register(reports, { prefix: '/v1' }) within register(admin, { prefix: '/admin' })",
      "counterexample": {
        "file": "src/admin.js",
        "contains": "fastify.register(reports, { prefix: '/v1' })"
      },
      "truth": [
        {
          "scenario": "fastify-counterexample",
          "route": "GET /admin/v1/reports",
          "exists": true
        },
        {
          "scenario": "fastify-counterexample",
          "route": "GET /reports",
          "exists": false
        }
      ],
      "scannerShould": [
        "GET /admin/v1/reports"
      ],
      "scannerEmitsInstead": [],
      "expected": "not-evaluated",
      "note": "The route is served only under the composed prefix of two registrations in two files."
    },
    {
      "id": "M8",
      "category": "config-driven",
      "construct": "Object-form route declaration: app.route({ method: 'GET', url: '/explicit', handler })",
      "counterexample": {
        "file": "src/app.js",
        "contains": "url: '/explicit'"
      },
      "truth": [
        {
          "scenario": "fastify-counterexample",
          "route": "GET /explicit",
          "exists": true
        }
      ],
      "scannerShould": [
        "GET /explicit"
      ],
      "scannerEmitsInstead": [],
      "expected": "not-evaluated",
      "note": "A literal route declared through the options object instead of a verb shortcut."
    }
  ],
