  "supported": [
    {
      "id": "S1",
      "construct": "Bare @Controller() with a literal verb decorator path: @Get('health')",
      "emits": [
        "GET /health"
      ]
    },
    {
      "id": "S2",
      "construct": "Literal @Controller('users') with bare @Get() and @Post() verb decorators",
      "emits": [
        "GET /users",
        "POST /users"
      ]
    },
    {
      "id": "S3",
      "construct": "Literal @Controller('users') with parameterised literal verb paths: @Get(':id'), @Delete(':id')",
      "emits": [
        "GET /users/:id",
        "DELETE /users/:id"
      ]
    }
  ],
  "unsupported": [
    {
      "id": "U1",
      "construct": "Controller class built by a factory function with a non-literal @Controller(path)",
      "reason": "A non-literal controller path is a profile unknown (NESTJS_CONTROLLER_PATH_UNKNOWN); a decorated class inside a function is not a top-level controller declaration.",
      "mustCatch": [
        "M1"
      ]
    },
    {
      "id": "U2",
      "construct": "Guards, interceptors and auth semantics (@UseGuards)",
      "reason": "Listed as an unknown condition of the profile; routes behind a guard are projected without the guard.",
      "mustCatch": [
        "M2"
      ]
    },
    {
      "id": "U3",
      "construct": "Non-literal decorator arguments (template literal with a substitution)",
      "reason": "Reported as NESTJS_METHOD_PATH_UNKNOWN and never emitted.",
      "mustCatch": [
        "M3"
      ]
    },
    {
      "id": "U4",
      "construct": "Global prefix and versioning (app.setGlobalPrefix)",
      "reason": "Listed as an unknown condition of the profile; the prefix lives in bootstrap code, not on the decorators the profile reads.",
      "mustCatch": [
        "M4"
      ]
    },
    {
      "id": "U5",
      "construct": "Module-level route prefix via RouterModule.register",
      "reason": "Not named in the profile's unknown conditions: a projector that reads decorators alone would place the controller at its unprefixed path.",
      "mustCatch": [
        "M5"
      ]
    },
    {
      "id": "U6",
      "construct": "DTO, request/response schemas, runtime metadata and synthesized operation identity",
      "reason": "Listed as unknown conditions of the profile and never modelled.",
      "mustCatch": []
    },
    {
      "id": "U7",
      "construct": "NestJS versions other than 12.0.1, non-Express platform adapters, other TypeScript versions",
      "reason": "Not installed and not run.",
      "mustCatch": []
    }
  ],
  "mustCatch": [
    {
      "id": "M1",
      "category": "dynamic-route-factory",
      "construct": "Controller class created by a function and registered in a module: controllers: [crudController('widgets')]",
      "counterexample": {
        "file": "src/app.module.ts",
        "contains": "crudController('widgets')"
      },
      "truth": [
        {
          "scenario": "nestjs-counterexample",
          "route": "GET /widgets",
          "exists": true
        },
        {
          "scenario": "nestjs-counterexample",
          "route": "POST /widgets",
          "exists": true
        },
        {
          "scenario": "nestjs-counterexample",
          "route": "GET /",
          "exists": false
        }
      ],
      "scannerShould": [
        "GET /widgets",
        "POST /widgets"
      ],
      "scannerEmitsInstead": [],
      "expected": "not-evaluated",
      "note": "Both factory routes are served; a projector must emit them or report the controller path as unknown."
    },
    {
      "id": "M2",
      "category": "middleware-auth",
      "construct": "Controller-level guard: @UseGuards(TokenGuard) over @Controller('secure')",
      "counterexample": {
        "file": "src/secure.controller.ts",
        "contains": "@UseGuards(TokenGuard)"
      },
      "truth": [
        {
          "scenario": "nestjs-counterexample",
          "route": "GET /secure/data",
          "auth": "token",
          "status": 200
        },
        {
          "scenario": "nestjs-counterexample",
          "route": "GET /secure/data",
          "auth": "anon",
          "status": 401
        }
      ],
      "scannerShould": [
        "GET /secure/data"
      ],
      "scannerEmitsInstead": [],
      "expected": "not-evaluated",
      "note": "The guard turns the same route into 401 without a token; an emitted route must not be read as an open route."
    },
    {
      "id": "M3",
      "category": "generated-routes",
      "construct": "Verb path built from a template literal with a substitution: @Get(`item/${KIND}`)",
      "counterexample": {
        "file": "src/generated.controller.ts",
        "contains": "@Get(`item/${KIND}`)"
      },
      "truth": [
        {
          "scenario": "nestjs-counterexample",
          "route": "GET /gen/item/alpha",
          "exists": true
        }
      ],
      "scannerShould": [
        "GET /gen/item/alpha"
      ],
      "scannerEmitsInstead": [],
      "expected": "not-evaluated",
      "note": "The route is served; a projector must report the non-literal argument as unknown instead of dropping the route."
    },
    {
      "id": "M4",
      "category": "deployment-prefix",
      "construct": "Global prefix decided at start-up by the environment: app.setGlobalPrefix(process.env.API_BASE ?? 'svc')",
      "counterexample": {
        "file": "src/main.ts",
        "contains": "app.setGlobalPrefix(process.env.API_BASE ?? 'svc')"
      },
      "truth": [
        {
          "scenario": "nestjs-counterexample",
          "route": "GET /open",
          "exists": true
        },
        {
          "scenario": "nestjs-counterexample",
          "route": "GET /svc/open",
          "exists": false
        },
        {
          "scenario": "nestjs-counterexample-prefixed",
          "route": "GET /svc/open",
          "exists": true
        },
        {
          "scenario": "nestjs-counterexample-prefixed",
          "route": "GET /open",
          "exists": false
        },
        {
          "scenario": "nestjs-counterexample-prefixed-env-v2",
          "route": "GET /v2/open",
          "exists": true
        },
        {
          "scenario": "nestjs-counterexample-prefixed-env-v2",
          "route": "GET /svc/open",
          "exists": false
        }
      ],
      "scannerShould": [
        "GET /svc/open"
      ],
      "scannerEmitsInstead": [],
      "expected": "not-evaluated",
      "note": "The same controller is served at /open without the call and at /svc/open or /v2/open with it, so the decorators alone cannot decide the path."
    },
    {
      "id": "M5",
      "category": "router-prefix-mount",
      "construct": "Module-level prefix: RouterModule.register([{ path: 'admin', module: AdminModule }])",
      "counterexample": {
        "file": "src/app.module.ts",
        "contains": "RouterModule.register([{ path: 'admin', module: AdminModule }])"
      },
      "truth": [
        {
          "scenario": "nestjs-counterexample",
          "route": "GET /admin/reports",
          "exists": true
        },
        {
          "scenario": "nestjs-counterexample",
          "route": "GET /reports",
          "exists": false
        }
      ],
      "scannerShould": [
        "GET /admin/reports"
      ],
      "scannerEmitsInstead": [],
      "expected": "not-evaluated",
      "note": "The controller declares only reports; it is served solely under the module prefix set in a different file."
    }
