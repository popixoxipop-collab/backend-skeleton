  "supported": [
    {
      "id": "S-GQL-SDL-DECLARATIONS",
      "statement": "SDL documents (.graphql, .gql, .graphqls) yield one record per type, interface, input, enum, union and scalar declaration, with kind, name, file and line.",
      "fixtures": [
        "gql-n01-sdl-explicit-roots",
        "gql-n02-sdl-implicit-roots"
      ]
    },
    {
      "id": "S-GQL-SDL-FIELDS",
      "statement": "Field declarations of object, interface and input types are recorded, with the type text kept verbatim on one line (it is not canonicalized).",
      "fixtures": [
        "gql-n01-sdl-explicit-roots",
        "gql-n02-sdl-implicit-roots",
        "gql-c13-type-text-not-canonicalized"
      ]
    },
    {
      "id": "S-GQL-SDL-ROOT-OPERATIONS",
      "statement": "Root operations come from an explicit schema definition (schema { query: X }) or from the implicit Query, Mutation and Subscription types; every root field is one operation record.",
      "fixtures": [
        "gql-n01-sdl-explicit-roots",
        "gql-n02-sdl-implicit-roots",
        "gql-c03b-schema-definition-without-directive"
      ]
    },
    {
      "id": "S-GQL-COMMENTS-MASKED",
      "statement": "Line comments, block strings and single-line description strings are masked before declarations are read, so declarations written inside them are not recorded.",
      "fixtures": [
        "gql-n03-sdl-comments-and-strings-masked"
      ]
    },
    {
      "id": "S-GQL-INTROSPECTION",
      "statement": "Introspection JSON, either {\"data\":{\"__schema\":...}} or {\"__schema\":...}, yields type, field and root-operation records including field arguments with default values; the introspection kind names (object, input_object) are kept as they are.",
      "fixtures": [
        "gql-n04-introspection-data-wrapper",
        "gql-n05-introspection-bare-schema",
        "gql-c07b-introspection-arguments-kept"
      ]
    },
    {
      "id": "S-GQL-BLOCKED-ON-NO-DECLARATIONS",
      "statement": "A document without any type declaration (empty, comment-only, or executable operations only) is blocked with GRAPHQL_TYPES_NOT_FOUND and cannot produce a protocol contract; introspection input that is not valid JSON or has no __schema raises an error.",
      "fixtures": [
        "gql-x01-empty-document",
        "gql-x02-comment-only-document",
        "gql-x04-introspection-without-schema",
        "gql-x05-introspection-invalid-json",
        "gql-x06-executable-operation-document"
      ]
    }
  ],
  "unsupported": [
    {
      "id": "U-GQL-SPEC-EDITION",
      "behavior": "not-detected",
      "statement": "No GraphQL specification edition is detected, enforced or recorded: SDL carries no edition, the importer implements no edition grammar, and edition-dependent syntax (@oneOf: the token oneOf occurs 0 times in the October 2021 Type System section and 10 times in the September 2025 one) is ignored like any other directive. The edition pinned in SCOPE.json is the reference for these claims, not an importer property.",
      "fixtures": [
        "gql-c11-oneof-input-edition-dependent",
        "gql-n01-sdl-explicit-roots"
      ]
    },
    {
      "id": "U-GQL-DIRECTIVES",
      "behavior": "dropped",
      "statement": "Directive definitions and usages are not recorded: adding or removing them leaves the contract unchanged, and a directive written on the schema definition hides its root operations.",
      "fixtures": [
        "gql-c02-directives-not-recorded",
        "gql-c02b-directives-stripped",
        "gql-c03-schema-definition-with-directive",
        "gql-c03b-schema-definition-without-directive",
        "gql-c01-federation-subgraph"
      ]
    },
    {
      "id": "U-GQL-FEDERATION",
      "behavior": "dropped",
      "statement": "No federation semantics: @key, @link, @shareable, entity resolution, the _entities and _service fields and Federation 1 extend type are read as plain declarations; nothing marks a subgraph, an entity or a key.",
      "fixtures": [
        "gql-c01-federation-subgraph",
        "gql-c01b-federation-v1-extend-type"
      ]
    },
    {
      "id": "U-GQL-TYPE-EXTENSIONS",
      "behavior": "misread",
      "statement": "extend type is recorded as a second, plain type declaration; it is indistinguishable from a duplicate definition and is not merged into the extended type.",
      "fixtures": [
        "gql-c06-extend-type",
        "gql-c09c-duplicate-type-definition"
      ]
    },
    {
      "id": "U-GQL-SDL-ARGUMENTS",
      "behavior": "dropped",
      "statement": "Field arguments and their default values are not recorded for SDL input (they are for introspection input), so operation signatures from SDL carry no arguments.",
      "fixtures": [
        "gql-c07-sdl-arguments-dropped",
        "gql-c07c-sdl-arguments-removed",
        "gql-c07b-introspection-arguments-kept"
      ]
    },
    {
      "id": "U-GQL-TYPE-RELATIONS",
      "behavior": "dropped",
      "statement": "implements clauses, union member lists and enum values are not recorded.",
      "fixtures": [
        "gql-c12-implements-union-enum-members",
        "gql-c12b-members-replaced"
      ]
    },
    {
      "id": "U-GQL-MULTILINE-DECLARATIONS",
      "behavior": "misread",
      "statement": "The scanner is line oriented: a declaration whose opening brace is not on the declaration line is recorded without fields and operations, and nested list types are truncated (the field type [[Int]] is read as [[Int]).",
      "fixtures": [
        "gql-c04-brace-on-next-line",
        "gql-c04b-brace-on-same-line",
        "gql-c05-nested-list-type",
        "gql-c05b-single-list-type"
      ]
    },
    {
      "id": "U-GQL-SCHEMA-VALIDATION",
      "behavior": "accepted",
      "statement": "No schema validation: undefined type references, duplicate type definitions, two schema definitions and an interface used as the query root are accepted without a warning.",
      "fixtures": [
        "gql-c09a-two-schema-definitions",
        "gql-c09b-undefined-type-reference",
        "gql-c09c-duplicate-type-definition",
        "gql-c10-interface-named-as-root"
      ]
    },
    {
      "id": "U-GQL-RESOLVERS",
      "behavior": "rejected",
      "statement": "Resolver source code is not an input: a JavaScript resolver module is rejected as an undecodable document, and no resolver wiring or resolver behaviour is extracted from anywhere.",
      "fixtures": [
        "gql-x03-resolver-source-is-not-an-input"
      ]
    },
    {
      "id": "U-GQL-EXECUTABLE-DOCUMENTS",
      "behavior": "blocked",
      "statement": "Executable documents (operations and fragments) are not schema inputs; they are blocked like an empty document.",
      "fixtures": [
        "gql-x06-executable-operation-document"
      ]
    }
  ],
