  "supported": [
    {
      "id": "S-AAPI-VERSION-PATTERN",
      "statement": "An asyncapi value that is a string matching ^(?:2|3)\\.\\d+\\.\\d+$ selects the dialect asyncapi-<value> without a warning. Every version the official parser 3.6.3 accepts (2.0.0 to 2.6.0, 3.0.0, 3.1.0) is covered; the pattern also admits versions the parser rejects.",
      "fixtures": [
        "aapi-v-supported-2.0.0",
        "aapi-v-supported-2.1.0",
        "aapi-v-supported-2.2.0",
        "aapi-v-supported-2.3.0",
        "aapi-v-supported-2.4.0",
        "aapi-v-supported-2.5.0",
        "aapi-v-supported-2.6.0",
        "aapi-v-supported-3.0.0",
        "aapi-v-supported-3.1.0",
        "aapi-v-silent-2.6.1",
        "aapi-v-silent-3.0.1",
        "aapi-v-silent-3.9.9"
      ]
    },
    {
      "id": "S-AAPI-VERSION-WARNINGS",
      "statement": "A string that does not match the pattern yields ASYNCAPI_VERSION_UNTESTED (dialect asyncapi-<value>); an absent, empty or non-string value yields ASYNCAPI_VERSION_MISSING (dialect asyncapi-unknown). Neither warning blocks the scan.",
      "fixtures": [
        "aapi-v-untested-4.0.0",
        "aapi-v-untested-1.2.0",
        "aapi-v-untested-3.0.0-rc1",
        "aapi-v-untested-v3.0.0",
        "aapi-v-untested-quoted-3.0",
        "aapi-v-missing-key",
        "aapi-v-missing-numeric-3",
        "aapi-v-missing-empty-string",
        "aapi-v-missing-unquoted-3.0"
      ]
    },
    {
      "id": "S-AAPI-V2-CHANNELS",
      "statement": "AsyncAPI 2.x channels with publish and subscribe operations (operationId, message references) and components.messages are recorded as channel, operation and message records.",
      "fixtures": [
        "aapi-n01-v2.6.0-publish-subscribe"
      ]
    },
    {
      "id": "S-AAPI-V3-OPERATIONS",
      "statement": "AsyncAPI 3.x channels (address), operations (action send or receive, channel reference, message references) and components.messages are recorded as channel, operation and message records.",
      "fixtures": [
        "aapi-n02-v3.0.0-operations",
        "aapi-n03-v3.1.0-operations"
      ]
    },
    {
      "id": "S-AAPI-SERIALIZATION-INDEPENDENT",
      "statement": "YAML and JSON spellings of the same document produce the same contract planes.",
      "fixtures": [
        "aapi-n02-v3.0.0-operations",
        "aapi-n04-v3.0.0-json-serialization"
      ]
    },
    {
      "id": "S-AAPI-BLOCKED-AND-ERRORS",
      "statement": "A document with neither version nor channels, or with a version but no channels, is blocked and cannot produce a protocol contract; a remote $ref, a non-object document and undecodable YAML raise errors.",
      "fixtures": [
        "aapi-x01-empty-object",
        "aapi-x02-version-only",
        "aapi-x03-remote-ref-denied",
        "aapi-x04-top-level-array",
        "aapi-x05-invalid-yaml",
        "aapi-x06-scalar-document"
      ]
    }
  ],
  "unsupported": [
    {
      "id": "U-AAPI-BINDINGS",
      "behavior": "dropped",
      "statement": "Server, channel, operation and message bindings (mqtt qos and retain, kafka topic, partitions, group and key, amqp ack and deliveryMode, bindingVersion) are not recorded: documents that differ only in bindings produce identical contract planes.",
      "fixtures": [
        "aapi-c00-control-minimal-send",
        "aapi-c01-mqtt-qos-2",
        "aapi-c01b-mqtt-qos-0",
        "aapi-c02-kafka-amqp-bindings"
      ]
    },
    {
      "id": "U-AAPI-SERVERS",
      "behavior": "dropped",
      "statement": "servers (host, protocol, protocolVersion) are not recorded, so broker identity and broker version are unknown for every scanned document.",
      "fixtures": [
        "aapi-c00-control-minimal-send",
        "aapi-c04-servers-broker-identity"
      ]
    },
    {
      "id": "U-AAPI-REPLY-CORRELATION",
      "behavior": "dropped",
      "statement": "Operation reply (request-reply) and message correlationId are not recorded.",
      "fixtures": [
        "aapi-c00-control-minimal-send",
        "aapi-c03-reply-and-correlation-id"
      ]
    },
    {
      "id": "U-AAPI-RETRY-IDEMPOTENCY-DELIVERY",
      "behavior": "dropped",
      "statement": "No retry, idempotency or delivery-guarantee semantics. AsyncAPI documents carry them only in bindings, extensions and message headers (x-retry, x-idempotency-key, x-delivery, an idempotency header); none is recorded. At the flow layer retry, idempotency and timeout are caller declarations that nothing ties to the document, and delivery, qos, ack and redelivery step fields are silently dropped.",
      "fixtures": [
        "aapi-c10-retry-idempotency-delivery-declared",
        "aapi-c00-control-minimal-send",
        "aapi-c01-mqtt-qos-2",
        "aapi-f01-retry-idempotency-timeout-declared",
        "aapi-f02-delivery-qos-ack-dropped",
        "aapi-f03-retry-declared-on-receive-operation",
        "aapi-f04-send-then-receive-ordering",
        "aapi-f05-retry-max-attempts-zero-rejected",
        "aapi-f06-idempotency-empty-key-rejected",
        "aapi-f07-action-from-other-contract-rejected"
      ]
    },
    {
      "id": "U-AAPI-CHANNEL-LEVEL-MESSAGES",
      "behavior": "dropped",
      "statement": "Only components.messages become message records; messages declared inline under a channel produce no message record.",
      "fixtures": [
        "aapi-c05-channel-level-messages-only"
      ]
    },
    {
      "id": "U-AAPI-ONEOF-MESSAGES",
      "behavior": "dropped",
      "statement": "A message oneOf list on an operation yields no message references.",
      "fixtures": [
        "aapi-c06-oneof-messages"
      ]
    },
    {
      "id": "U-AAPI-EXTERNAL-REFS",
      "behavior": "flagged",
      "statement": "Relative-file $ref values are not resolved: the referencing channel is recorded as null and each reference raises ASYNCAPI_EXTERNAL_REF_UNRESOLVED; remote $ref values are refused with an error.",
      "fixtures": [
        "aapi-c07-relative-file-ref",
        "aapi-x03-remote-ref-denied"
      ]
    },
    {
      "id": "U-AAPI-SCHEMA-VALIDATION",
      "behavior": "accepted",
      "statement": "The document is not validated against any AsyncAPI JSON Schema: 2.x and 3.x constructs in one document are both read, a missing info object is accepted, and the versions 2.6.1, 3.0.1 and 3.9.9, which the official parser rejects, are accepted without a warning (the specification repository has no tag for 2.6.1 and 3.9.9, and its release for tag v3.0.1 is titled \"v3.0.1 - INVALID\").",
      "fixtures": [
        "aapi-c08-mixed-2x-and-3x-constructs",
        "aapi-c09-missing-required-info",
        "aapi-v-silent-2.6.1",
        "aapi-v-silent-3.0.1",
        "aapi-v-silent-3.9.9"
      ]
    }
  ],
