  "supported": [
    {
      "id": "S-WS-MANIFEST-RECORDS",
      "statement": "A JSON or YAML manifest (dialect bskel-websocket-manifest/<version>, default 1) with connections (id, endpoint, subprotocols) and messages (connection_id, name, direction, schema_ref, correlation_field) is recorded as connection and message records.",
      "fixtures": [
        "ws-n01-json-manifest",
        "ws-n02-yaml-manifest",
        "ws-n03-connection-only",
        "ws-n04-message-without-connection"
      ]
    },
    {
      "id": "S-WS-SERIALIZATION-ORDER-INDEPENDENT",
      "statement": "JSON and YAML spellings of one manifest give the same records, and the order of manifest arrays does not change the contract planes.",
      "fixtures": [
        "ws-n01-json-manifest",
        "ws-n02-yaml-manifest"
      ]
    },
    {
      "id": "S-WS-DIRECTION-VOCABULARY",
      "statement": "The direction values client-to-server, server-to-client and bidirectional are recorded; any other value raises a warning and the message is skipped.",
      "fixtures": [
        "ws-n01-json-manifest",
        "ws-c05a-unsupported-direction-skipped",
        "ws-c05b-only-unsupported-direction",
        "ws-c05c-direction-control"
      ]
    },
    {
      "id": "S-WS-BLOCKED-AND-ERRORS",
      "statement": "A manifest without connections and messages is blocked and cannot produce a protocol contract; non-object documents, invalid JSON and remote $ref values raise errors.",
      "fixtures": [
        "ws-x01-empty-object",
        "ws-x02-top-level-array",
        "ws-x03-invalid-json",
        "ws-x04-remote-ref-denied",
        "ws-x05-scalar-document"
      ]
    }
  ],
  "unsupported": [
    {
      "id": "U-WS-MANIFEST-ONLY",
      "behavior": "not-discovered",
      "statement": "Messages and connections exist only when a manifest declares them: WebSocket usage in source code, frames, close events or traffic is never discovered, and a JavaScript source file is not an input.",
      "fixtures": [
        "ws-c08-source-code-not-discovered",
        "ws-n04-message-without-connection",
        "ws-x01-empty-object"
      ]
    },
    {
      "id": "U-WS-STATE-MACHINE",
      "behavior": "dropped",
      "statement": "No connection state machine (connecting, open, closing, closed), close codes, heartbeat or reconnect model: manifest keys for them are ignored, and the flow layer does not require a connection step before a message step or check message direction against step order.",
      "fixtures": [
        "ws-c01-lifecycle-keys-ignored",
        "ws-c01b-lifecycle-keys-absent",
        "ws-f01-connect-then-subscribe-ordering",
        "ws-f02-message-step-without-connection-step",
        "ws-f03-server-push-ordered-before-request",
        "ws-f05-lifecycle-fields-dropped",
        "ws-f07-ordering-cycle-rejected"
      ]
    },
    {
      "id": "U-WS-RETRY-IDEMPOTENCY",
      "behavior": "dropped",
      "statement": "Retry, reconnect and idempotency are caller declarations on flow steps with no tie to the manifest: manifest-level retry and idempotency keys are ignored, a retry is accepted on a server push, and ack, state and close-code step fields are silently dropped.",
      "fixtures": [
        "ws-c01-lifecycle-keys-ignored",
        "ws-c01b-lifecycle-keys-absent",
        "ws-f04-retry-and-idempotency-on-server-push",
        "ws-f05-lifecycle-fields-dropped",
        "ws-f06-reconnect-retry-on-connection-step",
        "ws-f08-backoff-negative-rejected"
      ]
    },
    {
      "id": "U-WS-ENDPOINT-VALIDATION",
      "behavior": "accepted",
      "statement": "The endpoint is a free string: the RFC 6455 section 3 rules (ws or wss scheme, absolute URI, no fragment) are not checked.",
      "fixtures": [
        "ws-c02a-endpoint-http-scheme",
        "ws-c02b-endpoint-fragment",
        "ws-c02c-endpoint-relative",
        "ws-c02d-endpoint-empty-string"
      ]
    },
    {
      "id": "U-WS-VERSION-NOT-VALIDATED",
      "behavior": "accepted",
      "statement": "The manifest version is not validated: any truthy value selects the dialect bskel-websocket-manifest/<value>, while a falsy value (0) or no version selects bskel-websocket-manifest/1. It is unrelated to the RFC 6455 protocol version 13.",
      "fixtures": [
        "ws-c03a-version-999",
        "ws-c03b-version-zero",
        "ws-c03c-version-absent"
      ]
    },
    {
      "id": "U-WS-SUBPROTOCOL-RULES",
      "behavior": "accepted",
      "statement": "Subprotocols are stringified and sorted; RFC 6455 section 4.1 rules (non-empty token strings, no duplicates, order of preference) are not checked, and the declared preference order is lost.",
      "fixtures": [
        "ws-c10-subprotocol-order-and-uniqueness",
        "ws-n01-json-manifest"
      ]
    },
    {
      "id": "U-WS-DIRECTION-DEFAULT",
      "behavior": "defaulted",
      "statement": "A message without a direction is recorded as bidirectional; the manifest schema marks direction optional and does not name a default.",
      "fixtures": [
        "ws-c04-direction-defaults-to-bidirectional"
      ]
    },
    {
      "id": "U-WS-MANIFEST-SCHEMA-NOT-ENFORCED",
      "behavior": "accepted",
      "statement": "websocket-manifest.schema.json is not applied by the loader or the importer: manifests the schema rejects (unknown keys, non-string or duplicate subprotocols, wrong types, an unknown direction) are still imported.",
      "fixtures": [
        "ws-c01-lifecycle-keys-ignored",
        "ws-c05a-unsupported-direction-skipped",
        "ws-c09-malformed-entries-skipped-silently",
        "ws-c10-subprotocol-order-and-uniqueness"
      ]
    },
    {
      "id": "U-WS-DIAGNOSTICS",
      "behavior": "misleading",
      "statement": "An unresolved connection reference or a duplicate connection id blocks the scan with the misleading warning WEBSOCKET_MANIFEST_EMPTY, and malformed entries are skipped without any warning.",
      "fixtures": [
        "ws-c06-unresolved-connection",
        "ws-c07-duplicate-connection-id",
        "ws-c09-malformed-entries-skipped-silently"
      ]
    },
    {
      "id": "U-WS-RFC6455-WIRE",
      "behavior": "not-modeled",
      "statement": "No RFC 6455 wire behaviour is modeled: opening handshake, frame format, opcodes, masking, fragmentation, ping and pong, the closing handshake and extensions. Manifest keys that name them (opcode, close_codes) are ignored.",
      "fixtures": [
        "ws-c01-lifecycle-keys-ignored",
        "ws-c08-source-code-not-discovered"
      ]
    }
  ],
