{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbf:protocol-oracle-request:1",
  "title": "T18 shadow protocol runtime-oracle request",
  "description": "Request packet only; validation does not constitute runtime evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sbf_protocol_oracle_request",
    "feature_id",
    "feature_uid",
    "scenario_id",
    "protocol_contract_refs",
    "flow_contract_ref",
    "original_ref",
    "candidate_ref",
    "runtime_profile_ref",
    "seed",
    "assertions",
    "semantics"
  ],
  "properties": {
    "sbf_protocol_oracle_request": {
      "const": "1"
    },
    "feature_id": {
      "type": "string",
      "minLength": 1
    },
    "feature_uid": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_contract_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/artifactRef"
          },
          {
            "properties": {
              "family": {
                "const": "protocol-contract"
              },
              "version": {
                "const": "1"
              }
            }
          }
        ]
      }
    },
    "flow_contract_ref": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/artifactRef"
        }
      ]
    },
    "original_ref": {
      "$ref": "#/$defs/artifactRef"
    },
    "candidate_ref": {
      "$ref": "#/$defs/artifactRef"
    },
    "runtime_profile_ref": {
      "$ref": "#/$defs/artifactRef"
    },
    "seed": {
      "type": [
        "string",
        "null"
      ]
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "action_ref",
          "expect"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "grpc-status",
              "graphql-result",
              "message-observed",
              "state",
              "correlation",
              "idempotency",
              "timeout"
            ]
          },
          "action_ref": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "urn:sbf:protocol-item-ref:draft-1"
              }
            ]
          },
          "expect": {}
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_is_not_runtime_evidence",
        "ordering_does_not_imply_causation",
        "correlation_does_not_imply_causation",
        "executor_must_rehash_referenced_bytes",
        "executor_must_verify_protocol_item_existence"
      ],
      "properties": {
        "request_is_not_runtime_evidence": {
          "const": true
        },
        "ordering_does_not_imply_causation": {
          "const": true
        },
        "correlation_does_not_imply_causation": {
          "const": true
        },
        "executor_must_rehash_referenced_bytes": {
          "const": true
        },
        "executor_must_verify_protocol_item_existence": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_ref",
        "family",
        "version",
        "media_type",
        "byte_sha256",
        "size_bytes"
      ],
      "properties": {
        "artifact_ref": {
          "const": "sbf.artifact-ref/1"
        },
        "family": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "pattern": "^[^\\s/]+/[^\\s]+$"
        },
        "byte_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
