{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbf:websocket-manifest:draft-1",
  "title": "T18 explicit WebSocket message manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": [
        "string",
        "number"
      ]
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "endpoint": {
            "type": [
              "string",
              "null"
            ]
          },
          "subprotocols": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "connection_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "client-to-server",
              "server-to-client",
              "bidirectional"
            ]
          },
          "schema_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "correlation_field": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
