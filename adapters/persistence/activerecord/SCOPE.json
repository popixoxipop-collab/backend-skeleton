  "evidence_plan": {
    "ORM-activerecord-02": {
      "goal": "Make the provider report what this record lists as planned instead of omitting or misreporting it: columns from db/schema.rb, literal-only table names (an interpolated name must become an unknown, not a wrong value), composite primary keys, conventional belongs_to and column and table changes between versions; inflected table names stay unknown unless inflection is implemented and checked against the oracle.",
      "constructs": [
        "columns-beyond-keys",
        "inflected-table-name",
        "interpolated-table-name",
        "composite-primary-key",
        "belongs-to-by-convention",
        "schema-version-change"
      ],
      "depends_on": [
        "ORM-activerecord-01",
        "T10-02"
      ],
      "blocked_by": [],
      "exit_criteria": [
        "Each construct planned in this step matches the recorded oracle or is reported as unknown or as a diagnostic; none is omitted silently or reported with a wrong value.",
        "test/persistence-next/dyn-orm-scope.test.mjs recomputes the provider output from the committed fixtures and passes with those constructs promoted from planned.",
        "The oracle results are re-recorded for activerecord 8.1.4 on sqlite3 2.9.6 and are unchanged."
      ],
      "evidence_level_after": "oracle-compared",
      "runtime_note": "The step stays offline: no server database and no application run, so runtime-tested is not claimed."
    },
    "ORM-activerecord-03": {
      "goal": "Cross-check the provider against a live PostgreSQL database and the migration plane (db/migrate classes for the fixtures), then issue a limited certification for the pinned versions and profile only.",
      "constructs": [
        "live-database-drift"
      ],
      "depends_on": [
        "ORM-activerecord-02"
      ],
      "blocked_by": [
        "live-database"
      ],
      "exit_criteria": [
        "A PostgreSQL service is provisioned and the models are compared with its introspected schema.",
        "A migration written for the fixtures is probed against the migration scanner.",
        "The certification names the exact pinned versions and profile and nothing broader."
      ],
      "evidence_level_after": "oracle-compared",
      "runtime_note": "Runtime-tested may be claimed only for the checks this step actually runs against the database."
    }
