        "relation-convention",
        "tenant-scope"
      ],
      "planned_in": "ORM-activerecord-02"
    },
    {
      "id": "inflected-table-name",
      "category": "naming-strategy",
      "construct": "model without self.table_name",
      "orm_behavior": "ActiveRecord inflects the class name into the table name (Hero becomes heros, OrderItem becomes order_items); the provider deliberately does not reimplement inflection, so it reports the table as unknown (active-record-table-unknown, active-record-primary-key-unknown) and emits nothing for the model.",
      "support": "unsupported",
      "implementation": "planned",
      "gap_behavior": "ir-unknown",
      "facets": [
        "tables",
        "columns",
        "primary_keys"
      ],
      "cases": [
        "naming-default"
      ],
      "planned_in": "ORM-activerecord-02"
    },
    {
      "id": "interpolated-table-name",
      "category": "naming-strategy",
      "construct": "self.table_name = \"#{TABLE_PREFIX}heroes\"",
      "orm_behavior": "The table is acme_heroes once the string is evaluated; the provider accepts any double-quoted string without evaluating the interpolation and reports the table literally as #{TABLE_PREFIX}heroes, so the name it reports is wrong and the primary key and column are attached to that wrong name.",
      "support": "unsupported",
      "implementation": "planned",
      "gap_behavior": "wrong-value",
      "facets": [
        "tables",
        "columns",
        "primary_keys"
      ],
      "cases": [
        "naming-custom"
      ],
      "planned_in": "ORM-activerecord-02"
    },
    {
      "id": "composite-primary-key",
      "category": "composite-key",
      "construct": "self.primary_key = [:team_id, :hero_id] over a table created with primary_key: [\"team_id\", \"hero_id\"]",
      "orm_behavior": "ActiveRecord reports the primary key hero_team_links(team_id,hero_id); the provider accepts a string or symbol key only, so it reports the primary key as unknown (active-record-primary-key-unknown) and emits the table without key and without columns.",
      "support": "unsupported",
      "implementation": "planned",
      "gap_behavior": "ir-unknown",
      "facets": [
