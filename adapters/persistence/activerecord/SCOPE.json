    {
      "id": "columns-beyond-keys",
      "category": "baseline",
      "construct": "columns other than the primary key and literal belongs_to foreign keys",
      "orm_behavior": "Every column of the table (heroes.name, heroes.secret_name, invoices.tenant_id) comes from the database schema, which the model class does not list; the provider reads model source only, emits the primary key and literal foreign key columns and never reads db/schema.rb, so the other columns are missing without a diagnostic.",
      "support": "unsupported",
      "implementation": "planned",
      "gap_behavior": "silent-omission",
      "facets": [
        "columns"
      ],
      "cases": [
        "normal",
