    "CREATE TABLE IF NOT EXISTS \"posts\" (\"id\" INTEGER , PRIMARY KEY (\"id\"));",
    "CREATE TABLE IF NOT EXISTS \"tags\" (\"id\" INTEGER , PRIMARY KEY (\"id\"));",
    "CREATE TABLE IF NOT EXISTS \"PostTags\" (\"createdAt\" TIMESTAMP WITH TIME ZONE NOT NULL, \"updatedAt\" TIMESTAMP WITH TIME ZONE NOT NULL, \"PostId\" INTEGER  REFERENCES \"posts\" (\"id\") ON DELETE CASCADE ON UPDATE CASCADE, \"TagId\" INTEGER  REFERENCES \"tags\" (\"id\") ON DELETE CASCADE ON UPDATE CASCADE, PRIMARY KEY (\"PostId\",\"TagId\"));"
