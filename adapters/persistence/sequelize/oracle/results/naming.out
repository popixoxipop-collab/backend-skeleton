  "sql": [
    "CREATE TABLE IF NOT EXISTS \"UserAccounts\" (\"id\"   SERIAL , \"displayName\" VARCHAR(255), \"createdAt\" TIMESTAMP WITH TIME ZONE NOT NULL, \"updatedAt\" TIMESTAMP WITH TIME ZONE NOT NULL, PRIMARY KEY (\"id\"));",
    "CREATE TABLE IF NOT EXISTS \"snake_case_models\" (\"id\"   SERIAL , \"display_name\" VARCHAR(255), \"created_at\" TIMESTAMP WITH TIME ZONE NOT NULL, \"updated_at\" TIMESTAMP WITH TIME ZONE NOT NULL, \"user_account_id\" INTEGER REFERENCES \"UserAccounts\" (\"id\") ON DELETE SET NULL ON UPDATE CASCADE, PRIMARY KEY (\"id\"));"
