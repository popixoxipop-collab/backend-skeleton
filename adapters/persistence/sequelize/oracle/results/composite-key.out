  "sql": [
    "CREATE TABLE IF NOT EXISTS \"tenants\" (\"tenant_pk\" VARCHAR(255) , PRIMARY KEY (\"tenant_pk\"));",
    "CREATE TABLE IF NOT EXISTS \"users\" (\"user_pk\" VARCHAR(255) , PRIMARY KEY (\"user_pk\"));",
    "CREATE TABLE IF NOT EXISTS \"tenant_users\" (\"user_id\" VARCHAR(255)  REFERENCES \"users\" (\"user_pk\"), \"tenant_id\" VARCHAR(255)  REFERENCES \"tenants\" (\"tenant_pk\"), PRIMARY KEY (\"user_id\",\"tenant_id\"));"
  ]
