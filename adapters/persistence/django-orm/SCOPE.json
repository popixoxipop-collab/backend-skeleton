    {
      "id": "implicit-app-label-table-name",
      "category": "naming-strategy",
      "construct": "model without Meta.db_table",
      "orm_behavior": "Django names the table <app label>_<lower-cased class> (shop_hero, shop_orderitem); the app label comes from the app configuration, which the provider does not read, so it reports the table as unknown (django-table-unknown) and emits no columns or keys for it.",
      "support": "unsupported",
