	"probes": {
		"migration_plane": {
			"basis": "oracle-output",
			"claim": "drizzle-kit writes numbered .sql files into its out directory, a layout the repository migration scanner does not read: it reports no tool. The file content is the recorded oracle output of the normal case, and the same SQL in a Flyway layout is detected, so an empty result is not a scanner that finds nothing.",
			"layout": [
				{
					"from": "oracle/results/normal.out",
					"to": "drizzle/0000_init.sql"
				}
