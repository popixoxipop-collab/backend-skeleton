{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbf-internal:game-native-export-envelope:draft-1",
  "title": "T17 internal native engine export envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "envelope_revision", "status", "engine", "evidence_class", "engine_version", "platform", "producer", "artifact", "payload_descriptor", "claims"],
  "properties": {
    "schema": { "const": "sbf.game-native-export-envelope/draft-1" },
    "envelope_revision": { "const": 1 },
    "status": { "const": "bound-uninterpreted" },
    "engine": { "enum": ["unreal", "unity", "godot"] },
    "evidence_class": { "enum": ["source-export", "editor-export", "headless-export"] },
    "engine_version": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "implementation_sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "implementation_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_ref", "family", "version", "media_type", "byte_sha256", "size_bytes"],
      "properties": {
        "artifact_ref": { "const": "sbf.artifact-ref/1" },
        "family": { "const": "game-native-export" },
        "version": { "const": "draft-1" },
        "media_type": { "const": "application/json" },
        "byte_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "payload_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_schema", "top_level_keys"],
      "properties": {
        "declared_schema": { "type": ["string", "null"] },
        "top_level_keys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_behavior_verified", "causal_edges_verified", "state_transitions_verified"],
      "properties": {
        "runtime_behavior_verified": { "const": false },
        "causal_edges_verified": { "const": false },
        "state_transitions_verified": { "const": false }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "engine": { "const": "godot" } } },
      "then": { "properties": { "evidence_class": { "enum": ["source-export", "headless-export"] } } }
    },
    {
      "if": { "properties": { "engine": { "enum": ["unreal", "unity"] } } },
      "then": { "properties": { "evidence_class": { "enum": ["source-export", "editor-export"] } } }
    }
  ]
}
