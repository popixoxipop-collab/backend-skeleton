{
  "schema": "bskel.http-target-scope/1",
  "item": "HTTP-javascript-express-01",
  "target": "HTTP-javascript-express",
  "track": "T11",
  "recordDate": "2026-10-09",
  "claim": {
    "registrationAloneIsSupport": false,
    "published": "scoped-community-sample",
    "scope": "Express 4 route registration in javascript read by a regex/ripgrep adapter: verb calls with a single literal path, resolved through literal app.use/router.use mounts over imported routers. Published only as a community-sample adapter (specificity 80) without api.operations or api.request-shape; registering the adapter does not make any construct outside supported[] supported.",
    "registration": {
      "adapterId": "javascript-express",
      "contract": "sbf.adapter/2",
      "specificity": 80,
      "verificationBasis": "community-sample",
      "capabilities": {
        "api.operations": false,
        "api.request-shape": false,
        "resource.fetch": false,
        "codegen.handles": false
      }
    },
    "runtimeTested": {
      "frameworkOracleRun": true,
      "scannerVsRuntimeCompared": true,
      "scope": "express 4.22.3 served the committed javascript normal and counterexample fixtures (TypeScript compiled with typescript 5.9.3) on Node v24.19.0, darwin-arm64; the live scanner output was compared route by route with the served status codes.",
      "notRun": [
        "Express 5.x",
        "Express 4.x versions other than 4.22.3",
        "Node 22 for the oracle run (oracle ran on v24.19.0 only)",
        "the real-world repositories pinned in test/fixtures/oracle-manifest.json (not re-run by this record)",
        "authentication enforcement (the scanner emits no auth field)"
      ]
    }
  },
  "scanner": {
    "runner": "javascript-express",
    "module": "scanners/adapters/javascript-express.mjs",
    "emitsUnknownMarkers": false
  },
  "supported": [
    {
      "id": "S1",
      "construct": "Verb call with an inline handler on a router created in app.js and mounted by app.use with a literal prefix (app.use('/api', route))",
      "emits": [
        "GET /api/ping"
      ]
    },
    {
      "id": "S2",
      "construct": "GET calls with literal and parameterised paths on ESM default-imported child routers mounted with literal router.use('/user'|'/order') prefixes below the app prefix",
      "emits": [
        "GET /api/order/search",
        "GET /api/order/:orderId",
        "GET /api/user/list",
        "GET /api/user/:userUid"
      ]
    },
    {
      "id": "S3",
      "construct": "Non-GET verb (PATCH) on a parameterised path of a mounted child router",
      "emits": [
        "PATCH /api/user/:userUid"
      ]
    }
  ],
  "unsupported": [
    {
      "id": "U1",
      "construct": "Routers built by a function call (router factories) and mounted",
      "reason": "Imports are followed, call results are not; inner routes are emitted at the factory's own root.",
      "mustCatch": [
        "M1"
      ]
    },
    {
      "id": "U2",
      "construct": "Authentication and authorization semantics (router.use(middleware), route-level middleware)",
      "reason": "Routes behind middleware are emitted, the middleware is not modelled and no unknown marker is attached.",
      "mustCatch": [
        "M2"
      ]
    },
    {
      "id": "U3",
      "construct": "Programmatically generated paths (loops, template literals)",
      "reason": "Only literal first arguments of verb calls are read.",
      "mustCatch": [
        "M3"
      ]
    },
    {
      "id": "U4",
      "construct": "Mount prefixes decided at run time (environment or configuration)",
      "reason": "The mount argument must be a string literal; otherwise the router's own paths are emitted unprefixed.",
      "mustCatch": [
        "M4"
      ]
    },
    {
      "id": "U5",
      "construct": "Chained route() registration",
      "reason": "Only verb calls directly on a router or app are read.",
      "mustCatch": [
        "M5"
      ]
    },
    {
      "id": "U6",
      "construct": "Method-agnostic all()",
      "reason": "all() is not among the verbs read.",
      "mustCatch": [
        "M6"
      ]
    },
    {
      "id": "U7",
      "construct": "Path arrays and any non-literal path argument",
      "reason": "Only a single string literal path is read.",
      "mustCatch": [
        "M7"
      ]
    },
    {
      "id": "U8",
      "construct": "Routers re-exported under an alias before mounting",
      "reason": "Mount resolution does not follow the alias, so the mount prefix is dropped.",
      "mustCatch": [
        "M8"
      ]
    },
    {
      "id": "U9",
      "construct": "Express 5 route-path semantics",
      "reason": "Not installed and not run; only Express 4.22.3 was exercised.",
      "mustCatch": []
    }
  ],
  "mustCatch": [
    {
      "id": "M1",
      "category": "dynamic-route-factory",
      "construct": "Router produced by a function call and mounted with a literal prefix: app.use('/widgets', crud('widgets'))",
      "counterexample": {
        "file": "src/app.js",
        "contains": "app.use('/widgets', crud('widgets'))"
      },
      "truth": [
        {
          "scenario": "js-counterexample",
          "route": "GET /widgets",
          "exists": true
        },
        {
          "scenario": "js-counterexample",
          "route": "POST /widgets",
          "exists": true
        },
        {
          "scenario": "js-counterexample",
          "route": "GET /",
          "exists": false
        }
      ],
      "scannerShould": [
        "GET /widgets",
        "POST /widgets"
      ],
      "scannerEmitsInstead": [
        "GET /",
        "POST /"
      ],
      "expected": "silent-miss",
      "note": "The scanner follows imports, not call results: the factory's inner routes are emitted at the root, where the live app answers 404, and the real /widgets routes are missing."
    },
    {
      "id": "M2",
      "category": "middleware-auth",
      "construct": "Router-wide auth middleware: router.use(requireAuth) guards every route registered below it",
      "counterexample": {
        "file": "src/routes/index.js",
        "contains": "router.use(requireAuth)"
      },
      "truth": [
        {
          "scenario": "js-counterexample",
          "route": "GET /secret",
          "auth": "token",
          "status": 200
        },
        {
          "scenario": "js-counterexample",
          "route": "GET /secret",
          "auth": "anon",
          "status": 401
        }
      ],
      "scannerShould": [
        "GET /secret"
      ],
      "scannerEmitsInstead": [],
      "expected": "caught",
      "note": "Only the route is caught. The auth requirement is not modelled and not flagged unknown (api.operations=false, no auth field), so an emitted route must not be read as an open route."
    },
    {
      "id": "M3",
      "category": "generated-routes",
      "construct": "Paths generated in a loop with a template literal: for (const name of [...]) router.get(`/gen/${name}`, handler)",
      "counterexample": {
        "file": "src/routes/index.js",
        "contains": "router.get(`/gen/${name}`, handler)"
      },
      "truth": [
        {
          "scenario": "js-counterexample",
          "route": "GET /gen/alpha",
          "exists": true
        },
        {
          "scenario": "js-counterexample",
          "route": "GET /gen/beta",
          "exists": true
        }
      ],
      "scannerShould": [
        "GET /gen/alpha",
        "GET /gen/beta"
      ],
      "scannerEmitsInstead": [],
      "expected": "silent-miss",
      "note": "Both generated routes are served; the scanner emits neither and leaves no unknown marker."
    },
    {
      "id": "M4",
      "category": "deployment-prefix",
      "construct": "Mount path decided at start-up by the environment: const base = process.env.API_BASE ?? '/svc'; app.use(base, ping)",
      "counterexample": {
        "file": "src/app.js",
        "contains": "app.use(base, ping)"
      },
      "truth": [
        {
          "scenario": "js-counterexample",
          "route": "GET /svc/ping",
          "exists": true
        },
        {
          "scenario": "js-counterexample",
          "route": "GET /ping",
          "exists": false
        },
        {
          "scenario": "js-counterexample-env-v2",
          "route": "GET /v2/ping",
          "exists": true
        },
        {
          "scenario": "js-counterexample-env-v2",
          "route": "GET /svc/ping",
          "exists": false
        }
      ],
      "scannerShould": [
        "GET /svc/ping"
      ],
      "scannerEmitsInstead": [
        "GET /ping"
      ],
      "expected": "silent-miss",
      "note": "The served prefix depends on API_BASE (/svc by default, /v2 when set), so the right output is \"unknown prefix\". The scanner emits the router's own path /ping, which no deployment serves."
    },
    {
      "id": "M5",
      "category": "route-chain",
      "construct": "Chained route(): router.route('/chain').get(handler).post(handler)",
      "counterexample": {
        "file": "src/routes/index.js",
        "contains": "router.route('/chain').get(handler).post(handler)"
      },
      "truth": [
        {
          "scenario": "js-counterexample",
          "route": "GET /chain",
          "exists": true
        },
        {
          "scenario": "js-counterexample",
          "route": "POST /chain",
          "exists": true
        }
      ],
      "scannerShould": [
        "GET /chain",
        "POST /chain"
      ],
      "scannerEmitsInstead": [],
      "expected": "silent-miss",
      "note": "Both verbs are served; the scanner emits neither."
    },
    {
      "id": "M6",
      "category": "multi-method",
      "construct": "Method-agnostic registration: router.all('/any', handler)",
      "counterexample": {
        "file": "src/routes/index.js",
        "contains": "router.all('/any', handler)"
      },
      "truth": [
        {
          "scenario": "js-counterexample",
          "route": "GET /any",
          "exists": true
        },
        {
          "scenario": "js-counterexample",
          "route": "POST /any",
          "exists": true
        }
      ],
      "scannerShould": [
        "GET /any",
        "POST /any"
      ],
      "scannerEmitsInstead": [],
      "expected": "silent-miss",
      "note": "The route answers every method; the scanner emits nothing for it."
    },
    {
      "id": "M7",
      "category": "path-array",
      "construct": "Array of paths in one verb call: router.get(['/a1', '/a2'], handler)",
      "counterexample": {
        "file": "src/routes/index.js",
        "contains": "router.get(['/a1', '/a2'], handler)"
      },
      "truth": [
        {
          "scenario": "js-counterexample",
          "route": "GET /a1",
          "exists": true
        },
        {
          "scenario": "js-counterexample",
          "route": "GET /a2",
          "exists": true
        }
      ],
      "scannerShould": [
        "GET /a1",
        "GET /a2"
      ],
      "scannerEmitsInstead": [],
      "expected": "silent-miss",
      "note": "Both paths are served; the scanner emits neither."
    },
    {
      "id": "M8",
      "category": "router-prefix-mount",
      "construct": "Mounted router exported under an alias (export { router as legacyRouter }) and mounted with app.use('/legacy', legacyRouter)",
      "counterexample": {
        "file": "src/app.js",
        "contains": "app.use('/legacy', legacyRouter)"
      },
      "truth": [
        {
          "scenario": "js-counterexample",
          "route": "GET /legacy/old",
          "exists": true
        },
        {
          "scenario": "js-counterexample",
          "route": "GET /old",
          "exists": false
        }
      ],
      "scannerShould": [
        "GET /legacy/old"
      ],
      "scannerEmitsInstead": [
        "GET /old"
      ],
      "expected": "silent-miss",
      "note": "The prefix is lost: the route is emitted at /old, which the live app answers 404, instead of /legacy/old."
    },
    {
      "id": "M9",
      "category": "app-level-mount",
      "construct": "Application-level mount prefix over an imported router: app.use('/api', apiRouter)",
      "counterexample": {
        "file": "src/app.js",
        "contains": "app.use('/api', apiRouter)"
      },
      "truth": [
        {
          "scenario": "js-counterexample",
          "route": "GET /api/status",
          "exists": true
        },
        {
          "scenario": "js-counterexample",
          "route": "GET /status",
          "exists": false
        }
      ],
      "scannerShould": [
        "GET /api/status"
      ],
      "scannerEmitsInstead": [],
      "expected": "caught",
      "note": "The audit text calls app.use-level mount prefixes a known limit; this run did not reproduce it for a literal prefix over an imported router. The failing prefix cases are M4 and M8."
    }
  ],
