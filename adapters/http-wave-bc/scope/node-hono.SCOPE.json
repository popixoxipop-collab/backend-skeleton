      "contract": "sbf.adapter/2",
      "specificity": 55,
      "verificationBasis": "synthetic-only",
      "capabilities": {
        "api.operations": false,
        "api.request-shape": false,
        "resource.fetch": false,
        "codegen.handles": false
      },
      "profileState": "STATIC_EVIDENCE_GREEN",
      "promotionState": "HOLD_T19_T23",
      "profilePin": "4.13.9"
    },
    "runtimeTested": {
      "frameworkOracleRun": true,
      "scannerVsRuntimeCompared": true,
      "scope": "hono 4.13.9 imported from the committed fixtures and driven through app.request() on Node v24.19.0, darwin-arm64 (no HTTP server, no network); the live scanner output was compared route by route with the returned statuses; app.routes is recorded as extra oracle data.",
      "notRun": [
        "Hono versions other than 4.13.9",
        "Hono on Workers, Deno or Bun",
        "TypeScript sources (the fixtures are plain ESM JavaScript)",
        "showRoutes() output parsing (covered by the existing hono-show-routes test, not by this record)",
        "Node 22 for the oracle (oracle ran on v24.19.0 only)"
      ]
    }
  },
  "scanner": {
    "runner": "node-hono",
    "module": "adapters/http-wave-bc/node-hono/adapter.mjs",
    "emitsUnknownMarkers": true
  },
  "supported": [
    {
      "id": "S1",
      "construct": "Literal per-verb call on a tracked new Hono() variable",
      "emits": [
        "GET /health"
      ]
    },
    {
      "id": "S2",
      "construct": "route('/users', users): a relative-import child app mounted at a literal path, with literal and parameterised child routes",
      "emits": [
        "GET /users",
        "POST /users",
        "GET /users/:id"
      ]
    },
    {
      "id": "S3",
      "construct": "Literal basePath('/v1') on a child app combined with a literal route('/api', v1) mount",
      "emits": [
        "GET /api/v1/status",
        "DELETE /api/v1/sessions/:sid"
      ]
    }
  ],
  "unsupported": [
    {
      "id": "U1",
      "construct": "route() mount of a sub-app built by a function call",
      "reason": "The mount child must be an identifier that resolves to a local or relative-imported Hono app; the mount is reported in scanNotes, but the factory file's own router is also emitted at its own root.",
      "mustCatch": [
        "M1"
      ]
    },
    {
      "id": "U2",
      "construct": "Middleware via use() (auth guards)",
      "reason": "use() is observed and noted, never emitted or modelled; routes behind it are emitted without the guard.",
      "mustCatch": [
        "M2"
      ]
    },
    {
      "id": "U3",
      "construct": "Template-literal (generated) route paths",
      "reason": "Reported in scanNotes and not emitted.",
      "mustCatch": [
        "M3"
      ]
    },
    {
      "id": "U4",
      "construct": "Mount path decided at start-up (route(base, child))",
      "reason": "The mount is reported in scanNotes, but the child app's own routes are still emitted at the child's root.",
      "mustCatch": [
        "M4"
      ]
    },
    {
      "id": "U5",
      "construct": "Chained verb calls (app.get(p, h).post(p, h))",
      "reason": "Only the call made directly on a tracked variable is read; later verbs on the chain are neither emitted nor noted.",
      "mustCatch": [
        "M5"
      ]
    },
    {
      "id": "U6",
      "construct": "Method-agnostic all() registration",
      "reason": "Observed and noted, not emitted.",
      "mustCatch": [
        "M6"
      ]
    },
    {
      "id": "U7",
      "construct": "on() with method or path lists",
      "reason": "Observed and noted, not emitted.",
      "mustCatch": [
        "M7"
      ]
    },
    {
      "id": "U8",
      "construct": "mount() of a foreign fetch handler",
      "reason": "Observed and noted, not emitted.",
      "mustCatch": [
        "M8"
      ]
    },
    {
      "id": "U9",
      "construct": "Hono versions other than 4.13.9 and non-Node runtimes",
      "reason": "Not installed and not run.",
      "mustCatch": []
    }
  ],
  "mustCatch": [
    {
      "id": "M1",
      "category": "dynamic-route-factory",
      "construct": "Sub-app produced by a function call and mounted: app.route('/widgets', crud('widgets'))",
      "counterexample": {
        "file": "src/app.js",
        "contains": "app.route('/widgets', crud('widgets'))"
      },
      "truth": [
        {
          "scenario": "hono-counterexample",
          "route": "GET /widgets",
          "exists": true
        },
        {
          "scenario": "hono-counterexample",
          "route": "POST /widgets",
          "exists": true
        },
        {
          "scenario": "hono-counterexample",
          "route": "GET /",
          "exists": false
        }
      ],
      "scannerShould": [
        "GET /widgets",
        "POST /widgets"
      ],
      "scannerEmitsInstead": [
        "GET /",
        "POST /"
      ],
      "unknownMarker": "route\\(\\) mount at app\\.js:18 \\(/widgets, crud\\) could not be resolved",
      "expected": "left-unknown",
      "note": "The unresolved mount is reported, but the factory file's router is emitted at its own root as GET / and POST /, which the live app answers 404 (no note on those routes)."
    },
    {
      "id": "M2",
      "category": "middleware-auth",
      "construct": "Auth middleware guarding a subtree: app.use('/secret/*', ...) before app.get('/secret/data', ...)",
      "counterexample": {
        "file": "src/app.js",
        "contains": "app.use('/secret/*'"
      },
      "truth": [
        {
          "scenario": "hono-counterexample",
          "route": "GET /secret/data",
          "auth": "token",
          "status": 200
        },
        {
          "scenario": "hono-counterexample",
          "route": "GET /secret/data",
          "auth": "anon",
          "status": 401
        }
      ],
      "scannerShould": [
        "GET /secret/data"
      ],
      "scannerEmitsInstead": [],
      "unknownMarker": "use\\(\\) at app\\.js:10",
      "expected": "caught",
      "note": "The route is emitted and the use() is reported as observed-not-emitted. The auth requirement itself is not modelled, so an emitted route must not be read as an open route."
    },
    {
      "id": "M3",
      "category": "generated-routes",
      "construct": "Paths generated in a loop with a template literal: app.get(`/gen/${name}`, ...)",
      "counterexample": {
        "file": "src/app.js",
        "contains": "app.get(`/gen/${name}`"
      },
      "truth": [
        {
          "scenario": "hono-counterexample",
          "route": "GET /gen/alpha",
          "exists": true
        },
        {
          "scenario": "hono-counterexample",
          "route": "GET /gen/beta",
          "exists": true
        }
      ],
      "scannerShould": [
        "GET /gen/alpha",
        "GET /gen/beta"
      ],
      "scannerEmitsInstead": [],
      "unknownMarker": "interpolated template route at app\\.js:16 is not emitted",
      "expected": "left-unknown",
      "note": "Both generated routes are served; the scanner emits neither and says so."
    },
    {
      "id": "M4",
      "category": "deployment-prefix",
      "construct": "Mount path decided at start-up by the environment: const base = process.env.API_BASE ?? '/svc'; app.route(base, ping)",
      "counterexample": {
        "file": "src/app.js",
        "contains": "app.route(base, ping)"
      },
      "truth": [
        {
          "scenario": "hono-counterexample",
          "route": "GET /svc/ping",
          "exists": true
        },
        {
          "scenario": "hono-counterexample",
          "route": "GET /ping",
          "exists": false
        },
        {
          "scenario": "hono-counterexample-env-v2",
          "route": "GET /v2/ping",
          "exists": true
        },
        {
          "scenario": "hono-counterexample-env-v2",
          "route": "GET /svc/ping",
          "exists": false
        }
      ],
      "scannerShould": [
        "GET /svc/ping"
      ],
      "scannerEmitsInstead": [
        "GET /ping"
      ],
      "unknownMarker": "route\\(\\) at app\\.js:19 has a dynamic path",
      "expected": "left-unknown",
      "note": "The prefix depends on API_BASE (/svc by default, /v2 when set), so unknown is the right answer for the mount. The child app's own route is still emitted at its root as GET /ping, which no deployment serves."
    },
    {
      "id": "M5",
      "category": "route-chain",
      "construct": "Chained verb calls on one expression: app.get('/chain', h).post('/chain', h)",
      "counterexample": {
        "file": "src/app.js",
        "contains": ".post('/chain'"
      },
      "truth": [
        {
          "scenario": "hono-counterexample",
          "route": "GET /chain",
          "exists": true
        },
        {
          "scenario": "hono-counterexample",
          "route": "POST /chain",
          "exists": true
        }
      ],
      "scannerShould": [
        "GET /chain",
        "POST /chain"
      ],
      "scannerEmitsInstead": [],
      "expected": "silent-miss",
      "note": "Only the first call of the chain is read: POST /chain is served but neither emitted nor reported unknown."
    },
    {
      "id": "M6",
      "category": "multi-method",
      "construct": "Method-agnostic registration: app.all('/any', ...)",
      "counterexample": {
        "file": "src/app.js",
        "contains": "app.all('/any'"
      },
      "truth": [
        {
          "scenario": "hono-counterexample",
          "route": "GET /any",
          "exists": true
        },
        {
          "scenario": "hono-counterexample",
          "route": "POST /any",
          "exists": true
        }
      ],
      "scannerShould": [
        "GET /any",
        "POST /any"
      ],
      "scannerEmitsInstead": [],
      "unknownMarker": "all\\(\\) at app\\.js:22",
      "expected": "left-unknown",
      "note": "The route answers every probed method; the scanner reports all() as observed-not-emitted."
    },
    {
      "id": "M7",
      "category": "path-array",
      "construct": "Method and path lists: app.on('GET', ['/a1', '/a2'], ...)",
      "counterexample": {
        "file": "src/app.js",
        "contains": "app.on('GET', ['/a1', '/a2']"
      },
      "truth": [
        {
          "scenario": "hono-counterexample",
          "route": "GET /a1",
          "exists": true
        },
        {
          "scenario": "hono-counterexample",
          "route": "GET /a2",
          "exists": true
        }
      ],
      "scannerShould": [
        "GET /a1",
        "GET /a2"
      ],
      "scannerEmitsInstead": [],
      "unknownMarker": "on\\(\\) at app\\.js:23",
      "expected": "left-unknown",
      "note": "Both paths are served; on() is reported as observed-not-emitted."
    },
    {
      "id": "M8",
      "category": "router-prefix-mount",
      "construct": "Foreign fetch handler mounted under a prefix: app.mount('/legacy', handler)",
      "counterexample": {
        "file": "src/app.js",
        "contains": "app.mount('/legacy'"
      },
      "truth": [
        {
          "scenario": "hono-counterexample",
          "route": "GET /legacy/old",
          "exists": true
        },
        {
          "scenario": "hono-counterexample",
          "route": "GET /old",
          "exists": false
        }
      ],
      "scannerShould": [
        "GET /legacy/old"
      ],
      "scannerEmitsInstead": [],
      "unknownMarker": "mount\\(\\) at app\\.js:24",
      "expected": "left-unknown",
      "note": "Everything under /legacy is answered by the mounted handler; the scanner reports mount() as observed-not-emitted."
    },
    {
      "id": "M9",
      "category": "parameterised-mount",
      "construct": "Parameterised literal mount path over an imported sub-app: app.route('/orgs/:org', members)",
      "counterexample": {
        "file": "src/app.js",
        "contains": "app.route('/orgs/:org', members)"
      },
      "truth": [
        {
          "scenario": "hono-counterexample",
          "route": "GET /orgs/:org/list",
          "exists": true
        },
        {
          "scenario": "hono-counterexample",
          "route": "GET /list",
          "exists": false
        }
      ],
      "scannerShould": [
        "GET /orgs/:org/list"
      ],
      "scannerEmitsInstead": [],
      "expected": "caught",
      "note": "A mount path with a parameter is a literal string to the scanner and is composed with the child route."
    }
