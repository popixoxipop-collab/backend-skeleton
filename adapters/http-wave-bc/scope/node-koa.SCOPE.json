  "claim": {
    "registrationAloneIsSupport": false,
    "published": "synthetic-only-hold",
    "scope": "Koa with @koa/router: a same-file Router mounted through app.use(router.routes()), literal per-verb calls, named routes and a literal constructor prefix are read statically. Verification basis is synthetic-only and promotion is held (HOLD_T19_T23); api.operations, api.request-shape, resource.fetch and codegen.handles are all false. Catalog registration does not make any construct outside supported[] supported.",
    "registration": {
      "adapterId": "node-koa",
      "contract": "sbf.adapter/2",
      "specificity": 54,
      "verificationBasis": "synthetic-only",
      "capabilities": {
        "api.operations": false,
        "api.request-shape": false,
        "resource.fetch": false,
        "codegen.handles": false
      },
      "profileState": "STATIC_EVIDENCE_GREEN",
      "promotionState": "HOLD_T19_T23",
      "profilePin": "15.7.0"
    },
    "runtimeTested": {
      "frameworkOracleRun": true,
      "scannerVsRuntimeCompared": true,
      "scope": "koa 3.2.1 with @koa/router 15.7.0 imported from the committed fixtures, served through app.callback() on an ephemeral 127.0.0.1 port on Node v24.19.0, darwin-arm64, and probed with fetch; the live scanner output was compared route by route with the returned statuses.",
      "notRun": [
        "Koa or @koa/router versions other than 3.2.1 and 15.7.0",
        "TypeScript sources (the fixtures are plain ESM JavaScript)",
        "CommonJS and generic Router bindings that the profile also claims (the fixtures use ESM imports only)",
        "host, method, sensitive and strict router options",
        "Node 22 for the oracle (oracle ran on v24.19.0 only)"
      ]
    }
  },
  "scanner": {
    "runner": "node-koa",
    "module": "adapters/http-wave-bc/node-koa/adapter.mjs",
    "emitsUnknownMarkers": true
  },
  "supported": [
    {
      "id": "S1",
      "construct": "Router without prefix, literal verb call, mounted in the same file with app.use(router.routes())",
      "emits": [
        "GET /"
      ]
    },
    {
      "id": "S2",
      "construct": "Router with a literal constructor prefix and literal get/post/delete calls, including a parameterised path",
      "emits": [
        "GET /api/health",
        "POST /api/users",
        "GET /api/users/:id",
        "DELETE /api/users/:id"
      ]
    },
    {
      "id": "S3",
      "construct": "Named route form router.get(name, path, handler)",
      "emits": [
        "GET /api/users"
      ]
    }
  ],
  "unsupported": [
    {
      "id": "U1",
      "construct": "Router built by a factory function in another file and mounted from a call expression",
      "reason": "Detection and the router graph are same-file only. The factory file is not reported and nothing is emitted for the call-expression mount.",
      "mustCatch": [
        "M1"
      ]
    },
    {
      "id": "U2",
      "construct": "Router-level middleware via router.use() (auth guards)",
      "reason": "use() is observed and noted, never expanded or modelled; routes behind it are emitted without the guard.",
      "mustCatch": [
        "M2"
      ]
    },
    {
      "id": "U3",
      "construct": "Template-literal (generated) route paths",
      "reason": "Reported in scanNotes as non-literal and not emitted.",
      "mustCatch": [
        "M3"
      ]
    },
    {
      "id": "U4",
      "construct": "Router prefix decided at start-up (non-literal constructor prefix)",
      "reason": "Reported in scanNotes; none of that router's routes are emitted.",
      "mustCatch": [
        "M4"
      ]
    },
    {
      "id": "U5",
      "construct": "Chained verb calls (router.get(p, h).post(p, h))",
      "reason": "Only the first call on the tracked variable is read; later verbs on the chain are neither emitted nor noted.",
      "mustCatch": [
        "M5"
      ]
    },
    {
      "id": "U6",
      "construct": "Method-agnostic router.all()",
      "reason": "Observed and noted, not emitted.",
      "mustCatch": [
        "M6"
      ]
    },
    {
      "id": "U7",
      "construct": "Array or RegExp route paths",
      "reason": "Reported in scanNotes as outside the first slice and not emitted.",
      "mustCatch": [
        "M7"
      ]
    },
    {
      "id": "U8",
      "construct": "prefix() mutation after routes were declared",
      "reason": "Reported in scanNotes; all of that router's routes are withheld.",
      "mustCatch": [
        "M8"
      ]
    },
    {
      "id": "U9",
      "construct": "Nested router mounted through router.use(path, child.routes())",
      "reason": "use() is observed but not expanded and the child router is withheld as unmounted; both are reported.",
      "mustCatch": [
        "M9"
      ]
    },
    {
      "id": "U10",
      "construct": "Koa or @koa/router versions other than 3.2.1 and 15.7.0, CommonJS bindings, non-Node runtimes",
      "reason": "Not installed and not run.",
      "mustCatch": []
    }
  ],
  "mustCatch": [
    {
      "id": "M1",
      "category": "dynamic-route-factory",
      "construct": "Router produced by a function in another file and mounted from a call: app.use(crud('widgets').routes())",
      "counterexample": {
        "file": "src/server.js",
        "contains": "app.use(crud('widgets').routes())"
      },
      "truth": [
        {
          "scenario": "koa-counterexample",
          "route": "GET /widgets",
          "exists": true
        },
        {
          "scenario": "koa-counterexample",
          "route": "POST /widgets",
          "exists": true
        },
        {
          "scenario": "koa-counterexample",
          "route": "GET /",
          "exists": false
        }
      ],
      "scannerShould": [
        "GET /widgets",
        "POST /widgets"
      ],
      "scannerEmitsInstead": [],
      "expected": "silent-miss",
      "note": "Both factory routes are served. The scanner emits neither and reports nothing about the factory file or the call-expression mount, so the gap is invisible in its output."
    },
    {
      "id": "M2",
      "category": "middleware-auth",
      "construct": "Router-level auth middleware: secured.use(requireAuth) before secured.get(/data, ...)",
      "counterexample": {
        "file": "src/server.js",
        "contains": "secured.use(requireAuth)"
      },
      "truth": [
        {
          "scenario": "koa-counterexample",
          "route": "GET /secure/data",
          "auth": "token",
          "status": 200
        },
        {
          "scenario": "koa-counterexample",
          "route": "GET /secure/data",
          "auth": "anon",
          "status": 401
        }
      ],
      "scannerShould": [
        "GET /secure/data"
      ],
      "scannerEmitsInstead": [],
      "unknownMarker": "server\\.js:18 router\\.use\\(\\)",
      "expected": "caught",
      "note": "The route is emitted and the use() is reported as observed-not-expanded. The auth requirement itself is not modelled, so an emitted route must not be read as an open route."
    },
    {
      "id": "M3",
      "category": "generated-routes",
      "construct": "Paths generated in a loop with a template literal: gen.get(`/gen/${name}`, ...)",
      "counterexample": {
        "file": "src/server.js",
        "contains": "gen.get(`/gen/${name}`"
      },
      "truth": [
        {
          "scenario": "koa-counterexample",
          "route": "GET /gen/alpha",
          "exists": true
        },
        {
          "scenario": "koa-counterexample",
          "route": "GET /gen/beta",
          "exists": true
        }
      ],
      "scannerShould": [
        "GET /gen/alpha",
        "GET /gen/beta"
      ],
      "scannerEmitsInstead": [],
      "unknownMarker": "server\\.js:22 gen\\.get\\(\\) not emitted",
      "expected": "left-unknown",
      "note": "Both generated routes are served; the scanner emits neither and says the path is non-literal."
    },
    {
      "id": "M4",
      "category": "deployment-prefix",
      "construct": "Router prefix decided at start-up by the environment: new Router({ prefix: process.env.API_BASE ?? '/svc' })",
      "counterexample": {
        "file": "src/server.js",
        "contains": "process.env.API_BASE ?? '/svc'"
      },
      "truth": [
        {
          "scenario": "koa-counterexample",
          "route": "GET /svc/ping",
          "exists": true
        },
        {
          "scenario": "koa-counterexample",
          "route": "GET /ping",
          "exists": false
        },
        {
          "scenario": "koa-counterexample-env-v2",
          "route": "GET /v2/ping",
          "exists": true
        },
        {
          "scenario": "koa-counterexample-env-v2",
          "route": "GET /svc/ping",
          "exists": false
        }
      ],
      "scannerShould": [
        "GET /svc/ping"
      ],
      "scannerEmitsInstead": [],
      "unknownMarker": "deployed: Router constructor prefix is non-literal",
      "expected": "left-unknown",
      "note": "The prefix depends on API_BASE (/svc by default, /v2 when set), so unknown is the right answer. The scanner emits nothing for that router, so no wrong path is published."
    },
    {
      "id": "M5",
      "category": "route-chain",
      "construct": "Chained verb calls on one expression: misc.get('/chain', h).post('/chain', h)",
      "counterexample": {
        "file": "src/server.js",
        "contains": ".post('/chain'"
      },
      "truth": [
        {
          "scenario": "koa-counterexample",
          "route": "GET /chain",
          "exists": true
        },
        {
          "scenario": "koa-counterexample",
          "route": "POST /chain",
          "exists": true
        }
      ],
      "scannerShould": [
        "GET /chain",
        "POST /chain"
      ],
      "scannerEmitsInstead": [],
      "expected": "silent-miss",
      "note": "Only the first call of the chain is read: POST /chain is served but neither emitted nor reported unknown."
    },
    {
      "id": "M6",
      "category": "multi-method",
      "construct": "Method-agnostic registration: misc.all('/any', ...)",
      "counterexample": {
        "file": "src/server.js",
        "contains": "misc.all('/any'"
      },
      "truth": [
        {
          "scenario": "koa-counterexample",
          "route": "GET /any",
          "exists": true
        },
        {
          "scenario": "koa-counterexample",
          "route": "POST /any",
          "exists": true
        }
      ],
      "scannerShould": [
        "GET /any",
        "POST /any"
      ],
      "scannerEmitsInstead": [],
      "unknownMarker": "server\\.js:28 router\\.all\\(\\) represents all HTTP methods",
      "expected": "left-unknown",
      "note": "The route answers every probed method; the scanner reports all() as not emitted."
    },
    {
      "id": "M7",
      "category": "path-array",
      "construct": "Array path: misc.get(['/a1', '/a2'], ...)",
      "counterexample": {
        "file": "src/server.js",
        "contains": "misc.get(['/a1', '/a2']"
      },
      "truth": [
        {
          "scenario": "koa-counterexample",
          "route": "GET /a1",
          "exists": true
        },
        {
          "scenario": "koa-counterexample",
          "route": "GET /a2",
          "exists": true
        }
      ],
      "scannerShould": [
        "GET /a1",
        "GET /a2"
      ],
      "scannerEmitsInstead": [],
      "unknownMarker": "server\\.js:29 misc\\.get\\(\\) not emitted",
      "expected": "left-unknown",
      "note": "Both paths are served; the scanner reports the array path as outside the first slice."
    },
    {
      "id": "M8",
      "category": "router-prefix-mount",
      "construct": "prefix() mutation after the routes were declared: legacy.get('/old', ...); legacy.prefix('/legacy')",
      "counterexample": {
        "file": "src/server.js",
        "contains": "legacy.prefix('/legacy')"
      },
      "truth": [
        {
          "scenario": "koa-counterexample",
          "route": "GET /legacy/old",
          "exists": true
        },
        {
          "scenario": "koa-counterexample",
          "route": "GET /old",
          "exists": false
        }
      ],
      "scannerShould": [
        "GET /legacy/old"
      ],
      "scannerEmitsInstead": [],
      "unknownMarker": "router legacy calls prefix\\(\\)",
      "expected": "left-unknown",
      "note": "The route is served only under /legacy; the scanner withholds the router instead of emitting the unprefixed path."
    },
    {
      "id": "M9",
      "category": "router-prefix-mount",
      "construct": "Nested router mounted under a prefix: nested.use('/nested', child.routes())",
      "counterexample": {
        "file": "src/server.js",
        "contains": "nested.use('/nested', child.routes())"
      },
      "truth": [
        {
          "scenario": "koa-counterexample",
          "route": "GET /nested/leaf",
          "exists": true
        },
        {
          "scenario": "koa-counterexample",
          "route": "GET /leaf",
          "exists": false
        }
      ],
      "scannerShould": [
        "GET /nested/leaf"
      ],
      "scannerEmitsInstead": [],
      "unknownMarker": "server\\.js:35 router\\.use\\(\\)",
      "expected": "left-unknown",
      "note": "The leaf is served only under /nested; the scanner reports the use() as not expanded and withholds the child router instead of emitting GET /leaf."
    }
  ],
