{
  "schema": "bskel.http-target-scope/1",
  "item": "HTTP-typescript-nextjs-01",
  "target": "HTTP-typescript-nextjs",
  "track": "T13",
  "recordDate": "2026-10-09",
  "claim": {
    "registrationAloneIsSupport": false,
    "published": "synthetic-only-hold",
    "scope": "Next.js App Router route handlers (app/**/route.ts) with explicitly exported HTTP method functions, simple [param] segments and route groups, under a literal basePath from next.config. Verification basis is synthetic-only, the profile state is STATIC_EVIDENCE_GREEN and promotion is held (HOLD_T19_T23); api.operations, api.request-shape, resource.fetch and codegen.handles are all false. Catalog registration does not make any construct outside supported[] supported.",
    "registration": {
      "adapterId": "typescript-nextjs",
      "contract": "sbf.adapter/2",
      "specificity": 56,
      "verificationBasis": "synthetic-only",
      "capabilities": {
        "api.operations": false,
        "api.request-shape": false,
        "resource.fetch": false,
        "codegen.handles": false
      },
      "profileState": "STATIC_EVIDENCE_GREEN",
      "promotionState": "HOLD_T19_T23",
      "profilePin": "16.4.0-canary.45"
    },
    "runtimeTested": {
      "frameworkOracleRun": true,
      "scannerVsRuntimeCompared": true,
      "scope": "next 16.4.0-canary.45 (react and react-dom 19.3.0): the real `next build` (Turbopack) ran on a work copy of each committed fixture and the resulting production server was started programmatically on an ephemeral 127.0.0.1 port and probed with fetch, on Node v24.19.0, darwin-arm64. The live scanner output was compared route by route with the returned statuses.",
      "notRun": [
        "Next.js versions other than 16.4.0-canary.45 (a canary build; no stable release was run)",
        "Node 22 for the oracle (oracle ran on v24.19.0 only)",
        "the next CLI start command, next dev, standalone output and the edge runtime (the production server was started through the programmatic API)",
        "webpack builds (Turbopack default only)",
        "Pages Router pages, middleware.ts (the fixtures use the Next 16 proxy.ts), i18n, parallel and intercepting routes",
        "authentication enforcement beyond the single proxy.ts matcher probe"
      ]
    }
  },
  "scanner": {
    "runner": "typescript-nextjs",
    "module": "adapters/http-wave-bc/typescript-nextjs/adapter.mjs",
    "emitsUnknownMarkers": true
  },
  "supported": [
    {
      "id": "S1",
      "construct": "App Router route.ts with directly exported method functions (export function GET/POST) under a literal basePath: app/api/{health,ping,users}/route.ts with basePath /portal",
      "emits": [
        "GET /portal/api/health",
        "GET /portal/api/ping",
        "POST /portal/api/ping",
        "GET /portal/api/users",
        "POST /portal/api/users"
      ]
    },
    {
      "id": "S2",
      "construct": "Simple [param] segment: app/api/users/[id]/route.ts is reported as /portal/api/users/{id} for each exported method",
      "emits": [
        "GET /portal/api/users/{id}",
        "DELETE /portal/api/users/{id}"
      ]
    },
    {
      "id": "S3",
      "construct": "Route group (admin): the group folder is dropped from the URL, app/(admin)/admin/stats/route.ts is /portal/admin/stats",
      "emits": [
        "GET /portal/admin/stats"
      ]
    }
  ],
  "unsupported": [
    {
      "id": "U1",
      "construct": "Route handlers whose methods are produced by a factory call (export const { GET, POST } = createHandlers(...))",
      "reason": "Only directly exported method functions are read; the file is reported as exporting no directly supported HTTP method and nothing is emitted for it.",
      "mustCatch": [
        "M1"
      ]
    },
    {
      "id": "U2",
      "construct": "Authentication and authorization semantics of proxy.ts (and middleware.ts) matchers",
      "reason": "Neither file is read or reported; routes behind a matcher are emitted without any guard information.",
      "mustCatch": [
        "M2"
      ]
    },
    {
      "id": "U3",
      "construct": "Metadata and generated routes (sitemap, robots, manifest, icons, opengraph-image)",
      "reason": "Only route.ts files are read; a served /sitemap.xml produced by app/sitemap.ts is neither emitted nor reported.",
      "mustCatch": [
        "M3"
      ]
    },
    {
      "id": "U4",
      "construct": "basePath decided from the environment or any non-literal expression",
      "reason": "The literal part of the expression is used as the prefix without a warning, so the emitted prefix is right only for the deployment that matches it.",
      "mustCatch": [
        "M4"
      ]
    },
    {
      "id": "U5",
      "construct": "next.config rewrites, redirects and headers",
      "reason": "The configuration is read for basePath only; routes reachable through a rewrite are neither emitted nor reported.",
      "mustCatch": [
        "M5"
      ]
    },
    {
      "id": "U6",
      "construct": "Catch-all and optional catch-all segments ([...path], [[...path]])",
      "reason": "Reported as unknown (catch-all-segment) and not emitted.",
      "mustCatch": [
        "M6"
      ]
    },
    {
      "id": "U7",
      "construct": "Pages Router API routes (pages/api/*.ts)",
      "reason": "Reported as detected but not emitted, because the methods depend on handler control flow.",
      "mustCatch": [
        "M7"
      ]
    },
    {
      "id": "U8",
      "construct": "Framework-generated HEAD and OPTIONS responses",
      "reason": "Only explicitly exported methods are emitted; the oracle answers HEAD and OPTIONS on a GET-only route (probed on /portal/api/health) and the scanner states that it does not synthesize them.",
      "mustCatch": []
    },
    {
      "id": "U9",
      "construct": "Next.js versions other than 16.4.0-canary.45, Node versions other than v24.19.0, webpack, standalone output, edge runtime, i18n, parallel and intercepting routes",
      "reason": "Not installed and not run.",
      "mustCatch": []
    }
  ],
  "mustCatch": [
    {
      "id": "M1",
      "category": "dynamic-route-factory",
      "construct": "Route methods produced by a factory function: export const { GET, POST } = createHandlers('items')",
      "counterexample": {
        "file": "app/api/items/route.ts",
        "contains": "export const { GET, POST } = createHandlers('items');"
      },
      "truth": [
        {
          "scenario": "nextjs-counterexample",
          "route": "GET /portal/api/items",
          "status": 200
        },
        {
          "scenario": "nextjs-counterexample",
          "route": "POST /portal/api/items",
          "status": 201
        }
      ],
      "scannerShould": [
        "GET /portal/api/items",
        "POST /portal/api/items"
      ],
      "scannerEmitsInstead": [],
      "unknownMarker": "app/api/items/route\\.ts exports no directly supported HTTP method",
      "expected": "left-unknown",
      "note": "Both factory routes are served (200 and 201). The scanner emits neither and reports that the file exports no directly supported method, so the gap is visible in its output."
    },
    {
      "id": "M2",
      "category": "middleware-auth",
      "construct": "proxy.ts guard with a matcher: export const config = { matcher: '/api/secure/:path*' } returns 401 without the x-token header",
      "counterexample": {
        "file": "proxy.ts",
        "contains": "matcher: '/api/secure/:path*'"
      },
      "truth": [
        {
          "scenario": "nextjs-counterexample",
          "route": "GET /portal/api/secure/data",
          "auth": "token",
          "status": 200
        },
        {
          "scenario": "nextjs-counterexample",
          "route": "GET /portal/api/secure/data",
          "auth": "anon",
          "status": 401
        }
      ],
      "scannerShould": [
        "GET /portal/api/secure/data"
      ],
      "scannerEmitsInstead": [],
      "expected": "caught",
      "note": "Only the route is caught. The guard is neither modelled nor reported (no unknown mentions proxy.ts, api.operations=false), so an emitted route must not be read as an open route."
    },
    {
      "id": "M3",
      "category": "generated-routes",
      "construct": "Generated metadata route: app/sitemap.ts serves /sitemap.xml",
      "counterexample": {
        "file": "app/sitemap.ts",
        "contains": "export default function sitemap()"
      },
      "truth": [
        {
          "scenario": "nextjs-counterexample",
          "route": "GET /portal/sitemap.xml",
          "exists": true
        },
        {
          "scenario": "nextjs-counterexample",
          "route": "GET /sitemap.xml",
          "exists": false
        }
      ],
      "scannerShould": [
        "GET /portal/sitemap.xml"
      ],
      "scannerEmitsInstead": [],
      "expected": "silent-miss",
      "note": "The generated route is served under the basePath; the scanner emits nothing for it and reports nothing about metadata routes."
    },
    {
      "id": "M4",
      "category": "deployment-prefix",
      "construct": "basePath decided by the environment: basePath: '/portal' + tenant, with tenant = process.env.TENANT ?? ''",
      "counterexample": {
        "file": "next.config.mjs",
        "contains": "basePath: '/portal' + tenant"
      },
      "truth": [
        {
          "scenario": "nextjs-counterexample",
          "route": "GET /portal/api/open",
          "exists": true
        },
        {
          "scenario": "nextjs-counterexample",
          "route": "GET /api/open",
          "exists": false
        },
        {
          "scenario": "nextjs-counterexample-tenant-eu",
          "route": "GET /portal-eu/api/open",
          "exists": true
        },
        {
          "scenario": "nextjs-counterexample-tenant-eu",
          "route": "GET /portal/api/open",
          "exists": false
        }
      ],
      "scannerShould": [
        "GET /portal/api/open",
        "GET /portal-eu/api/open"
      ],
      "scannerEmitsInstead": [],
      "expected": "silent-miss",
      "note": "The served prefix is /portal by default and /portal-eu when TENANT=-eu (then /portal/api/open answers 404). The scanner emits only the literal /portal prefix and does not mark it unknown, so under TENANT=-eu its route is wrong with no warning."
    },
    {
      "id": "M5",
      "category": "config-driven",
      "construct": "Route reachable through a rewrite: rewrites() maps /v1/:path* to /api/:path*",
      "counterexample": {
        "file": "next.config.mjs",
        "contains": "source: '/v1/:path*'"
      },
      "truth": [
        {
          "scenario": "nextjs-counterexample",
          "route": "GET /portal/v1/open",
          "exists": true
        }
      ],
      "scannerShould": [
        "GET /portal/v1/open"
      ],
      "scannerEmitsInstead": [],
      "expected": "silent-miss",
      "note": "The rewritten URL is served; the scanner emits and reports nothing about rewrites."
    },
    {
      "id": "M6",
      "category": "dynamic-segment",
      "construct": "Catch-all segment: app/api/files/[...path]/route.ts",
      "counterexample": {
        "file": "app/api/files/[...path]/route.ts",
        "contains": "export async function GET"
      },
      "truth": [
        {
          "scenario": "nextjs-counterexample",
          "route": "GET /portal/api/files/{...path}",
          "exists": true
        }
      ],
      "scannerShould": [
        "GET /portal/api/files/{...path}"
      ],
      "scannerEmitsInstead": [],
      "unknownMarker": "app/api/files/\\[\\.\\.\\.path\\]/route\\.ts uses catch-all-segment",
      "expected": "left-unknown",
      "note": "The catch-all is served (probed with /portal/api/files/a/b); the scanner emits nothing and reports the catch-all segment as unknown."
    },
    {
      "id": "M7",
      "category": "multi-method",
      "construct": "Pages Router API route that answers every method: pages/api/legacy.ts",
      "counterexample": {
        "file": "pages/api/legacy.ts",
        "contains": "export default function handler"
      },
      "truth": [
        {
          "scenario": "nextjs-counterexample",
          "route": "GET /portal/api/legacy",
          "status": 200
        },
        {
          "scenario": "nextjs-counterexample",
          "route": "POST /portal/api/legacy",
          "status": 200
        }
      ],
      "scannerShould": [
        "GET /portal/api/legacy",
        "POST /portal/api/legacy"
      ],
      "scannerEmitsInstead": [],
      "unknownMarker": "Pages API files were detected but are not emitted",
      "expected": "left-unknown",
      "note": "Both methods answer 200; the scanner detects the Pages API file and reports that it is not emitted."
    }
  ],
