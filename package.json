{
  "name": "backend-skeleton",
  "version": "1.0.0",
  "type": "module",
  "description": "Deterministic gate layer for AI-assisted backend changes -- blocks brownfield collisions and contract/handle drift via disk-hash checks before code ships. Scaffolding codegen included (Java/Spring, Python/FastAPI, TypeScript/Express).",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/popixoxipop-collab/backend-skeleton.git"
  },
  "homepage": "https://github.com/popixoxipop-collab/backend-skeleton#readme",
  "bugs": {
    "url": "https://github.com/popixoxipop-collab/backend-skeleton/issues"
  },
  "bin": {
    "bskel": "bin/bskel.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "lib/",
    "contracts/",
    "scanners/",
    "handles/",
    "new/",
    "stack/",
    "schemas/",
    "scripts/preflight-base-ref.sh",
    "LICENSE",
    "COMMERCIAL-LICENSE.md",
    "COMMERCIAL-LICENSE-AGREEMENT.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:pack": "node test/package-install.test.mjs",
    "test:java-compile": "node scripts/java-compile-smoke.mjs",
    "test:python-import": "node scripts/python-import-smoke.mjs",
    "test:db-introspect": "node scripts/db-introspect-smoke.mjs",
    "test:registry-coverage": "node scripts/handles-registry-coverage-smoke.mjs",
    "test:ddl-apply": "node scripts/ddl-apply-smoke.mjs",
    "test:cross-feature-fk": "node scripts/cross-feature-fk-smoke.mjs",
    "test:java-integration": "node scripts/java-integration-smoke.mjs",
    "test:java-ast": "node scripts/java-ast-smoke.mjs",
    "test:python-integration": "node scripts/python-integration-smoke.mjs",
    "test:typescript-compile": "node scripts/typescript-typecheck-smoke.mjs",
    "test:spring-initializr-canary": "node scripts/spring-initializr-canary.mjs",
    "test:all-smoke": "npm test && npm run test:pack && npm run test:java-compile && npm run test:java-integration && npm run test:python-import && npm run test:python-integration && npm run test:db-introspect && npm run test:registry-coverage && npm run test:ddl-apply && npm run test:cross-feature-fk && npm run test:java-ast && npm run test:typescript-compile"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.0",
    "pg": "^8.23.0"
  }
}
